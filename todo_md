def help_display_width(text: str) -> int:
    width = 0
    for ch in text:
        if ch == "\ufe0f":
            width += 1
        elif unicodedata.combining(ch):
            continue
        else:
            width += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return width

def _help_wrap(text: str, width: int) -> list[str]:
    lines: list[str] = []
    cur = ""
    for word in text.split():
        cand = f"{cur} {word}" if cur else word
        if cur and help_display_width(cand) > width:
            lines.append(cur)
            cur = word
        else:
            cur = cand
    if cur:
        lines.append(cur)
    return lines

def _help_fill(text: str, prog: str) -> str:
    return text.replace("{prog}", prog)

def _help_table(rows: tuple[tuple[str, str], ...], prog: str) -> list[str]:
    lefts = [_help_fill(left, prog) for left, _ in rows]
    col = HELP_INDENT + max(len(left) for left in lefts) + HELP_GAP
    out: list[str] = []
    for left, (_, desc) in zip(lefts, rows):
        parts = _help_wrap(_help_fill(desc, prog), HELP_MAX_WIDTH - col) or [""]
        out.append((" " * HELP_INDENT + left).ljust(col) + parts[0])
        out.extend(" " * col + part for part in parts[1:])
    return [line.rstrip() for line in out]

def _help_prose(text: str, prog: str) -> list[str]:
    return _help_wrap(_help_fill(text, prog), HELP_PROSE_WIDTH)

def usage_text() -> str:
    prog = prog_name()
    lines = ["Usage:"]
    lines += [" " * HELP_INDENT + _help_fill(item, prog) for item in HELP_USAGE]
    lines += ["", *_help_prose(HELP_INTRO, prog), ""]
    sections = (
        ("Commands:", HELP_COMMANDS),
        ("Global options:", HELP_GLOBAL_OPTIONS),
        ("Quest-Log options (default view, chain, search):", HELP_QUEST_OPTIONS),
        ("Task ID prefixes and roles (derived from the ID prefix and status, never from the "
         "task body):", HELP_PREFIXES),
    )
    for title, rows in sections:
        lines += [title, *_help_table(rows, prog), ""]
    for note in HELP_NOTES:
        lines += [*_help_prose(note, prog), ""]
    lines += ["Files:", *_help_table(HELP_FILES, prog), ""]
    lines += ["Environment variables:", *_help_table(HELP_ENV, prog)]
    return "\n".join(lines) + "\n"


def is_todo_project(directory: Path) -> bool:
    try:
        return (directory / "TODO.md").is_file() and (directory / "TODO_ARCHIVE.md").is_file()
    except OSError:
        return False


def resolve_target_dir(explicit: str | None = None) -> Path:
    if explicit:
        p = Path(explicit).expanduser().resolve()
        if not p.is_dir():
            raise SystemExit(f"{prog_name()}: directory not found: {explicit}")
        return p
    env_cwd = os.environ.get("TODO_MD_CWD", "").strip()
    if env_cwd:
        return Path(env_cwd).expanduser().resolve()
    return Path.cwd().resolve()


def resolve_workspace_root(base_dir: Path, explicit_dir: str | None = None) -> Path:
    env_ws = os.environ.get("TODO_MD_WORKSPACE", "").strip()
    if explicit_dir:
        if is_todo_project(base_dir):
            if env_ws:
                p = Path(env_ws).expanduser().resolve()
                if not p.is_dir():
                    raise SystemExit(f"{prog_name()}: workspace directory not found: {env_ws}")
                try:
                    base_dir.resolve().relative_to(p)
                    return p
                except ValueError:
                    pass
            cur = base_dir
            while cur.parent != cur and is_todo_project(cur.parent):
                cur = cur.parent
            return cur.parent
        return base_dir
    if env_ws:
        p = Path(env_ws).expanduser().resolve()
        if not p.is_dir():
            raise SystemExit(f"{prog_name()}: workspace directory not found: {env_ws}")
        return p
    if is_todo_project(base_dir):
        cur = base_dir
        while cur.parent != cur and is_todo_project(cur.parent):
            cur = cur.parent
        return cur.parent
    return base_dir


def discover_projects(
    workspace_root: Path,
    max_depth: int = WORKSPACE_MAX_DEPTH,
) -> list[tuple[str, Path]]:
    root = workspace_root.resolve()
    if not root.is_dir():
        return []
    found: list[tuple[str, Path]] = []

    def _walk(cur: Path, depth: int) -> None:
        if depth > max_depth:
            return
        try:
            entries = sorted(cur.iterdir(), key=lambda p: p.name.lower())
        except OSError:
            return
        for entry in entries:
            if not entry.is_dir() or entry.is_symlink():
                continue
            name = entry.name
            if name.startswith(".") or name in WORKSPACE_SKIP_DIRS:
                continue
            if is_todo_project(entry):
                rel = entry.relative_to(root).as_posix()
                found.append((rel, entry))
            if depth < max_depth:
                _walk(entry, depth + 1)

    _walk(root, 1)
    found.sort(key=lambda item: item[0])
    return found


def _home_dir() -> Path | None:
    try:
        return Path.home().resolve()
    except (RuntimeError, OSError):
        return None


def project_label(proj_dir: Path, ws_root: Path) -> str:
    p_res = proj_dir.resolve()
    for base in (ws_root.resolve(), _home_dir()):
        if base is None:
            continue
        try:
            rel = p_res.relative_to(base).as_posix()
        except ValueError:
            continue
        return rel if rel and rel != "." else p_res.name
    return p_res.name


def lookup_external_alias(base_dir: Path, ws_root: Path, name: str) -> Path | None:
    norm = name.strip().replace("\\", "/").strip("/")
    if not norm or ".." in norm.split("/"):
        return None
    ws_res = ws_root.resolve()
    b_res = base_dir.resolve()
    projs = discover_projects(ws_res)
    configured: list[Path] = []
    for cfg_dir in (b_res, ws_res):
        configured.extend(
            read_configured_todo_projects(cfg_dir, ws_res, include_env=True, discovered=projs)
        )
    configured.extend(discover_orchestrators_for_project(b_res, ws_res)[1])
    matches: list[Path] = []
    for proj in configured:
        p_res = proj.resolve()
        if p_res in matches:
            continue
        try:
            p_res.relative_to(ws_res)
            continue
        except ValueError:
            pass
        if p_res.name == norm or project_label(p_res, ws_res) == norm:
            matches.append(p_res)
    return matches[0] if len(matches) == 1 else None


def resolve_project_dir(
    base_dir: Path,
    project_name: str,
    explicit_dir: str | None = None,
) -> Path:
    norm = project_name.strip().replace("\\", "/").strip("/")
    ws_root = resolve_workspace_root(base_dir, explicit_dir=explicit_dir)
    if not norm or ".." in norm.split("/"):
        raise SystemExit(f"{prog_name()}: invalid project reference {project_name!r}")
    candidate = (ws_root / norm).resolve()
    inside = True
    try:
        candidate.relative_to(ws_root.resolve())
    except ValueError:
        inside = False
    if inside and is_todo_project(candidate):
        return candidate
    alias = lookup_external_alias(base_dir, ws_root, norm)
    if alias is not None:
        return alias
    if not inside:
        raise SystemExit(f"{prog_name()}: project {project_name!r} escapes workspace {ws_root}")
    raise SystemExit(f"{prog_name()}: project {norm!r} not found under workspace {ws_root}")


def resolve_project_or_dir(selector: str) -> str:
    raw = selector.strip()
    if not raw:
        raise SystemExit(f"{prog_name()}: empty project or directory selector")
    p_cand = Path(raw).expanduser()
    if p_cand.is_dir():
        return str(p_cand.resolve())
    looks_like_path = (
        raw.startswith(("/", "~", "./", "../", ".\\", "..\\"))
        or p_cand.is_absolute()
    )
    if looks_like_path:
        raise SystemExit(f"{prog_name()}: directory not found: {selector}")

    norm = raw.replace("\\", "/").strip("/")
    if not norm or ".." in norm.split("/"):
        raise SystemExit(f"{prog_name()}: target directory or project not found: {selector}")

    cwd_res = Path.cwd().resolve()
    probe_bases: list[Path] = [cwd_res]
    for anc in cwd_res.parents:
        if is_todo_project(anc):
            if anc not in probe_bases:
                probe_bases.append(anc)
            break
    env_cwd = os.environ.get("TODO_MD_CWD", "").strip()
    if env_cwd:
        p_env_cwd = Path(env_cwd).expanduser().resolve()
        if p_env_cwd.is_dir() and p_env_cwd not in probe_bases:
            probe_bases.append(p_env_cwd)

    seen_ws: set[Path] = set()
    for base in probe_bases:
        ws_root = resolve_workspace_root(base).resolve()
        if ws_root in seen_ws:
            continue
        seen_ws.add(ws_root)
        cand = (ws_root / norm).resolve()
        try:
            cand.relative_to(ws_root)
            if is_todo_project(cand):
                return str(cand)
        except ValueError:
            pass
        projects = discover_projects(ws_root)
        exact = [p for rel, p in projects if rel == norm]
        if exact:
            return str(exact[0].resolve())
        if "/" not in norm:
            by_name = [(rel, p) for rel, p in projects if Path(rel).name == norm]
            if len(by_name) == 1:
                return str(by_name[0][1].resolve())
            if len(by_name) > 1:
                matches = ", ".join(rel for rel, _ in by_name)
                raise SystemExit(
                    f"{prog_name()}: ambiguous project name {selector!r}; matches: {matches}"
                )
        ext = lookup_external_alias(base, ws_root, norm)
        if ext is not None:
            return str(ext)

    raise SystemExit(f"{prog_name()}: target directory or project not found: {selector}")


def resolve_project_task_ref(
    base_dir: Path,
    ref: str,
    explicit_dir: str | None = None,
) -> tuple[Path, str]:
    m = PROJECT_TASK_RE.match(ref.strip())
    if m:
        proj_name, tid = m.group(1), m.group(2).upper()
        return resolve_project_dir(base_dir, proj_name, explicit_dir=explicit_dir), tid
    return base_dir, ref.strip()


def _is_valid_task_ref_token(tok: str) -> bool:
    raw = tok.strip()
    if not raw:
        return False
    if re.fullmatch(r"[A-Za-z]\d+", raw):
        return True
    pm = PROJECT_TASK_RE.match(raw)
    if pm:
        proj_part = pm.group(1).strip().replace("\\", "/").strip("/")
        return bool(proj_part) and ".." not in proj_part.split("/")
    return False


def _split_task_ref_arg(arg: str) -> list[str] | None:
    parts = [p.strip() for p in arg.split(",") if p.strip()]
    if not parts:
        return None
    if not all(_is_valid_task_ref_token(p) for p in parts):
        return None
    return parts


def resolve_filter_task_ref(
    base_dir: Path,
    ref: str,
    explicit_dir: str | None = None,
) -> tuple[Path, str]:
    raw = ref.strip()
    m = PROJECT_TASK_RE.match(raw)
    if m:
        proj_name, tid = m.group(1), m.group(2).upper()
        r_dir = resolve_project_dir(base_dir, proj_name, explicit_dir=explicit_dir)
        return r_dir, f".:{tid}"
    return base_dir, raw.upper()


def _normalize_target_refs(
    base_dir: Path,
    targets: list[tuple[Path, str]] | None,
    explicit_dir: str | None = None,
) -> tuple[set[tuple[Path, str]], set[str]]:
    target_set: set[tuple[Path, str]] = set()
    unscoped_ids: set[str] = set()
    for tdir, raw_tid in targets or []:
        tok = raw_tid.strip()
        if not tok:
            continue
        if tok.startswith(".:"):
            tid_up = tok[2:].strip().upper()
            if tid_up:
                target_set.add((tdir.resolve(), tid_up))
            continue
        pm = PROJECT_TASK_RE.match(tok)
        if pm:
            r_dir, r_tid = resolve_project_task_ref(base_dir, tok, explicit_dir=explicit_dir)
            target_set.add((r_dir.resolve(), r_tid.upper()))
        else:
            t_res = tdir.resolve()
            tid_up = tok.upper()
            target_set.add((t_res, tid_up))
            unscoped_ids.add(tid_up)
    return target_set, unscoped_ids


EMPTY_DEPENDS_LINE_RE = re.compile(r"^\s*[-*]\s*Depends on:\s*$", re.IGNORECASE)


def normalize_dep_ref_token(tok: str) -> tuple[str | None, str | None]:
    raw = tok.strip()
    if not raw:
        return None, "empty dependency reference"
    pm = PROJECT_TASK_RE.match(raw)
    if pm:
        proj_part = pm.group(1).strip().replace("\\", "/").strip("/")
        if not proj_part or ".." in proj_part.split("/"):
            return None, f"invalid dependency reference {raw!r}"
        return f"{proj_part}:{pm.group(2).upper()}", None
    if re.fullmatch(r"[A-Za-z]\d+", raw):
        return raw.upper(), None
    return None, f"invalid dependency reference {raw!r}"


def parse_depends_clause(raw_clause: str) -> tuple[list[list[str]], str | None]:
    if not raw_clause.strip():
        return [], "empty Depends on: clause"
    stages: list[list[str]] = []
    for raw_stage in raw_clause.split("->"):
        if not raw_stage.strip():
            return [], f"empty stage in dependency clause {raw_clause.strip()!r}"
        stage_refs: list[str] = []
        seen_stage: set[str] = set()
        for raw_item in raw_stage.split(","):
            tok = raw_item.strip()
            if not tok:
                return [], f"empty item in dependency stage {raw_stage.strip()!r}"
            norm, err = normalize_dep_ref_token(tok)
            if err or norm is None:
                return [], err or f"invalid dependency reference {tok!r}"
            if norm not in seen_stage:
                seen_stage.add(norm)
                stage_refs.append(norm)
        stages.append(stage_refs)
    return stages, None


def parse_dependency_clauses(section_text: str) -> tuple[list[list[list[str]]], list[str]]:
    clauses: list[list[list[str]]] = []
    errors: list[str] = []
    in_fence = False
    for line in section_text.splitlines():
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        if EMPTY_DEPENDS_LINE_RE.match(line):
            errors.append("empty Depends on: line")
            continue
        m = DEPENDS_LINE_RE.match(line)
        if not m:
            continue
        stages, err = parse_depends_clause(m.group(1))
        if err:
            errors.append(err)
        elif stages:
            clauses.append(stages)
    return clauses, errors


def parse_task_dependencies(section_text: str) -> list[str]:
    refs: list[str] = []
    seen: set[str] = set()
    in_fence = False
    for line in section_text.splitlines():
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = DEPENDS_LINE_RE.match(line)
        if not m:
            continue
        for raw_stage in m.group(1).split("->"):
            for raw in raw_stage.split(","):
                tok = raw.strip()
                if not tok:
                    continue
                norm, _ = normalize_dep_ref_token(tok)
                val = norm if norm is not None else tok
                if val not in seen:
                    seen.add(val)
                    refs.append(val)
    return refs


def resolve_dependency_statuses(
    base_dir: Path,
    deps: list[str],
    explicit_dir: str | None = None,
) -> list[tuple[str, str, str]]:
    results: list[tuple[str, str, str]] = []
    ws_root = resolve_workspace_root(base_dir, explicit_dir=explicit_dir)
    cache: dict[Path, dict[str, str]] = {}

    def _task_statuses(proj_dir: Path) -> dict[str, str]:
        if proj_dir not in cache:
            mapping: dict[str, str] = {}
            for t in collect_all_tasks(proj_dir):
                mapping[str(t["id"]).upper()] = str(t["status"])
            cache[proj_dir] = mapping
        return cache[proj_dir]

    for ref in deps:
        pm = PROJECT_TASK_RE.match(ref)
        if pm:
            proj_name, tid = pm.group(1).strip().replace("\\", "/").strip("/"), pm.group(2).upper()
            target_dir = (ws_root / proj_name).resolve()
            if not is_todo_project(target_dir) and ws_root.name == ".todo_projects":
                alt_dir = (ws_root.parent / proj_name).resolve()
                if is_todo_project(alt_dir):
                    target_dir = alt_dir
            if not is_todo_project(target_dir):
                ext_dir = lookup_external_alias(base_dir, ws_root, proj_name)
                if ext_dir is not None:
                    target_dir = ext_dir
            if not is_todo_project(target_dir):
                results.append((ref, "MISSING", ""))
                continue
        else:
            target_dir = base_dir
            tid = ref.upper()
        statuses = _task_statuses(target_dir)
        st = statuses.get(tid)
        if st is None:
            results.append((ref, "MISSING", ""))
        else:
            results.append((ref, st, VALID_STATUSES.get(st, "")))
    return results


def build_dependency_dag(
    base_dir: Path,
    target_dir: Path,
    task_id: str,
    explicit_dir: str | None = None,
    stop_at_done: bool = False,
) -> dict[str, object]:
    ws_root = resolve_workspace_root(base_dir, explicit_dir=explicit_dir)
    ws_resolved = ws_root.resolve()
    disp_resolved = base_dir.resolve()
    disp_is_proj = is_todo_project(disp_resolved)
    task_cache: dict[Path, dict[str, dict[str, object]]] = {}

    def _task_map(proj_dir: Path) -> dict[str, dict[str, object]]:
        p_res = proj_dir.resolve()
        if p_res not in task_cache:
            mapping: dict[str, dict[str, object]] = {}
            if is_todo_project(p_res):
                for t in collect_all_tasks(p_res):
                    mapping[str(t["id"]).upper()] = t
            task_cache[p_res] = mapping
        return task_cache[p_res]

    def _resolve_ref(cur_dir: Path, ref: str) -> tuple[Path, str]:
        pm = PROJECT_TASK_RE.match(ref)
        if pm:
            proj_name = pm.group(1).strip().replace("\\", "/").strip("/")
            cand = (ws_resolved / proj_name).resolve()
            if not is_todo_project(cand) and ws_resolved.name == ".todo_projects":
                alt = (ws_resolved.parent / proj_name).resolve()
                if is_todo_project(alt):
                    cand = alt
            if not is_todo_project(cand):
                alias = lookup_external_alias(base_dir, ws_resolved, proj_name)
                if alias is not None:
                    cand = alias
            return cand, pm.group(2).upper()
        return cur_dir.resolve(), ref.upper()

    def _format_ref(node_key: tuple[Path, str]) -> str:
        ndir, ntid = node_key
        if disp_is_proj and ndir == disp_resolved:
            return ntid
        return f"{project_label(ndir, ws_resolved)}:{ntid}"

    root = (target_dir.resolve(), task_id.strip().upper())
    nodes: dict[tuple[Path, str], dict[str, object]] = {}
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = {}
    prereq_sets: dict[tuple[Path, str], set[tuple[Path, str]]] = {}
    order_idx: dict[tuple[Path, str], int] = {}
    syntax_errors: list[str] = []

    def _ensure_node_slot(k: tuple[Path, str]) -> None:
        if k not in prereqs:
            prereqs[k] = []
            prereq_sets[k] = set()

    def _add_prereq(node: tuple[Path, str], dep: tuple[Path, str]) -> None:
        _ensure_node_slot(node)
        _ensure_node_slot(dep)
        if dep not in prereq_sets[node]:
            prereq_sets[node].add(dep)
            prereqs[node].append(dep)

    orch_cache: dict[Path, list[Path]] = {}
    orch_edge_cache: dict[Path, dict[tuple[Path, str], list[tuple[Path, str]]]] = {}

    def _is_done_key(k: tuple[Path, str]) -> bool:
        kt = _task_map(k[0]).get(k[1])
        return kt is not None and str(kt["status"]) == "DONE"

    def _orchestrators_of(proj_dir: Path) -> list[Path]:
        p_res = proj_dir.resolve()
        if p_res not in orch_cache:
            found: list[Path] = []
            if is_todo_project(p_res):
                found, _ = discover_orchestrators_for_project(p_res, ws_resolved)
            orch_cache[p_res] = found
        return orch_cache[p_res]

    def _orch_stage_edges(orch_dir: Path) -> dict[tuple[Path, str], list[tuple[Path, str]]]:
        o_res = orch_dir.resolve()
        if o_res not in orch_edge_cache:
            edges: dict[tuple[Path, str], list[tuple[Path, str]]] = {}
            for ot in _task_map(o_res).values():
                if str(ot["status"]) not in ACTIVE_STATUS_ORDER:
                    continue
                o_clauses, _ = parse_dependency_clauses(str(ot["section"]))
                for o_clause in o_clauses:
                    o_stages = [[_resolve_ref(o_res, r) for r in stage] for stage in o_clause]
                    for i, stage_keys in enumerate(o_stages):
                        if i == 0:
                            continue
                        for k in stage_keys:
                            lst = edges.setdefault(k, [])
                            for prev_k in o_stages[i - 1]:
                                if prev_k != k and prev_k not in lst:
                                    lst.append(prev_k)
            orch_edge_cache[o_res] = edges
        return orch_edge_cache[o_res]

    def _inbound_prereqs(node_key: tuple[Path, str]) -> list[tuple[Path, str]]:
        out: list[tuple[Path, str]] = []
        for orch_dir in _orchestrators_of(node_key[0]):
            for prev_k in _orch_stage_edges(orch_dir).get(node_key, []):
                if prev_k not in out:
                    out.append(prev_k)
        return out

    def _visit(node_key: tuple[Path, str]) -> None:
        if node_key in nodes:
            return
        ndir, ntid = node_key
        _ensure_node_slot(node_key)
        tdict = _task_map(ndir).get(ntid)
        if tdict is None:
            missing_title = "(missing task)" if is_todo_project(ndir) else "(unknown project)"
            nodes[node_key] = {
                "id": ntid,
                "status": "MISSING",
                "emoji": "",
                "title": missing_title,
                "exists": False,
                "ref": _format_ref(node_key),
            }
            order_idx[node_key] = len(order_idx)
            return

        st = str(tdict["status"])
        nodes[node_key] = {
            **tdict,
            "exists": True,
            "ref": _format_ref(node_key),
        }
        clauses, errs = parse_dependency_clauses(str(tdict["section"]))
        for err in errs:
            syntax_errors.append(f"{_format_ref(node_key)}: {err}")

        if stop_at_done and st == "DONE":
            done_refs_to_visit: list[tuple[Path, str]] = []
            for clause in clauses:
                resolved_stages = [[_resolve_ref(ndir, r) for r in stage] for stage in clause]
                for i, stage_keys in enumerate(resolved_stages):
                    for k in stage_keys:
                        kt = _task_map(k[0]).get(k[1])
                        if kt is not None and str(kt["status"]) == "DONE":
                            _add_prereq(node_key, k)
                            done_refs_to_visit.append(k)
                            if i > 0:
                                for prev_k in resolved_stages[i - 1]:
                                    pt = _task_map(prev_k[0]).get(prev_k[1])
                                    if pt is not None and str(pt["status"]) == "DONE":
                                        _add_prereq(k, prev_k)
            for prev_k in _inbound_prereqs(node_key):
                if _is_done_key(prev_k):
                    _add_prereq(node_key, prev_k)
                    done_refs_to_visit.append(prev_k)
            for k in done_refs_to_visit:
                _visit(k)
            order_idx[node_key] = len(order_idx)
            return

        to_visit: list[tuple[Path, str]] = []
        for clause in clauses:
            resolved_stages = [[_resolve_ref(ndir, r) for r in stage] for stage in clause]
            for i, stage_keys in enumerate(resolved_stages):
                for k in stage_keys:
                    _add_prereq(node_key, k)
                    to_visit.append(k)
                    if i > 0:
                        for prev_k in resolved_stages[i - 1]:
                            _add_prereq(k, prev_k)
        for prev_k in _inbound_prereqs(node_key):
            _add_prereq(node_key, prev_k)
            to_visit.append(prev_k)
        for k in to_visit:
            _visit(k)
        order_idx[node_key] = len(order_idx)

    _visit(root)

    in_degree: dict[tuple[Path, str], int] = {u: len(prereqs[u]) for u in nodes}
    dependents: dict[tuple[Path, str], list[tuple[Path, str]]] = {u: [] for u in nodes}
    for u in nodes:
        for p in prereqs[u]:
            dependents[p].append(u)

    avail: list[tuple[int, str, tuple[Path, str]]] = [
        (order_idx.get(u, 0), str(nodes[u]["ref"]), u)
        for u in nodes
        if in_degree[u] == 0
    ]
    heapq.heapify(avail)
    topo_order: list[tuple[Path, str]] = []
    while avail:
        _, _, u = heapq.heappop(avail)
        topo_order.append(u)
        for v in dependents[u]:
            in_degree[v] -= 1
            if in_degree[v] == 0:
                heapq.heappush(avail, (order_idx.get(v, 0), str(nodes[v]["ref"]), v))

    cycle: list[str] = []
    if len(topo_order) < len(nodes):
        cyclic_nodes = {u for u, deg in in_degree.items() if deg > 0}
        state: dict[tuple[Path, str], int] = {}
        stack: list[tuple[Path, str]] = []

        def _find_cycle(u: tuple[Path, str]) -> list[tuple[Path, str]] | None:
            state[u] = 1
            stack.append(u)
            for nxt in prereqs[u]:
                if nxt not in cyclic_nodes:
                    continue
                st_nxt = state.get(nxt, 0)
                if st_nxt == 1:
                    idx_start = stack.index(nxt)
                    return list(reversed(stack[idx_start:] + [nxt]))
                if st_nxt == 0:
                    res = _find_cycle(nxt)
                    if res:
                        return res
            stack.pop()
            state[u] = 2
            return None

        ordered_cyclic = sorted(cyclic_nodes, key=lambda k: order_idx.get(k, 0))
        for start_node in ordered_cyclic:
            if state.get(start_node, 0) == 0:
                found_cyc = _find_cycle(start_node)
                if found_cyc:
                    cycle = [str(nodes[k]["ref"]) for k in found_cyc]
                    break

    return {
        "root": root,
        "nodes": nodes,
        "prereqs": prereqs,
        "topo_order": topo_order,
        "cycle": cycle,
        "syntax_errors": syntax_errors,
    }


def _first_actionable_in_dag(
    dag: dict[str, object],
    role: str | None = None,
) -> str | None:
    nodes: dict[tuple[Path, str], dict[str, object]] = dag["nodes"]  # type: ignore[assignment]
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["prereqs"]  # type: ignore[assignment]
    topo_order: list[tuple[Path, str]] = dag["topo_order"]  # type: ignore[assignment]
    wanted_role = role.strip().lower() if role is not None else None
    for u in topo_order:
        nd = nodes[u]
        if str(nd["status"]) not in ACTIVE_STATUS_ORDER:
            continue
        if wanted_role is not None and not _task_matches_role(nd, wanted_role):
            continue
        blockers = [p for p in prereqs[u] if str(nodes[p]["status"]) != "DONE"]
        if not blockers:
            return str(nd["ref"])
    return None


def _task_dag(
    base_dir: Path,
    task: dict[str, object],
    explicit_dir: str | None = None,
) -> dict[str, object] | None:
    if str(task.get("status", "")) not in ACTIVE_STATUS_ORDER:
        return None
    dag = build_dependency_dag(
        base_dir,
        base_dir,
        str(task["id"]),
        explicit_dir=explicit_dir,
        stop_at_done=True,
    )
    if dag["syntax_errors"] or dag["cycle"]:
        return None
    return dag


def _dag_blocked_suffix(dag: dict[str, object]) -> str:
    nodes: dict[tuple[Path, str], dict[str, object]] = dag["nodes"]  # type: ignore[assignment]
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["prereqs"]  # type: ignore[assignment]
    root_key: tuple[Path, str] = dag["root"]  # type: ignore[assignment]
    anc_cache: dict[tuple[Path, str], set[tuple[Path, str]]] = {}

    def _unres_ancestors(u: tuple[Path, str]) -> set[tuple[Path, str]]:
        if u not in anc_cache:
            found: set[tuple[Path, str]] = set()
            for p in prereqs.get(u, []):
                if str(nodes[p]["status"]) != "DONE":
                    found.add(p)
                    found.update(_unres_ancestors(p))
            anc_cache[u] = found
        return anc_cache[u]

    def _reduced_unres_prereqs(u: tuple[Path, str]) -> list[tuple[Path, str]]:
        raw = [p for p in prereqs.get(u, []) if str(nodes[p]["status"]) != "DONE"]
        return [
            p
            for p in raw
            if not any(p in _unres_ancestors(other) for other in raw if other != p)
        ]

    def _paths_to(u: tuple[Path, str]) -> list[list[tuple[Path, str]]]:
        ups = _reduced_unres_prereqs(u)
        if not ups:
            return [[u]]
        out: list[list[tuple[Path, str]]] = []
        for p in ups:
            for sub_path in _paths_to(p):
                out.append(sub_path + [u])
        return out

    chain_strs: list[str] = []
    seen_chains: set[str] = set()
    for direct_blocker in _reduced_unres_prereqs(root_key):
        for path_nodes in _paths_to(direct_blocker):
            rendered = " -> ".join(
                f"{nodes[k]['ref']} ({nodes[k]['status']})" for k in path_nodes
            )
            if rendered not in seen_chains:
                seen_chains.add(rendered)
                chain_strs.append(rendered)
    return f" [blocked: {', '.join(chain_strs)}]" if chain_strs else ""


def _task_dependency_info(
    base_dir: Path,
    task: dict[str, object],
    explicit_dir: str | None = None,
) -> tuple[bool, str]:
    sec = str(task["section"])
    _, syntax_errs = parse_dependency_clauses(sec)
    deps = parse_task_dependencies(sec)
    dag = None if syntax_errs else _task_dag(base_dir, task, explicit_dir=explicit_dir)
    dag_suffix = _dag_blocked_suffix(dag) if dag is not None else ""
    if not deps and not syntax_errs:
        return (True, dag_suffix) if dag_suffix else (False, "")
    resolved = resolve_dependency_statuses(base_dir, deps, explicit_dir=explicit_dir) if deps else []
    blocked = [f"{r} ({st})" for r, st, _ in resolved if st != "DONE"]
    if syntax_errs and not blocked:
        return True, f" [blocked: syntax error: {'; '.join(syntax_errs)}]"
    if dag_suffix:
        return True, dag_suffix
    if not blocked and not syntax_errs:
        return False, " [deps: DONE]"
    return True, f" [blocked: {', '.join(blocked)}]"


def _is_task_blocked(
    base_dir: Path,
    task: dict[str, object],
    explicit_dir: str | None = None,
) -> bool:
    sec = str(task["section"])
    _, syntax_errs = parse_dependency_clauses(sec)
    if syntax_errs:
        return True
    deps = parse_task_dependencies(sec)
    if deps:
        resolved = resolve_dependency_statuses(base_dir, deps, explicit_dir=explicit_dir)
        if any(st != "DONE" for _, st, _ in resolved):
            return True
    dag = _task_dag(base_dir, task, explicit_dir=explicit_dir)
    if dag is None:
        return False
    nodes: dict[tuple[Path, str], dict[str, object]] = dag["nodes"]  # type: ignore[assignment]
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["prereqs"]  # type: ignore[assignment]
    root_key: tuple[Path, str] = dag["root"]  # type: ignore[assignment]
    return any(str(nodes[p]["status"]) != "DONE" for p in prereqs.get(root_key, []))


def resolve_task_role(
    task_id: str,
    section_text: str,
    status: str | None = None,
) -> str:
    prefix = task_id.strip().upper().split(":")[-1][:1]
    if prefix in PREFIX_DEFAULT_ROLES:
        return PREFIX_DEFAULT_ROLES[prefix]
    norm_status = (status or "").strip().upper()
    if not norm_status and section_text:
        first_line = section_text.splitlines()[0].strip()
        m = HEADING_RE.match(first_line)
        if m:
            norm_status = m.group(2).upper()
    if norm_status in STATUS_ROLES:
        return STATUS_ROLES[norm_status]
    return "work" if norm_status in ("DONE", "CANCELED") else "plan"


def _inbound_blocker_items(
    base_dir: Path,
    task: dict[str, object],
    own_clauses: list[list[list[str]]],
    explicit_dir: str | None = None,
) -> list[str]:
    dag = _task_dag(base_dir, task, explicit_dir=explicit_dir)
    if dag is None:
        return []
    nodes: dict[tuple[Path, str], dict[str, object]] = dag["nodes"]  # type: ignore[assignment]
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["prereqs"]  # type: ignore[assignment]
    root_key: tuple[Path, str] = dag["root"]  # type: ignore[assignment]

    def _norm(ref: str) -> str:
        return ref.strip().upper().lstrip("~/")

    own = {_norm(ref) for clause in own_clauses for stage in clause for ref in stage}
    items: list[str] = []
    for p in prereqs.get(root_key, []):
        nd = nodes[p]
        st = str(nd["status"])
        if st == "DONE" or _norm(str(nd["ref"])) in own:
            continue
        emoji = str(nd.get("emoji", ""))
        label = f"{emoji} [{st}]".strip() if emoji else f"[{st}]"
        items.append(f"{nd['ref']} {label}")
    return items


def format_dependency_summary(
    base_dir: Path,
    section_text: str,
    explicit_dir: str | None = None,
    task: dict[str, object] | None = None,
) -> str | None:
    clauses, syntax_errors = parse_dependency_clauses(section_text)
    inbound_items = (
        _inbound_blocker_items(base_dir, task, clauses, explicit_dir=explicit_dir)
        if task is not None and not syntax_errors
        else []
    )
    if not clauses and not syntax_errors and not inbound_items:
        return None
    flat_refs: list[str] = []
    seen_refs: set[str] = set()
    for clause in clauses:
        for stage in clause:
            for ref in stage:
                if ref not in seen_refs:
                    seen_refs.add(ref)
                    flat_refs.append(ref)
    resolved_list = resolve_dependency_statuses(base_dir, flat_refs, explicit_dir=explicit_dir)
    status_map = {ref: (st, emoji) for ref, st, emoji in resolved_list}
    blocked = bool(syntax_errors)
    clause_strs: list[str] = []
    for clause in clauses:
        stage_strs: list[str] = []
        for stage in clause:
            item_strs: list[str] = []
            for ref in stage:
                st, emoji = status_map.get(ref, ("MISSING", ""))
                if st == "DONE":
                    item_strs.append(f"{ref} {emoji} [DONE]".replace("  ", " "))
                elif st == "MISSING":
                    blocked = True
                    item_strs.append(f"{ref} [MISSING]")
                else:
                    blocked = True
                    label = f"{emoji} [{st}]".strip() if emoji else f"[{st}]"
                    item_strs.append(f"{ref} {label}")
            stage_strs.append(", ".join(item_strs))
        clause_strs.append(" -> ".join(stage_strs))
    if inbound_items:
        blocked = True
        clause_strs.append(", ".join(inbound_items))
    if syntax_errors and not clause_strs:
        return f"Dependencies (blocked): [syntax error: {'; '.join(syntax_errors)}]"
    state = "blocked" if blocked else "ready"
    suffix = f" [syntax error: {'; '.join(syntax_errors)}]" if syntax_errors else ""
    return f"Dependencies ({state}): " + "; ".join(clause_strs) + suffix


def read_if_exists(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""


def _read_stdin_if_piped() -> str | None:
    try:
        if not sys.stdin.isatty():
            data = sys.stdin.read()
            return data if data.strip() else None
    except Exception:
        pass
    return None


def parse_tasks_in_text(text: str, filename: str) -> list[dict[str, object]]:
    tasks: list[dict[str, object]] = []
    in_fence = False
    current: dict[str, object] | None = None
    body_lines: list[str] = []
    for lineno, line in enumerate(text.splitlines(), start=1):
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
        if not in_fence and line.startswith("# "):
            if current is not None:
                current["section"] = "\n".join(body_lines).rstrip()
                tasks.append(current)
                current = None
                body_lines = []
            m = HEADING_RE.match(line)
            if m:
                emoji, status, tid, title = m.groups()
                current = {
                    "id": tid,
                    "status": status,
                    "emoji": emoji,
                    "title": title,
                    "file": filename,
                    "line": lineno,
                    "heading": line,
                }
                body_lines = [line]
                continue
        if current is not None:
            body_lines.append(line)
    if current is not None:
        current["section"] = "\n".join(body_lines).rstrip()
        tasks.append(current)
    return tasks


def collect_all_tasks(base_dir: Path) -> list[dict[str, object]]:
    all_tasks: list[dict[str, object]] = []
    for fname in TASK_FILES:
        p = base_dir / fname
        if p.is_file():
            all_tasks.extend(parse_tasks_in_text(read_if_exists(p), fname))
    return all_tasks


def compile_search_pattern(query: str) -> re.Pattern[str]:
    try:
        return re.compile(query, re.IGNORECASE | re.MULTILINE)
    except re.error:
        return re.compile(re.escape(query), re.IGNORECASE)


def search_tasks(
    base_dir: Path,
    query: str,
    include_archive: bool = False,
    project_label: str | None = None,
) -> list[dict[str, object]]:
    pat = compile_search_pattern(query)
    fnames = TASK_FILES if include_archive else TASK_FILES[:1]
    b_name = base_dir.resolve().name
    matches: list[dict[str, object]] = []
    for fname in fnames:
        path = base_dir / fname
        if not path.is_file():
            continue
        for t in parse_tasks_in_text(read_if_exists(path), fname):
            tid = str(t["id"])
            id_tokens = [tid, f"{b_name}:{tid}"]
            if project_label and project_label != b_name:
                id_tokens.append(f"{project_label}:{tid}")
            haystack = "\n".join([*id_tokens, str(t["title"]), str(t.get("section", ""))])
            if pat.search(haystack):
                matches.append(t)
    return matches


def highest_ids_in_use(base_dir: Path) -> dict[str, int]:
    top: dict[str, int] = {}
    for fname in TASK_FILES:
        text = read_if_exists(base_dir / fname)
        if not text:
            continue
        in_fence = False
        for line in text.splitlines():
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            m = ANY_ID_RE.match(line)
            if m:
                ident = m.group(1)
                prefix, num = ident[0], int(ident[1:])
                top[prefix] = max(top.get(prefix, 0), num)
    return top


def next_free_id(base_dir: Path, prefix: str = "F") -> str:
    p = prefix.upper()
    if not re.fullmatch(r"[A-Za-z]", p):
        raise SystemExit(f"{prog_name()}: invalid ID prefix {prefix!r}; expected a single letter A-Z")
    top = highest_ids_in_use(base_dir)
    return f"{p}{top.get(p, 0) + 1}"


def format_ids_summary(top: dict[str, int]) -> str:
    if not top:
        return "[none]"
    used = " ".join(f"{k}:{v}" for k, v in sorted(top.items()))
    nxt = ", ".join(f"{k}{v + 1}" for k, v in sorted(top.items()))
    return f"{used}  (next free: {nxt})"


def _format_task_for_summary(
    task: dict[str, object],
    full: bool = False,
    base_dir: Path | None = None,
    proj_prefix: str | None = None,
) -> str:
    sec = str(task["section"]).rstrip()
    if proj_prefix:
        lines = sec.splitlines()
        tid = str(task["id"])
        lines[0] = lines[0].replace(f"] {tid}:", f"] {proj_prefix}:{tid}:", 1)
        sec = "\n".join(lines)
    dep_line = (
        format_dependency_summary(
            base_dir, str(task["section"]), task=None if proj_prefix else task
        )
        if base_dir
        else None
    )
    status = str(task["status"])
    if full or status in ("WIP", "NEXT", "QUESTION"):
        return f"{sec}\n{dep_line}" if dep_line else sec
    lines = sec.splitlines()
    heading = lines[0]
    body_non_empty = [l for l in lines[1:] if l.strip()]
    if not body_non_empty:
        return heading
    if len(body_non_empty) == 1:
        out = f"{heading}\n\n{body_non_empty[0]}"
        return f"{out}\n{dep_line}" if dep_line else out
    tid = str(task["id"])
    ref_cmd = f"{proj_prefix}:{tid}" if proj_prefix else tid
    extra = len(body_non_empty) - 1
    out = f"{heading}\n\n{body_non_empty[0]}\n*(+{extra} more line{'s' if extra != 1 else ''} — run `{prog_name()} {ref_cmd}` to view full task)*"
    return f"{out}\n{dep_line}" if dep_line else out


def cmd_summary(base_dir: Path, full: bool = False) -> int:
    todo_path = base_dir / "TODO.md"
    if not todo_path.is_file():
        sys.stderr.write(f"{prog_name()}: no TODO.md found in {base_dir} (run '{prog_name()} init' to create one)\n")
        return 1
    todo_text = read_if_exists(todo_path).rstrip()
    active_tasks = parse_tasks_in_text(todo_text, "TODO.md")
    arch_tasks = parse_tasks_in_text(read_if_exists(base_dir / "TODO_ARCHIVE.md"), "TODO_ARCHIVE.md")
    top = highest_ids_in_use(base_dir)

    if active_tasks:
        if full:
            sys.stdout.write(todo_text + "\n\n")
        else:
            ordered = sorted(
                enumerate(active_tasks),
                key=lambda iv: (ACTIVE_STATUS_ORDER.get(str(iv[1]["status"]), 99), iv[0]),
            )
            has_expanded = any(
                str(t["status"]) in ("WIP", "NEXT", "QUESTION")
                for _, t in ordered
            )
            rendered = [
                _format_task_for_summary(t, full=(not has_expanded and idx == 0), base_dir=base_dir)
                for idx, (_, t) in enumerate(ordered)
            ]
            sys.stdout.write("\n\n".join(rendered) + "\n\n")

    if not active_tasks:
        sys.stdout.write("*(No open tasks in TODO.md)*\n\n")
    sys.stdout.write("---\n")
    sys.stdout.write(f"IDs in use: {format_ids_summary(top)}\n")
    sys.stdout.write(f"Open in TODO.md: {len(active_tasks)} task(s) | Archived in TODO_ARCHIVE.md: {len(arch_tasks)} task(s)\n")
    return 0


def cmd_ids(base_dir: Path) -> int:
    top = highest_ids_in_use(base_dir)
    sys.stdout.write(f"IDs in use: {format_ids_summary(top)}\n")
    for legend_line in prefix_legend_lines():
        sys.stdout.write(legend_line + "\n")
    return 0


def resolve_last_task_id(base_dir: Path, filt: str | None = None) -> str | None:
    mode = (filt or "NEW").strip().upper()
    if mode != "ARCHIVE" and mode not in VALID_STATUSES:
        raise SystemExit(
            f"{prog_name()}: unknown status or filter {filt!r}; expected {', '.join(VALID_STATUSES)}, or archive"
        )
    if mode in ("ARCHIVE", "DONE", "CANCELED"):
        arch_path = base_dir / "TODO_ARCHIVE.md"
        if not arch_path.is_file():
            return None
        arch_tasks = parse_tasks_in_text(read_if_exists(arch_path), "TODO_ARCHIVE.md")
        if mode == "ARCHIVE":
            return str(arch_tasks[0]["id"]).upper() if arch_tasks else None
        for t in arch_tasks:
            if str(t["status"]) == mode:
                return str(t["id"]).upper()
        return None
    todo_path = base_dir / "TODO.md"
    if not todo_path.is_file():
        return None
    active_tasks = parse_tasks_in_text(read_if_exists(todo_path), "TODO.md")
    matching = [t for t in active_tasks if str(t["status"]) == mode]
    if not matching:
        return None
    if mode in ("WIP", "NEXT"):
        return str(matching[0]["id"]).upper()
    return str(matching[-1]["id"]).upper()


def cmd_last_id(base_dir: Path, filt: str | None = None) -> int:
    tid = resolve_last_task_id(base_dir, filt)
    if not tid:
        label = (filt or "NEW").strip()
        sys.stderr.write(f"{prog_name()}: no matching task found for {label!r} under {base_dir}\n")
        return 1
    sys.stdout.write(f"{tid}\n")
    return 0


def cmd_last(base_dir: Path, filt: str | None = None) -> int:
    tid = resolve_last_task_id(base_dir, filt)
    if not tid:
        label = (filt or "NEW").strip()
        sys.stderr.write(f"{prog_name()}: no matching task found for {label!r} under {base_dir}\n")
        return 1
    return cmd_show(base_dir, tid)


def _strip_heading_note(title: str) -> tuple[str, str | None]:
    m = re.match(r"^(.*?)\s+—\s+\*(.*)\*\s*$", title.strip())
    if m:
        return m.group(1).strip(), m.group(2).strip()
    return title.strip(), None


def cmd_show(base_dir: Path, task_id: str) -> int:
    target = task_id.strip().upper()
    top = highest_ids_in_use(base_dir)
    workdir = str(base_dir.resolve())
    for t in collect_all_tasks(base_dir):
        if str(t["id"]).upper() == target:
            tid = str(t["id"]).upper()
            base_title, _ = _strip_heading_note(str(t["title"]))
            section = str(t["section"])
            role = resolve_task_role(tid, section, status=str(t.get("status", "")))
            header_lines = [
                f"Task: {tid}",
                f"Title: {base_title}",
                f"Role: {role}",
                f"Workdir: {workdir}",
            ]
            headers = "\n".join(header_lines)
            dep_line = format_dependency_summary(base_dir, section, task=t)
            dep_block = f"\n{dep_line}" if dep_line else ""
            sys.stdout.write(
                f"{headers}\n\n# {t['file']}:{t['line']}\n{section}{dep_block}\n\n---\nIDs in use: {format_ids_summary(top)}\n"
            )
            return 0
    sys.stderr.write(f"{prog_name()}: task {target!r} not found in TODO*.md under {base_dir}\n")
    return 1


def _order_active_tasks(
    active_tasks: list[dict[str, object]],
    base_dir: Path | None = None,
    promote_id: str | None = None,
    ready_statuses: frozenset[str] | None = None,
) -> list[dict[str, object]]:
    if not active_tasks:
        return []
    target = promote_id.strip().upper() if promote_id else None
    task_by_id: dict[str, int] = {}
    for idx, t in enumerate(active_tasks):
        tid = str(t["id"]).upper()
        if tid not in task_by_id:
            task_by_id[tid] = idx

    blocked_flags: list[bool] = []
    direct_local_prereqs: list[list[int]] = []
    for idx, t in enumerate(active_tasks):
        if base_dir is not None:
            blocked_flags.append(_is_task_blocked(base_dir, t))
        else:
            _, syntax_errs = parse_dependency_clauses(str(t["section"]))
            deps = parse_task_dependencies(str(t["section"]))
            blocked_flags.append(bool(syntax_errs) or any(r.upper() in task_by_id for r in deps))
        local_deps: list[int] = []
        for ref in parse_task_dependencies(str(t["section"])):
            if re.fullmatch(r"[A-Za-z]\d+", ref):
                p_idx = task_by_id.get(ref.upper())
                if p_idx is not None and p_idx != idx and p_idx not in local_deps:
                    local_deps.append(p_idx)
        direct_local_prereqs.append(local_deps)

    all_local_prereqs: list[set[int]] = []
    for start_idx in range(len(active_tasks)):
        reach: set[int] = set()
        stack = list(direct_local_prereqs[start_idx])
        while stack:
            cur = stack.pop()
            if cur == start_idx or cur in reach:
                continue
            reach.add(cur)
            for nxt in direct_local_prereqs[cur]:
                if nxt not in reach and nxt != start_idx:
                    stack.append(nxt)
        all_local_prereqs.append(reach)

    grouped: dict[str, list[int]] = {}
    for idx, t in enumerate(active_tasks):
        grouped.setdefault(str(t["status"]), []).append(idx)

    def _order_bucket(st: str, bucket_indices: list[int]) -> list[int]:
        if len(bucket_indices) <= 1:
            return bucket_indices
        bucket_set = set(bucket_indices)
        in_degree: dict[int, int] = {idx: 0 for idx in bucket_indices}
        dependents: dict[int, list[int]] = {idx: [] for idx in bucket_indices}
        for u_idx in bucket_indices:
            for p_idx in all_local_prereqs[u_idx]:
                if p_idx in bucket_set and p_idx != u_idx:
                    in_degree[u_idx] += 1
                    dependents[p_idx].append(u_idx)

        use_ready = ready_statuses is None or st in ready_statuses

        def _key(idx: int) -> tuple[int, int, int]:
            is_blk = 1 if (use_ready and blocked_flags[idx]) else 0
            prom = 0 if (target and str(active_tasks[idx]["id"]).upper() == target) else 1
            return (is_blk, prom, idx)

        avail = [_key(idx) for idx in bucket_indices if in_degree[idx] == 0]
        heapq.heapify(avail)
        result: list[int] = []
        while avail:
            _, _, u = heapq.heappop(avail)
            result.append(u)
            for v in dependents[u]:
                in_degree[v] -= 1
                if in_degree[v] == 0:
                    heapq.heappush(avail, _key(v))
        if len(result) < len(bucket_indices):
            done_set = set(result)
            remaining = [idx for idx in bucket_indices if idx not in done_set]
            remaining.sort(key=_key)
            result.extend(remaining)
        return result

    ordered: list[dict[str, object]] = []
    seen_statuses: set[str] = set()
    for st in sorted(ACTIVE_STATUS_ORDER, key=lambda s: ACTIVE_STATUS_ORDER[s]):
        seen_statuses.add(st)
        for idx in _order_bucket(st, grouped.get(st, [])):
            ordered.append(active_tasks[idx])
    for st, bucket in grouped.items():
        if st not in seen_statuses:
            for idx in _order_bucket(st, bucket):
                ordered.append(active_tasks[idx])
    return ordered


def _order_active_tasks_for_list(
    active_tasks: list[dict[str, object]],
    base_dir: Path | None = None,
) -> list[dict[str, object]]:
    return _order_active_tasks(active_tasks, base_dir=base_dir)


def _task_role_badge(task: dict[str, object]) -> str:
    role = resolve_task_role(
        str(task["id"]),
        str(task["section"]),
        status=str(task.get("status", "")),
    )
    return f"[{role}]" if role else ""


def _task_matches_role(task: dict[str, object], wanted_role: str) -> bool:
    role = resolve_task_role(
        str(task["id"]),
        str(task["section"]),
        status=str(task.get("status", "")),
    )
    return bool(role) and role.lower() == wanted_role.strip().lower()


DEFAULT_TERMINAL_WIDTH = 100
MIN_TABLE_DESC_COLS = 20
COMPACT_CONTINUATION_INDENT = 4


def _get_terminal_columns(fallback: int = DEFAULT_TERMINAL_WIDTH) -> int:
    cols = shutil.get_terminal_size(fallback=(fallback, 24)).columns
    return cols if cols > 0 else fallback


def _char_display_width(ch: str) -> int:
    if unicodedata.category(ch) in ("Mn", "Me", "Cf"):
        return 0
    if ch == "\u23f8" or ord(ch) >= 0x1F300 or unicodedata.east_asian_width(ch) in ("W", "F"):
        return 2
    return 1


ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
ANSI_DIM_ON = "\033[2m"
ANSI_EXTERNAL_ON = "\033[2;3m"
ANSI_DONE_ON = "\033[2;90m"
ANSI_EXTERNAL_DONE_ON = "\033[2;3;90m"
ANSI_HIGHLIGHT_ON = "\033[1;93m"
ANSI_EXTERNAL_HIGHLIGHT_ON = "\033[1;3;93m"
ANSI_RESET = "\033[0m"


def _strip_ansi(text: str) -> str:
    if "\x1b" not in text:
        return text
    return ANSI_ESCAPE_RE.sub("", text)


def _use_ansi_color() -> bool:
    force = os.environ.get("FORCE_COLOR", "").strip()
    if force and force != "0":
        return True
    if os.environ.get("NO_COLOR", "").strip():
        return False
    try:
        return bool(sys.stdout.isatty())
    except Exception:
        return False


def _style_ansi_lines(text: str, sgr_open: str) -> str:
    if not sgr_open:
        return text
    has_nl = text.endswith("\n")
    raw = text[:-1] if has_nl else text
    styled = "\n".join(f"{sgr_open}{line}{ANSI_RESET}" if line else line for line in raw.split("\n"))
    return f"{styled}\n" if has_nl else styled


def _style_task_row(
    text: str,
    is_external: bool = False,
    is_done: bool = False,
    is_highlighted: bool = False,
    use_color: bool | None = None,
) -> str:
    active_color = _use_ansi_color() if use_color is None else use_color
    if not active_color:
        return text
    if is_highlighted:
        sgr = ANSI_EXTERNAL_HIGHLIGHT_ON if is_external else ANSI_HIGHLIGHT_ON
    elif is_external and is_done:
        sgr = ANSI_EXTERNAL_DONE_ON
    elif is_external:
        sgr = ANSI_EXTERNAL_ON
    elif is_done:
        sgr = ANSI_DONE_ON
    else:
        return text
    return _style_ansi_lines(text, sgr)


def _display_width(text: str) -> int:
    return sum(_char_display_width(ch) for ch in _strip_ansi(text))


def _pad_display(text: str, width: int) -> str:
    cur = _display_width(text)
    if cur >= width:
        return text
    return text + (" " * (width - cur))

def _split_word_by_display_width(word: str, max_cols: int) -> list[str]:
    if max_cols <= 0 or _display_width(word) <= max_cols:
        return [word]
    chunks: list[str] = []
    cur: list[str] = []
    cur_w = 0
    for ch in word:
        cw = _char_display_width(ch)
        if cur and cur_w + cw > max_cols:
            chunks.append("".join(cur))
            cur = [ch]
            cur_w = cw
        else:
            cur.append(ch)
            cur_w += cw
    if cur:
        chunks.append("".join(cur))
    return chunks

def _wrap_display_lines(text: str, first_width: int, next_width: int) -> list[str]:
    if not text:
        return []
    lines: list[str] = []
    cur_parts: list[str] = []
    cur_w = 0
    pending_ws = ""
    budget = max(1, first_width)
    next_budget = max(1, next_width)

    for tok in re.findall(r"\S+|\s+", text):
        if tok.isspace():
            if cur_parts:
                pending_ws += tok
            continue
        ws_w = _display_width(pending_ws)
        tok_w = _display_width(tok)
        if cur_parts and cur_w + ws_w + tok_w <= budget:
            cur_parts.append(pending_ws)
            cur_parts.append(tok)
            cur_w += ws_w + tok_w
            pending_ws = ""
            continue
        if cur_parts:
            lines.append("".join(cur_parts))
            cur_parts = []
            cur_w = 0
            pending_ws = ""
            budget = next_budget
        if not lines and budget < next_budget and tok_w > budget:
            lines.append("")
            budget = next_budget
        if tok_w <= budget:
            cur_parts.append(tok)
            cur_w = tok_w
        else:
            chunks = _split_word_by_display_width(tok, budget)
            first_chunk = chunks[0]
            rest_text = tok[len(first_chunk):]
            if not rest_text:
                cur_parts.append(first_chunk)
                cur_w = _display_width(first_chunk)
            else:
                lines.append(first_chunk)
                budget = next_budget
                rem_chunks = _split_word_by_display_width(rest_text, budget)
                for ch_piece in rem_chunks[:-1]:
                    lines.append(ch_piece)
                cur_parts = [rem_chunks[-1]]
                cur_w = _display_width(rem_chunks[-1])

    if cur_parts:
        lines.append("".join(cur_parts))
    return lines

def _wrap_table_row(
    prefix: str,
    description: str,
    term_width: int | None = None,
    cont_prefix: str | None = None,
) -> str:
    if not description:
        return prefix
    width = _get_terminal_columns() if term_width is None else term_width
    prefix_w = _display_width(prefix)
    avail_first = width - prefix_w
    base_cont = cont_prefix if cont_prefix is not None else ""
    base_cont_w = _display_width(base_cont)
    if avail_first >= MIN_TABLE_DESC_COLS:
        cont_indent = base_cont + (" " * max(0, prefix_w - base_cont_w))
        avail_cont = max(1, width - _display_width(cont_indent))
        wrapped = _wrap_display_lines(description, avail_first, avail_cont)
    else:
        target_cont_w = max(COMPACT_CONTINUATION_INDENT, base_cont_w)
        cont_indent = base_cont + (" " * max(0, target_cont_w - base_cont_w))
        avail_cont = max(1, width - _display_width(cont_indent))
        if avail_first <= 0:
            wrapped = _wrap_display_lines(description, avail_cont, avail_cont)
            return "\n".join([prefix.rstrip(), *(f"{cont_indent}{line}" for line in wrapped)])
        wrapped = _wrap_display_lines(description, avail_first, avail_cont)
    if not wrapped:
        return prefix.rstrip()
    out_lines: list[str] = []
    if wrapped[0]:
        out_lines.append(f"{prefix}{wrapped[0]}")
    else:
        out_lines.append(prefix.rstrip())
    for cont in wrapped[1:]:
        out_lines.append(f"{cont_indent}{cont}")
    return "\n".join(out_lines)


def cmd_list(
    base_dir: Path,
    filt: str | None = None,
    limit: int | None = None,
    full: bool = False,
    role: str | None = None,
    ready: bool = False,
    targets: list[tuple[Path, str]] | None = None,
    focus: list[tuple[Path, str]] | None = None,
) -> int:
    mode = (filt or "active").strip().lower()
    tasks = collect_all_tasks(base_dir)
    active_tasks = _order_active_tasks_for_list(
        [t for t in tasks if t["file"] == "TODO.md"],
        base_dir=base_dir,
    )
    arch_tasks = [t for t in tasks if t["file"] == "TODO_ARCHIVE.md"]
    if mode in ("active", "open"):
        shown = active_tasks
    elif mode == "archive":
        shown = arch_tasks
    elif mode == "all":
        shown = active_tasks + arch_tasks
    elif mode.upper() in VALID_STATUSES:
        st_up = mode.upper()
        if st_up in ("DONE", "CANCELED"):
            shown = [t for t in arch_tasks if t["status"] == st_up]
        else:
            shown = [t for t in active_tasks if t["status"] == st_up]
    else:
        raise SystemExit(f"{prog_name()}: unknown list filter {filt!r}; expected active, archive, all, or a status name")

    if role is not None:
        wanted_role = role.strip().lower()
        shown = [t for t in shown if _task_matches_role(t, wanted_role)]

    dep_cache: dict[tuple[str, str], tuple[bool, str]] = {}

    def _dep_info(t: dict[str, object]) -> tuple[bool, str]:
        key = (str(t["file"]), str(t["id"]).upper())
        if key not in dep_cache:
            dep_cache[key] = _task_dependency_info(base_dir, t)
        return dep_cache[key]

    if ready:
        shown = [
            t
            for t in shown
            if str(t["status"]) in ACTIVE_STATUS_ORDER and not _dep_info(t)[0]
        ]

    if focus:
        b_res_f = base_dir.resolve()
        focus_set, focus_unscoped = _normalize_target_refs(base_dir, focus)
        if focus_set or focus_unscoped:
            shown = [
                t
                for t in shown
                if (b_res_f, str(t["id"]).upper()) in focus_set or str(t["id"]).upper() in focus_unscoped
            ]

    if limit is not None:
        shown = shown[:limit]

    if not shown:
        notes: list[str] = []
        if role is not None:
            notes.append(f"role={role.strip()}")
        if ready:
            notes.append("ready")
        extra = f", {', '.join(notes)}" if notes else ""
        sys.stdout.write(f"No matching tasks ({mode}{extra}) in {base_dir}\n")
    elif full:
        sections = [str(t["section"]).rstrip() for t in shown]
        sys.stdout.write("\n\n".join(sections) + "\n")
    else:
        term_width = _get_terminal_columns()
        use_color = _use_ansi_color()
        b_res = base_dir.resolve()
        target_set, unscoped_ids = _normalize_target_refs(base_dir, targets)
        for t in shown:
            is_blocked, dep_suffix = _dep_info(t)
            st_str = str(t["status"])
            tid_up = str(t["id"]).upper()
            emoji = "⏳" if (st_str in ("WIP", "NEXT") and is_blocked) else str(t["emoji"])
            badge = f"{emoji} [{st_str}]"
            role_badge = _task_role_badge(t)
            loc = str(t["file"])
            prefix = (
                f"  {_pad_display(str(t['id']), 6)}  "
                f"{_pad_display(badge, 14)}  "
                f"{_pad_display(role_badge, 10)}  "
                f"{_pad_display(loc, 16)}  "
            )
            desc = f"{t['title']}{dep_suffix}"
            rendered = _wrap_table_row(prefix, desc, term_width) + "\n"
            is_highlighted = (b_res, tid_up) in target_set or tid_up in unscoped_ids
            sys.stdout.write(
                _style_task_row(
                    rendered,
                    is_done=(st_str == "DONE"),
                    is_highlighted=is_highlighted,
                    use_color=use_color,
                )
            )
    top = highest_ids_in_use(base_dir)
    sys.stdout.write(f"\nIDs in use: {format_ids_summary(top)}\n")
    return 0


def validate_all(base_dir: Path) -> tuple[list[str], int]:
    errors: list[str] = []
    seen_ids: dict[str, str] = {}
    has_archive = (base_dir / "TODO_ARCHIVE.md").is_file()
    if (base_dir / "TODO_PLAN.md").is_file():
        errors.append("TODO_PLAN.md: deprecated file exists (merge deferred tasks into TODO.md)")
    for fname in TASK_FILES:
        p = base_dir / fname
        if not p.is_file():
            continue
        text = read_if_exists(p)
        in_fence = False
        for lineno, line in enumerate(text.splitlines(), start=1):
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            if line.startswith("# "):
                m = HEADING_RE.match(line)
                if not m:
                    errors.append(f"{fname}:{lineno}: invalid task heading format: {line}")
                    continue
                emoji, status, tid, title = m.groups()
                norm_emoji = "⏸️" if emoji.startswith("⏸") else emoji
                if VALID_STATUSES.get(status) != norm_emoji:
                    errors.append(f"{fname}:{lineno}: mismatched emoji {emoji} for status [{status}]")
                if title.endswith(",") or title.count("(") != title.count(")"):
                    errors.append(f"{fname}:{lineno}: truncated/malformed task heading title: {title!r}")
                loc = f"{fname}:{lineno}"
                if tid in seen_ids:
                    errors.append(f"{loc}: duplicate task ID {tid} (first seen at {seen_ids[tid]})")
                else:
                    seen_ids[tid] = loc
                if fname == "TODO.md" and has_archive and status in ("DONE", "CANCELED"):
                    errors.append(f"{loc}: {status} task {tid} should be moved to TODO_ARCHIVE.md")
                if fname == "TODO.md" and status not in ("DONE", "CANCELED"):
                    _, heading_note = _strip_heading_note(title)
                    if heading_note and STALE_COMPLETION_NOTE_RE.match(heading_note):
                        errors.append(
                            f"{loc}: active task {tid} [{status}] retains completion date note "
                            f"'— *{heading_note}*' (move it back to TODO_ARCHIVE.md or clear the stale note)"
                        )
                if fname == "TODO_ARCHIVE.md" and status not in ("DONE", "CANCELED"):
                    errors.append(f"{loc}: non-archived status [{status}] on task {tid} in TODO_ARCHIVE.md")

    ws_root = resolve_workspace_root(base_dir)
    local_ids = set(seen_ids.keys())
    proj_task_cache: dict[Path, set[str]] = {}
    todo_path = base_dir / "TODO.md"
    if todo_path.is_file():
        for t in parse_tasks_in_text(read_if_exists(todo_path), "TODO.md"):
            tid = str(t["id"]).upper()
            lineno = int(t["line"])
            sec = str(t["section"])
            in_role_fence = False
            for offset, sline in enumerate(sec.splitlines()):
                if sline.lstrip().startswith(FENCE):
                    in_role_fence = not in_role_fence
                    continue
                if in_role_fence:
                    continue
                if ROLE_LINE_RE.match(sline):
                    errors.append(
                        f"TODO.md:{lineno + offset}: task {tid} has an in-body 'Role:' line "
                        "(roles are derived from the ID prefix and status; remove it, "
                        "use a D* prefix for design tasks or 'todo_md next <ID>' to promote to work)"
                    )
            clauses, syntax_errs = parse_dependency_clauses(sec)
            for serr in syntax_errs:
                errors.append(f"TODO.md:{lineno}: task {tid} has dependency syntax error: {serr}")
            checked_refs: set[str] = set()
            for clause in clauses:
                for stage in clause:
                    for ref in stage:
                        if ref in checked_refs:
                            continue
                        checked_refs.add(ref)
                        pm = PROJECT_TASK_RE.match(ref)
                        if pm:
                            proj_name = pm.group(1).strip().replace("\\", "/").strip("/")
                            target_tid = pm.group(2).upper()
                            if not proj_name or ".." in proj_name.split("/"):
                                errors.append(f"TODO.md:{lineno}: task {tid} has invalid dependency reference {ref!r}")
                                continue
                            target_dir = (ws_root / proj_name).resolve()
                            if not is_todo_project(target_dir):
                                ext_dir = lookup_external_alias(base_dir, ws_root, proj_name)
                                if ext_dir is not None:
                                    target_dir = ext_dir
                            if not is_todo_project(target_dir):
                                errors.append(f"TODO.md:{lineno}: task {tid} depends on unknown project in {ref!r}")
                                continue
                            if target_dir not in proj_task_cache:
                                proj_task_cache[target_dir] = {
                                    str(pt["id"]).upper() for pt in collect_all_tasks(target_dir)
                                }
                            if target_tid not in proj_task_cache[target_dir]:
                                errors.append(f"TODO.md:{lineno}: task {tid} depends on missing task {ref!r}")
                            elif target_dir == base_dir.resolve() and target_tid == tid:
                                errors.append(f"TODO.md:{lineno}: task {tid} cannot depend on itself")
                        elif re.fullmatch(r"[A-Za-z]\d+", ref):
                            target_tid = ref.upper()
                            if target_tid == tid:
                                errors.append(f"TODO.md:{lineno}: task {tid} cannot depend on itself")
                            elif target_tid not in local_ids:
                                errors.append(f"TODO.md:{lineno}: task {tid} depends on missing task {ref!r}")
                        else:
                            errors.append(f"TODO.md:{lineno}: task {tid} has invalid dependency reference {ref!r}")
            if clauses:
                dag = build_dependency_dag(base_dir, base_dir, tid, stop_at_done=False)
                if dag["cycle"]:
                    errors.append(
                        f"TODO.md:{lineno}: task {tid} has dependency cycle: {' -> '.join(dag['cycle'])}"
                    )

    return errors, len(seen_ids)


def cmd_projects(base_dir: Path, explicit_dir: str | None = None) -> int:
    ws_root = resolve_workspace_root(base_dir, explicit_dir=explicit_dir)
    projects = discover_projects(ws_root)
    if not projects:
        sys.stdout.write(f"No todo_md projects found under {ws_root}\n")
        return 0
    sys.stdout.write(f"Workspace: {ws_root} ({len(projects)} project(s))\n")
    term_width = _get_terminal_columns()
    for name, proj_dir in projects:
        active = parse_tasks_in_text(read_if_exists(proj_dir / "TODO.md"), "TODO.md")
        counts: dict[str, int] = {}
        for t in active:
            st = str(t["status"])
            counts[st] = counts.get(st, 0) + 1
        highlights = [f"{st}: {counts[st]}" for st in ("WIP", "NEXT", "QUESTION") if counts.get(st)]
        base_prefix = f"  {_pad_display(name, 26)}  {len(active):>3} open"
        if highlights:
            sys.stdout.write(
                _wrap_table_row(f"{base_prefix} ", f"({', '.join(highlights)})", term_width) + "\n"
            )
        else:
            sys.stdout.write(f"{base_prefix}\n")
    return 0


def cmd_workspace_summary(workspace_root: Path, full: bool = False) -> int:
    projects = discover_projects(workspace_root)
    if not projects:
        sys.stdout.write(f"No todo_md projects found under {workspace_root}\n")
        return 0
    total_open = 0
    empty_projects: list[str] = []
    blocks: list[str] = []
    for name, proj_dir in projects:
        active = parse_tasks_in_text(read_if_exists(proj_dir / "TODO.md"), "TODO.md")
        if not active:
            empty_projects.append(name)
            continue
        total_open += len(active)
        ordered = sorted(
            enumerate(active),
            key=lambda iv: (ACTIVE_STATUS_ORDER.get(str(iv[1]["status"]), 99), iv[0]),
        )
        has_expanded = any(str(t["status"]) in ("WIP", "NEXT", "QUESTION") for _, t in ordered)
        rendered = [
            _format_task_for_summary(
                t,
                full=(full or (not has_expanded and idx == 0)),
                base_dir=proj_dir,
                proj_prefix=name,
            )
            for idx, (_, t) in enumerate(ordered)
        ]
        blocks.append(f"## {name} ({len(active)} open)\n\n" + "\n\n".join(rendered))

    if blocks:
        sys.stdout.write("\n\n".join(blocks) + "\n\n")
    else:
        sys.stdout.write("*(No open tasks across workspace projects)*\n\n")
    sys.stdout.write("---\n")
    sys.stdout.write(f"Workspace: {workspace_root} | Projects: {len(projects)} | Open tasks: {total_open}\n")
    if empty_projects:
        sys.stdout.write(f"No open tasks: {', '.join(empty_projects)}\n")
    return 0


def cmd_workspace_list(
    workspace_root: Path,
    filt: str | None = None,
    limit: int | None = None,
    full: bool = False,
    role: str | None = None,
    ready: bool = False,
    targets: list[tuple[Path, str]] | None = None,
    focus: list[tuple[Path, str]] | None = None,
) -> int:
    projects = discover_projects(workspace_root)
    if not projects:
        sys.stdout.write(f"No todo_md projects found under {workspace_root}\n")
        return 0
    mode = (filt or "active").strip().lower()
    if mode not in ("active", "open", "archive", "all") and mode.upper() not in VALID_STATUSES:
        raise SystemExit(f"{prog_name()}: unknown list filter {filt!r}; expected active, archive, all, or a status name")
    items: list[tuple[str, Path, dict[str, object]]] = []
    for name, proj_dir in projects:
        tasks = collect_all_tasks(proj_dir)
        active = _order_active_tasks_for_list(
            [t for t in tasks if t["file"] == "TODO.md"],
            base_dir=proj_dir,
        )
        arch = [t for t in tasks if t["file"] == "TODO_ARCHIVE.md"]
        if mode in ("active", "open"):
            matched = active
        elif mode == "archive":
            matched = arch
        elif mode == "all":
            matched = active + arch
        else:
            st_up = mode.upper()
            matched = [t for t in (arch if st_up in ("DONE", "CANCELED") else active) if t["status"] == st_up]
        for t in matched:
            items.append((name, proj_dir, t))
    if role is not None:
        wanted_role = role.strip().lower()
        items = [(name, proj_dir, t) for name, proj_dir, t in items if _task_matches_role(t, wanted_role)]

    dep_cache: dict[tuple[Path, str, str], tuple[bool, str]] = {}

    def _ws_dep_info(proj_dir: Path, t: dict[str, object]) -> tuple[bool, str]:
        key = (proj_dir, str(t["file"]), str(t["id"]).upper())
        if key not in dep_cache:
            dep_cache[key] = _task_dependency_info(proj_dir, t)
        return dep_cache[key]

    if ready:
        items = [
            (name, proj_dir, t)
            for name, proj_dir, t in items
            if str(t["status"]) in ACTIVE_STATUS_ORDER and not _ws_dep_info(proj_dir, t)[0]
        ]

    if focus:
        focus_set, focus_unscoped = _normalize_target_refs(workspace_root, focus)
        if focus_set or focus_unscoped:
            items = [
                (name, proj_dir, t)
                for name, proj_dir, t in items
                if (proj_dir.resolve(), str(t["id"]).upper()) in focus_set or str(t["id"]).upper() in focus_unscoped
            ]

    if limit is not None:
        items = items[:limit]
    if not items:
        notes: list[str] = []
        if role is not None:
            notes.append(f"role={role.strip()}")
        if ready:
            notes.append("ready")
        extra = f", {', '.join(notes)}" if notes else ""
        sys.stdout.write(f"No matching tasks ({mode}{extra}) across workspace {workspace_root}\n")
        return 0
    if full:
        sections: list[str] = []
        for name, proj_dir, t in items:
            lines = str(t["section"]).rstrip().splitlines()
            tid = str(t["id"])
            lines[0] = lines[0].replace(f"] {tid}:", f"] {name}:{tid}:", 1)
            sections.append("\n".join(lines))
        sys.stdout.write("\n\n".join(sections) + "\n")
        return 0
    term_width = _get_terminal_columns()
    use_color = _use_ansi_color()
    target_set, unscoped_ids = _normalize_target_refs(workspace_root, targets)
    for name, proj_dir, t in items:
        is_blocked, dep_suffix = _ws_dep_info(proj_dir, t)
        st_str = str(t["status"])
        tid_up = str(t["id"]).upper()
        ref = f"{name}:{t['id']}"
        emoji = "⏳" if (st_str in ("WIP", "NEXT") and is_blocked) else str(t["emoji"])
        badge = f"{emoji} [{st_str}]"
        role_badge = _task_role_badge(t)
        prefix = (
            f"  {_pad_display(ref, 28)}  "
            f"{_pad_display(badge, 14)}  "
            f"{_pad_display(role_badge, 10)}  "
        )
        desc = f"{t['title']}{dep_suffix}"
        rendered = _wrap_table_row(prefix, desc, term_width) + "\n"
        is_highlighted = (proj_dir.resolve(), tid_up) in target_set or tid_up in unscoped_ids
        sys.stdout.write(
            _style_task_row(
                rendered,
                is_done=(st_str == "DONE"),
                is_highlighted=is_highlighted,
                use_color=use_color,
            )
        )
    return 0


def cmd_workspace_check(workspace_root: Path) -> int:
    projects = discover_projects(workspace_root)
    if not projects:
        sys.stdout.write(f"No todo_md projects found under {workspace_root}\n")
        return 0
    total_tasks = 0
    had_error = False
    for name, proj_dir in projects:
        errors, count = validate_all(proj_dir)
        total_tasks += count
        if errors:
            had_error = True
            for e in errors:
                sys.stderr.write(f"ERROR [{name}]: {e}\n")
    if had_error:
        return 1
    sys.stdout.write(f"{prog_name()}: OK ({total_tasks} task(s) verified across {len(projects)} project(s))\n")
    return 0


TODO_PROJECTS_FILES = (".todo_projects", ".todo_projects.local")


def _parse_todo_projects_text(raw_text: str) -> list[str]:
    entries: list[str] = []
    for raw_line in raw_text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        line = re.sub(r"\s+#.*$", "", line).strip()
        for part in line.split(","):
            tok = part.strip()
            if tok and tok not in entries:
                entries.append(tok)
    return entries


def _resolve_todo_project_entry(
    entry: str,
    config_dir: Path,
    ws_root: Path,
    discovered: list[tuple[str, Path]] | None = None,
) -> Path | None:
    raw = entry.strip()
    if not raw:
        return None
    cfg_res = config_dir.resolve()
    ws_res = ws_root.resolve()
    if raw in (".", "./"):
        return cfg_res if is_todo_project(cfg_res) else None
    p_cand = Path(raw).expanduser()
    candidates: list[Path] = []
    if p_cand.is_absolute():
        candidates.append(p_cand.resolve())
    else:
        candidates.append((cfg_res / p_cand).resolve())
        candidates.append((ws_res / p_cand).resolve())
        if cfg_res.parent != cfg_res:
            candidates.append((cfg_res.parent / p_cand).resolve())
    for cand in candidates:
        if is_todo_project(cand):
            return cand
    norm = raw.replace("\\", "/").strip("/")
    if not norm or ".." in norm.split("/"):
        return None
    projs = discovered if discovered is not None else discover_projects(ws_res)
    for rel, pdir in projs:
        if rel == norm:
            return pdir.resolve()
    if "/" not in norm:
        by_name = [pdir.resolve() for rel, pdir in projs if Path(rel).name == norm]
        if len(by_name) == 1:
            return by_name[0]
    return None


def read_configured_todo_projects(
    config_dir: Path,
    ws_root: Path | None = None,
    include_env: bool = True,
    discovered: list[tuple[str, Path]] | None = None,
    _visited: set[Path] | None = None,
) -> list[Path]:
    cfg_res = config_dir.resolve()
    visited = _visited if _visited is not None else set()
    if cfg_res in visited:
        return []
    visited.add(cfg_res)
    ws_res = (ws_root or resolve_workspace_root(cfg_res)).resolve()
    raw_entries: list[tuple[Path, str]] = []
    has_config_source = False

    for fname in TODO_PROJECTS_FILES:
        fpath = cfg_res / fname
        if fpath.is_file():
            has_config_source = True
            for item in _parse_todo_projects_text(read_if_exists(fpath)):
                raw_entries.append((cfg_res, item))
        elif fname == ".todo_projects" and fpath.is_dir():
            has_config_source = True
            if is_todo_project(fpath):
                raw_entries.append((fpath.resolve(), "."))
            for _, sub_dir in discover_projects(fpath):
                raw_entries.append((fpath.resolve(), str(sub_dir.resolve())))

    if include_env:
        env_raw = os.environ.get("TODO_MD_PROJECTS", "").strip()
        if env_raw:
            has_config_source = True
            p_env = Path(env_raw).expanduser()
            if p_env.is_file():
                env_cfg_dir = p_env.resolve().parent
                for item in _parse_todo_projects_text(read_if_exists(p_env)):
                    raw_entries.append((env_cfg_dir, item))
            else:
                tokens = [
                    t.strip()
                    for t in re.split(r"[\s,;]+|(?<!^[A-Za-z]):", env_raw)
                    if t.strip()
                ]
                for tok in tokens:
                    p_tok = Path(tok).expanduser()
                    if p_tok.is_file():
                        tok_dir = p_tok.resolve().parent
                        for item in _parse_todo_projects_text(read_if_exists(p_tok)):
                            raw_entries.append((tok_dir, item))
                    else:
                        raw_entries.append((cfg_res, tok))

    if not has_config_source:
        return []

    projs = discovered if discovered is not None else discover_projects(ws_res)
    resolved: list[Path] = []
    seen: set[Path] = set()

    def _add(p: Path | None) -> None:
        if p is not None:
            p_res = p.resolve()
            if p_res not in seen and is_todo_project(p_res):
                seen.add(p_res)
                resolved.append(p_res)

    if is_todo_project(cfg_res):
        _add(cfg_res)
    for src_dir, entry in raw_entries:
        if is_todo_project(src_dir):
            _add(src_dir)
        _add(_resolve_todo_project_entry(entry, src_dir, ws_res, discovered=projs))
    for child in list(resolved):
        if child != cfg_res and has_local_todo_projects_config(child):
            for grand in read_configured_todo_projects(
                child, ws_res, include_env=False, discovered=projs, _visited=visited
            ):
                _add(grand)
    return resolved


def has_local_todo_projects_config(directory: Path) -> bool:
    d_res = directory.resolve()
    for fname in TODO_PROJECTS_FILES:
        p = d_res / fname
        if p.is_file() or (fname == ".todo_projects" and p.is_dir()):
            return True
    return False


def is_orchestrator_project(
    base_dir: Path,
    ws_root: Path | None = None,
    explicit_dir: str | None = None,
) -> bool:
    b_res = base_dir.resolve()
    if has_local_todo_projects_config(b_res):
        return True
    env_raw = os.environ.get("TODO_MD_PROJECTS", "").strip()
    if not env_raw:
        return False
    p_env = Path(env_raw).expanduser()
    if p_env.is_file():
        return p_env.resolve().parent == b_res
    if explicit_dir is not None:
        return False
    ws_res = (ws_root or resolve_workspace_root(b_res)).resolve()
    projs = discover_projects(ws_res)
    for _, pdir in projs:
        p_res = pdir.resolve()
        if p_res != b_res and has_local_todo_projects_config(p_res):
            return False
    configured = read_configured_todo_projects(b_res, ws_res, include_env=True, discovered=projs)
    cfg_set = set(configured)

    def _has_cross_project_deps(proj_dir: Path) -> bool:
        for t in parse_tasks_in_text(read_if_exists(proj_dir / "TODO.md"), "TODO.md"):
            for dep in parse_task_dependencies(str(t["section"])):
                pm = PROJECT_TASK_RE.match(dep)
                if pm:
                    dep_proj = _resolve_todo_project_entry(pm.group(1), proj_dir, ws_res, discovered=projs)
                    if dep_proj is not None and dep_proj != proj_dir and dep_proj in cfg_set:
                        return True
        return False

    for p_res in configured:
        if p_res == b_res:
            continue
        for t in parse_tasks_in_text(read_if_exists(p_res / "TODO.md"), "TODO.md"):
            for dep in parse_task_dependencies(str(t["section"])):
                pm = PROJECT_TASK_RE.match(dep)
                if pm:
                    dep_proj = _resolve_todo_project_entry(pm.group(1), p_res, ws_res, discovered=projs)
                    if dep_proj == b_res:
                        return False
    if not _has_cross_project_deps(b_res) and any(
        p_res != b_res and _has_cross_project_deps(p_res) for p_res in configured
    ):
        return False
    return True


def discover_orchestrators_for_project(
    target_dir: Path,
    ws_root: Path | None = None,
) -> tuple[list[Path], list[Path]]:
    t_res = target_dir.resolve()
    ws_res = (ws_root or resolve_workspace_root(t_res)).resolve()
    projs = discover_projects(ws_res)

    probe_dirs: list[Path] = []
    seen_probes: set[Path] = set()

    def _add_probe(d: Path) -> None:
        d_res = d.resolve()
        if d_res not in seen_probes and d_res.is_dir():
            seen_probes.add(d_res)
            probe_dirs.append(d_res)

    _add_probe(ws_res)
    for anc in t_res.parents:
        _add_probe(anc)
        if anc.resolve() == ws_res:
            break
    for _, pdir in projs:
        _add_probe(pdir)

    orchestrators: list[Path] = []
    configured_union: list[Path] = []
    seen_orch: set[Path] = set()
    seen_cfg: set[Path] = set()

    def _add_enclosing_probes(d: Path) -> None:
        home = _home_dir()
        for anc in d.parents:
            _add_probe(anc)
            if anc.resolve() in (ws_res, home):
                break

    probe_idx = 0
    while probe_idx < len(probe_dirs):
        cand = probe_dirs[probe_idx]
        probe_idx += 1
        if not has_local_todo_projects_config(cand):
            continue
        cfg_list = read_configured_todo_projects(cand, ws_res, include_env=False, discovered=projs)
        if t_res in cfg_list:
            if is_todo_project(cand) and cand not in seen_orch:
                seen_orch.add(cand)
                orchestrators.append(cand)
                _add_enclosing_probes(cand)
            tp_dir = cand / ".todo_projects"
            if tp_dir.is_dir() and is_todo_project(tp_dir) and tp_dir.resolve() not in seen_orch:
                seen_orch.add(tp_dir.resolve())
                orchestrators.append(tp_dir.resolve())
            for p in cfg_list:
                if p not in seen_cfg:
                    seen_cfg.add(p)
                    configured_union.append(p)

    env_raw = os.environ.get("TODO_MD_PROJECTS", "").strip()
    if env_raw:
        env_cfg = read_configured_todo_projects(ws_res, ws_res, include_env=True, discovered=projs)
        if t_res in env_cfg:
            for p in env_cfg:
                if p not in seen_cfg:
                    seen_cfg.add(p)
                    configured_union.append(p)
                if p != t_res and is_todo_project(p) and p not in seen_orch:
                    seen_orch.add(p)
                    orchestrators.append(p)

    return orchestrators, configured_union


def resolve_workspace_chain_projects(
    base_dir: Path,
    ws_root: Path,
) -> list[tuple[str, Path]]:
    b_res = base_dir.resolve()
    ws_res = ws_root.resolve()
    all_projs = discover_projects(ws_res)

    configured: list[Path] = []
    seen: set[Path] = set()

    def _merge(paths: list[Path]) -> None:
        for p in paths:
            p_res = p.resolve()
            if p_res not in seen and is_todo_project(p_res):
                seen.add(p_res)
                configured.append(p_res)

    if has_local_todo_projects_config(b_res) or os.environ.get("TODO_MD_PROJECTS", "").strip():
        if (b_res / "TODO.md").is_file() or (b_res / "TODO_ARCHIVE.md").is_file():
            _merge([b_res])
        _merge(read_configured_todo_projects(b_res, ws_res, include_env=True, discovered=all_projs))
    if not configured and has_local_todo_projects_config(ws_res):
        _merge(read_configured_todo_projects(ws_res, ws_res, include_env=True, discovered=all_projs))
    if not configured:
        for _, pdir in all_projs:
            if has_local_todo_projects_config(pdir):
                _merge(read_configured_todo_projects(pdir, ws_res, include_env=False, discovered=all_projs))

    if not configured:
        return all_projs

    result: list[tuple[str, Path]] = []
    for p_res in configured:
        result.append((project_label(p_res, ws_res), p_res))
    return result


def build_execution_chain_dag(
    base_dir: Path,
    workspace: bool = False,
    explicit_dir: str | None = None,
    include_done: bool = False,
) -> dict[str, object]:
    b_res = base_dir.resolve()
    ws_root = resolve_workspace_root(b_res, explicit_dir=explicit_dir)
    ws_resolved = ws_root.resolve()
    cwd_resolved = Path.cwd().resolve()

    is_orch = (not workspace) and is_orchestrator_project(b_res, ws_resolved, explicit_dir=explicit_dir)
    disp_is_proj = (not workspace) and (b_res == cwd_resolved) and is_todo_project(cwd_resolved)
    disp_resolved = cwd_resolved

    all_ws_projects = discover_projects(ws_resolved)
    project_lookup: dict[str, Path] = {}
    for rel, pdir in all_ws_projects:
        p_res = pdir.resolve()
        project_lookup[rel] = p_res
        if "/" not in rel and p_res.name not in project_lookup:
            project_lookup[p_res.name] = p_res

    seed_dirs: list[Path] = []
    seen_seed_dirs: set[Path] = set()

    def _add_seed_dir(p: Path) -> None:
        p_res = p.resolve()
        if p_res not in seen_seed_dirs and is_todo_project(p_res):
            seen_seed_dirs.add(p_res)
            seed_dirs.append(p_res)
            project_lookup.setdefault(project_label(p_res, ws_resolved), p_res)
            project_lookup.setdefault(p_res.name, p_res)

    if workspace:
        for _, proj_dir in resolve_workspace_chain_projects(b_res, ws_resolved):
            _add_seed_dir(proj_dir)
    elif is_orch:
        if (b_res / "TODO.md").is_file() or (b_res / "TODO_ARCHIVE.md").is_file():
            _add_seed_dir(b_res)
        for proj_dir in read_configured_todo_projects(
            b_res, ws_resolved, include_env=True, discovered=all_ws_projects
        ):
            _add_seed_dir(proj_dir)
        enclosing_orchs, enclosing_cfg = discover_orchestrators_for_project(b_res, ws_resolved)
        for extra_dir in (*enclosing_orchs, *enclosing_cfg):
            _add_seed_dir(extra_dir)
    else:
        _add_seed_dir(b_res)
        orch_dirs, cfg_dirs = discover_orchestrators_for_project(b_res, ws_resolved)
        for odir in orch_dirs:
            _add_seed_dir(odir)
        for cdir in cfg_dirs:
            _add_seed_dir(cdir)

    task_cache: dict[Path, dict[str, dict[str, object]]] = {}

    def _task_map(proj_dir: Path) -> dict[str, dict[str, object]]:
        p_res = proj_dir.resolve()
        if p_res not in task_cache:
            mapping: dict[str, dict[str, object]] = {}
            if is_todo_project(p_res):
                for t in collect_all_tasks(p_res):
                    mapping[str(t["id"]).upper()] = t
            task_cache[p_res] = mapping
        return task_cache[p_res]

    def _resolve_ref(cur_dir: Path, ref: str) -> tuple[Path, str]:
        pm = PROJECT_TASK_RE.match(ref)
        if pm:
            proj_name = pm.group(1).strip().replace("\\", "/").strip("/")
            cand = (ws_resolved / proj_name).resolve()
            if is_todo_project(cand):
                return cand, pm.group(2).upper()
            if ws_resolved.name == ".todo_projects":
                alt = (ws_resolved.parent / proj_name).resolve()
                if is_todo_project(alt):
                    return alt, pm.group(2).upper()
            if proj_name in project_lookup:
                return project_lookup[proj_name], pm.group(2).upper()
            return cand, pm.group(2).upper()
        return cur_dir.resolve(), ref.upper()

    def _format_ref(node_key: tuple[Path, str]) -> str:
        ndir, ntid = node_key
        if disp_is_proj and ndir == disp_resolved:
            return ntid
        return f"{project_label(ndir, ws_resolved)}:{ntid}"

    seeds: list[tuple[Path, str]] = []
    for p_res in seed_dirs:
        for t in parse_tasks_in_text(read_if_exists(p_res / "TODO.md"), "TODO.md"):
            seeds.append((p_res, str(t["id"]).upper()))

    nodes: dict[tuple[Path, str], dict[str, object]] = {}
    open_nodes: list[tuple[Path, str]] = []
    open_node_set: set[tuple[Path, str]] = set()
    done_visited: set[tuple[Path, str]] = set()
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = {}
    prereq_sets: dict[tuple[Path, str], set[tuple[Path, str]]] = {}
    done_graph_prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = {}
    done_graph_prereq_sets: dict[tuple[Path, str], set[tuple[Path, str]]] = {}
    direct_done_deps: dict[tuple[Path, str], list[tuple[Path, str]]] = {}
    direct_done_dep_sets: dict[tuple[Path, str], set[tuple[Path, str]]] = {}
    done_prereqs: dict[tuple[Path, str], list[str]] = {}
    done_prereq_sets: dict[tuple[Path, str], set[str]] = {}
    done_nodes: dict[tuple[Path, str], set[tuple[Path, str]]] = {}
    order_idx: dict[tuple[Path, str], int] = {}
    done_order_idx: dict[tuple[Path, str], int] = {}
    syntax_errors: list[str] = []

    def _ensure_node_slot(k: tuple[Path, str]) -> None:
        if k not in prereqs:
            prereqs[k] = []
            prereq_sets[k] = set()
        if k not in done_graph_prereqs:
            done_graph_prereqs[k] = []
            done_graph_prereq_sets[k] = set()
        if k not in direct_done_deps:
            direct_done_deps[k] = []
            direct_done_dep_sets[k] = set()
        if k not in done_prereqs:
            done_prereqs[k] = []
            done_prereq_sets[k] = set()
        if k not in done_nodes:
            done_nodes[k] = set()

    def _add_prereq(node: tuple[Path, str], dep: tuple[Path, str]) -> None:
        _ensure_node_slot(node)
        _ensure_node_slot(dep)
        if dep not in prereq_sets[node]:
            prereq_sets[node].add(dep)
            prereqs[node].append(dep)

    def _is_done(node_key: tuple[Path, str]) -> bool:
        tdict = _task_map(node_key[0]).get(node_key[1])
        return tdict is not None and str(tdict["status"]) == "DONE"

    def _add_done_graph_edge(node: tuple[Path, str], dep: tuple[Path, str]) -> None:
        if node == dep:
            return
        _ensure_node_slot(node)
        _ensure_node_slot(dep)
        if dep not in done_graph_prereq_sets[node]:
            done_graph_prereq_sets[node].add(dep)
            done_graph_prereqs[node].append(dep)

    def _visit_done(done_key: tuple[Path, str]) -> None:
        if not _is_done(done_key) or done_key in done_visited:
            return
        done_visited.add(done_key)
        _ensure_node_slot(done_key)
        ddir, dtid = done_key
        tdict = _task_map(ddir).get(dtid)
        if tdict is not None:
            nodes[done_key] = {
                **tdict,
                "exists": True,
                "ref": _format_ref(done_key),
            }
            clauses, _ = parse_dependency_clauses(str(tdict.get("section", "")))
            to_visit_done: list[tuple[Path, str]] = []
            for clause in clauses:
                resolved_stages = [[_resolve_ref(ddir, r) for r in stage] for stage in clause]
                for i, stage_keys in enumerate(resolved_stages):
                    for k in stage_keys:
                        if _is_done(k):
                            _add_done_graph_edge(done_key, k)
                            to_visit_done.append(k)
                            if i > 0:
                                for prev_k in resolved_stages[i - 1]:
                                    if _is_done(prev_k):
                                        _add_done_graph_edge(k, prev_k)
            for k in to_visit_done:
                _visit_done(k)
        done_order_idx[done_key] = len(done_order_idx)

    def _add_done_prereq(node: tuple[Path, str], dep: tuple[Path, str]) -> None:
        _ensure_node_slot(node)
        _visit_done(dep)
        dep_ref = _format_ref(dep)
        if dep_ref not in done_prereq_sets[node]:
            done_prereq_sets[node].add(dep_ref)
            done_prereqs[node].append(dep_ref)
        if dep not in direct_done_dep_sets[node]:
            direct_done_dep_sets[node].add(dep)
            direct_done_deps[node].append(dep)

    def _visit(node_key: tuple[Path, str]) -> None:
        if node_key in open_node_set:
            return
        ndir, ntid = node_key
        tdict = _task_map(ndir).get(ntid)
        if tdict is None:
            _ensure_node_slot(node_key)
            missing_title = "(missing task)" if is_todo_project(ndir) else "(unknown project)"
            nodes[node_key] = {
                "id": ntid,
                "status": "MISSING",
                "emoji": "",
                "title": missing_title,
                "exists": False,
                "ref": _format_ref(node_key),
            }
            open_node_set.add(node_key)
            open_nodes.append(node_key)
            order_idx[node_key] = len(order_idx)
            return

        st = str(tdict["status"])
        if st == "DONE":
            return

        _ensure_node_slot(node_key)
        nodes[node_key] = {
            **tdict,
            "exists": True,
            "ref": _format_ref(node_key),
        }
        open_node_set.add(node_key)
        open_nodes.append(node_key)
        clauses, errs = parse_dependency_clauses(str(tdict["section"]))
        for err in errs:
            syntax_errors.append(f"{_format_ref(node_key)}: {err}")

        to_visit: list[tuple[Path, str]] = []
        for clause in clauses:
            resolved_stages = [[_resolve_ref(ndir, r) for r in stage] for stage in clause]
            for i, stage_keys in enumerate(resolved_stages):
                for k in stage_keys:
                    if _is_done(k):
                        _add_done_prereq(node_key, k)
                        if i > 0:
                            for prev_k in resolved_stages[i - 1]:
                                if _is_done(prev_k):
                                    _add_done_graph_edge(k, prev_k)
                        continue
                    _add_prereq(node_key, k)
                    to_visit.append(k)
                    if i > 0:
                        for prev_k in resolved_stages[i - 1]:
                            if _is_done(prev_k):
                                _add_done_prereq(k, prev_k)
                                continue
                            _add_prereq(k, prev_k)
        for k in to_visit:
            _visit(k)
        order_idx[node_key] = len(order_idx)

    for seed in seeds:
        _visit(seed)

    def _canon_ref_key(u: tuple[Path, str]) -> tuple[str, str, str]:
        return (str(nodes[u]["ref"]), u[0].as_posix(), u[1])

    done_in_deg: dict[tuple[Path, str], int] = {
        d: len(done_graph_prereqs.get(d, [])) for d in done_visited
    }
    done_dependents: dict[tuple[Path, str], list[tuple[Path, str]]] = {
        d: [] for d in done_visited
    }
    for d in done_visited:
        for p in done_graph_prereqs.get(d, []):
            if p in done_dependents:
                done_dependents[p].append(d)
    done_avail = [
        (done_order_idx.get(d, 0), _canon_ref_key(d), d)
        for d in done_visited
        if done_in_deg[d] == 0
    ]
    heapq.heapify(done_avail)
    done_topo_order: list[tuple[Path, str]] = []
    while done_avail:
        _, _, d = heapq.heappop(done_avail)
        done_topo_order.append(d)
        for v in done_dependents.get(d, []):
            done_in_deg[v] -= 1
            if done_in_deg[v] == 0:
                heapq.heappush(done_avail, (done_order_idx.get(v, 0), _canon_ref_key(v), v))
    if len(done_topo_order) < len(done_visited):
        seen_done_topo = set(done_topo_order)
        rest_done = sorted(
            [d for d in done_visited if d not in seen_done_topo],
            key=lambda d: (done_order_idx.get(d, 0), _canon_ref_key(d)),
        )
        done_topo_order.extend(rest_done)

    for d in done_topo_order:
        _ensure_node_slot(d)
        done_nodes[d].add(d)
        for p in done_graph_prereqs.get(d, []):
            done_nodes[d] |= done_nodes.get(p, {p})

    in_degree: dict[tuple[Path, str], int] = {u: len(prereqs[u]) for u in open_nodes}
    dependents: dict[tuple[Path, str], list[tuple[Path, str]]] = {u: [] for u in open_nodes}
    for u in open_nodes:
        for p in prereqs[u]:
            if p in dependents:
                dependents[p].append(u)

    unblocks = compute_unblock_counts(nodes, dependents, allowed=open_node_set)

    def _sort_key(u: tuple[Path, str]) -> tuple[int, int, int, tuple[str, str, str], tuple[Path, str]]:
        st = str(nodes[u]["status"])
        prio = ACTIVE_STATUS_ORDER.get(st, 99)
        return (prio, -unblocks.get(u, 0), order_idx.get(u, 0), _canon_ref_key(u), u)

    avail = [_sort_key(u) for u in open_nodes if in_degree[u] == 0]
    heapq.heapify(avail)
    topo_order: list[tuple[Path, str]] = []
    while avail:
        _, _, _, _, u = heapq.heappop(avail)
        topo_order.append(u)
        for v in dependents[u]:
            in_degree[v] -= 1
            if in_degree[v] == 0:
                heapq.heappush(avail, _sort_key(v))

    for u in topo_order:
        _ensure_node_slot(u)
        for d in direct_done_deps.get(u, []):
            done_nodes[u] |= done_nodes.get(d, {d})
        for p in prereqs.get(u, []):
            done_nodes[u] |= done_nodes.get(p, set())

    cycle: list[str] = []
    if len(topo_order) < len(open_nodes):
        cyclic_nodes = {u for u, deg in in_degree.items() if deg > 0}
        state: dict[tuple[Path, str], int] = {}
        stack: list[tuple[Path, str]] = []

        def _find_cycle(u: tuple[Path, str]) -> list[tuple[Path, str]] | None:
            state[u] = 1
            stack.append(u)
            for nxt in prereqs[u]:
                if nxt not in cyclic_nodes:
                    continue
                st_nxt = state.get(nxt, 0)
                if st_nxt == 1:
                    idx_start = stack.index(nxt)
                    return list(reversed(stack[idx_start:] + [nxt]))
                if st_nxt == 0:
                    res = _find_cycle(nxt)
                    if res:
                        return res
            stack.pop()
            state[u] = 2
            return None

        ordered_cyclic = sorted(cyclic_nodes, key=lambda k: (order_idx.get(k, 0), _canon_ref_key(k)))
        for start_node in ordered_cyclic:
            if state.get(start_node, 0) == 0:
                found_cyc = _find_cycle(start_node)
                if found_cyc:
                    cycle = [str(nodes[k]["ref"]) for k in found_cyc]
                    break

    target_project = None if (workspace or is_orch) else b_res
    scope_dirs = [target_project] if target_project is not None else list(seed_dirs)
    top_done_candidates: list[tuple[int, int, tuple[Path, str]]] = []
    for s_idx, p_res in enumerate(scope_dirs):
        if p_res is None:
            continue
        arch_path = p_res / "TODO_ARCHIVE.md"
        if not arch_path.is_file():
            continue
        try:
            mtime_ns = arch_path.stat().st_mtime_ns
        except OSError:
            mtime_ns = 0
        for t in parse_tasks_in_text(read_if_exists(arch_path), "TODO_ARCHIVE.md"):
            if str(t["status"]) == "DONE":
                top_done_candidates.append((mtime_ns, -s_idx, (p_res.resolve(), str(t["id"]).upper())))
                break
    latest_done_task: tuple[Path, str] | None = (
        max(top_done_candidates)[2] if top_done_candidates else None
    )

    archived_tasks: list[tuple[Path, str]] = []
    if include_done:
        seen_arch: set[tuple[Path, str]] = set()
        for p_res in seed_dirs:
            arch_path = p_res / "TODO_ARCHIVE.md"
            if not arch_path.is_file():
                continue
            for t in parse_tasks_in_text(read_if_exists(arch_path), "TODO_ARCHIVE.md"):
                arch_key = (p_res.resolve(), str(t["id"]).upper())
                if arch_key in seen_arch:
                    continue
                seen_arch.add(arch_key)
                if arch_key not in nodes:
                    _ensure_node_slot(arch_key)
                    nodes[arch_key] = {
                        **t,
                        "exists": True,
                        "ref": _format_ref(arch_key),
                    }
                archived_tasks.append(arch_key)

    return {
        "nodes": nodes,
        "archived_tasks": archived_tasks,
        "prereqs": prereqs,
        "done_prereqs": done_prereqs,
        "done_graph_prereqs": done_graph_prereqs,
        "direct_done_deps": direct_done_deps,
        "done_nodes": done_nodes,
        "done_topo_order": done_topo_order,
        "dependents": dependents,
        "unblocks": unblocks,
        "order_idx": order_idx,
        "topo_order": topo_order,
        "cycle": cycle,
        "syntax_errors": syntax_errors,
        "is_orchestrator": is_orch,
        "target_project": target_project,
        "latest_done_task": latest_done_task,
        "include_done": include_done,
    }


def compute_unblock_counts(
    nodes: dict[tuple[Path, str], dict[str, object]],
    dependents: dict[tuple[Path, str], list[tuple[Path, str]]],
    allowed: set[tuple[Path, str]] | None = None,
) -> dict[tuple[Path, str], int]:
    unblocks: dict[tuple[Path, str], int] = {}
    for u in nodes:
        if allowed is not None and u not in allowed:
            continue
        visited: set[tuple[Path, str]] = set()
        stack = list(dependents.get(u, []))
        while stack:
            cur = stack.pop()
            if cur == u or cur in visited:
                continue
            if allowed is not None and cur not in allowed:
                continue
            visited.add(cur)
            for nxt in dependents.get(cur, []):
                if nxt != u and nxt not in visited and (allowed is None or nxt in allowed):
                    stack.append(nxt)
        unblocks[u] = len(visited)
    return unblocks


def _is_ready_in_dag(
    nodes: dict[tuple[Path, str], dict[str, object]],
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]],
    u: tuple[Path, str],
    include_hold: bool = False,
) -> bool:
    st = str(nodes[u]["status"])
    if st not in ACTIVE_STATUS_ORDER:
        return False
    if not include_hold and st == "HOLD":
        return False
    return not any(str(nodes[p]["status"]) != "DONE" for p in prereqs.get(u, []))


def _canonical_task_ref_key(
    nodes: dict[tuple[Path, str], dict[str, object]],
    u: tuple[Path, str],
) -> tuple[str, str, str]:
    nd = nodes.get(u)
    ref = str(nd["ref"]) if nd is not None and "ref" in nd else u[1]
    return (ref, u[0].as_posix(), u[1])


def _is_bug_task_node(
    nodes: dict[tuple[Path, str], dict[str, object]],
    u: tuple[Path, str],
) -> bool:
    nd = nodes.get(u)
    raw_id = str(nd.get("id") or u[1]) if nd is not None else u[1]
    tid = raw_id.split(":")[-1].strip().upper()
    return tid.startswith("B")


def _is_bug_node_key(u: tuple[Path, str]) -> bool:
    tid = u[1].split(":")[-1].strip().upper()
    return tid.startswith("B")


def _resolve_node_role(
    nodes: dict[tuple[Path, str], dict[str, object]],
    u: tuple[Path, str],
) -> str | None:
    nd = nodes.get(u)
    if nd is None or not nd.get("exists", True):
        return None
    raw_role = nd.get("role")
    if not raw_role:
        raw_id = str(nd.get("id") or u[1]).split(":")[-1].strip()
        raw_role = resolve_task_role(
            raw_id,
            str(nd.get("section", "")),
            status=str(nd.get("status", "")),
        )
    if not raw_role:
        return None
    return str(raw_role).strip().lower() or None


def _resolve_node_role_ease(
    nodes: dict[tuple[Path, str], dict[str, object]],
    u: tuple[Path, str],
) -> int:
    role = _resolve_node_role(nodes, u)
    if not role:
        return len(ROLE_EASE_ORDER)
    return ROLE_EASE_ORDER.get(role, len(ROLE_EASE_ORDER))


def _resolve_node_role_weight(
    nodes: dict[tuple[Path, str], dict[str, object]],
    u: tuple[Path, str],
) -> int:
    role = _resolve_node_role(nodes, u)
    if not role:
        return ROLE_EFFORT_WEIGHTS["design"]
    return ROLE_EFFORT_WEIGHTS.get(role, ROLE_EFFORT_WEIGHTS["design"])


def _prepare_active_plan(
    dag: dict[str, object],
    include_hold: bool = False,
) -> dict[str, object]:
    nodes: dict[tuple[Path, str], dict[str, object]] = dag["nodes"]  # type: ignore[assignment]
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["prereqs"]  # type: ignore[assignment]
    done_prereqs: dict[tuple[Path, str], list[str]] = dag.get("done_prereqs", {})  # type: ignore[assignment]
    done_nodes: dict[tuple[Path, str], set[tuple[Path, str]]] = dag.get("done_nodes", {})  # type: ignore[assignment]
    dependents: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["dependents"]  # type: ignore[assignment]
    topo_order: list[tuple[Path, str]] = dag["topo_order"]  # type: ignore[assignment]
    order_idx: dict[tuple[Path, str], int] = dag.get("order_idx", {})  # type: ignore[assignment]

    held_nodes: set[tuple[Path, str]] = set()
    hold_stack = [u for u in topo_order if str(nodes[u]["status"]) == "HOLD"]
    while hold_stack:
        cur = hold_stack.pop()
        if cur in held_nodes:
            continue
        held_nodes.add(cur)
        for nxt in dependents.get(cur, []):
            if nxt not in held_nodes:
                hold_stack.append(nxt)

    if include_hold:
        active_list = list(topo_order)
        excluded_hold: set[tuple[Path, str]] = set()
    else:
        active_list = [u for u in topo_order if u not in held_nodes]
        excluded_hold = held_nodes
    active_set = set(active_list)

    active_unblocks = compute_unblock_counts(nodes, dependents, allowed=active_set)
    finale_set: set[tuple[Path, str]] = {
        u
        for u in active_list
        if bool(done_prereqs.get(u) or done_nodes.get(u))
        and _is_ready_in_dag(nodes, prereqs, u, include_hold=include_hold)
        and active_unblocks.get(u, 0) == 0
        and _resolve_node_role(nodes, u) == "work"
    }

    latest_done_task: tuple[Path, str] | None = dag.get("latest_done_task")  # type: ignore[assignment]
    direct_done_deps: dict[tuple[Path, str], list[tuple[Path, str]]] = dag.get("direct_done_deps", {})  # type: ignore[assignment]

    def _is_done_node(n: tuple[Path, str]) -> bool:
        return str(nodes[n]["status"]) == "DONE"

    root_nodes = [
        u
        for u in active_list
        if not any(v in active_set for v in dependents.get(u, []))
        and (
            any(p in active_set for p in prereqs.get(u, []))
            or bool(done_prereqs.get(u) or done_nodes.get(u))
        )
    ]
    chain_counts: dict[tuple[Path, str], int] = {u: 0 for u in active_list}
    for root in root_nodes:
        cone = {root}
        cone_stack = [root]
        while cone_stack:
            cur = cone_stack.pop()
            for pre in prereqs.get(cur, []):
                if pre in active_set and pre not in cone:
                    cone.add(pre)
                    cone_stack.append(pre)
        for member in cone:
            chain_counts[member] += 1

    immediate_ready_targets: dict[tuple[Path, str], list[tuple[Path, str]]] = {}
    for u in active_list:
        immediate_ready_targets[u] = [
            v
            for v in dependents.get(u, [])
            if v in active_set and [pre for pre in prereqs.get(v, []) if not _is_done_node(pre)] == [u]
        ]
    ready_unblocks: dict[tuple[Path, str], int] = {
        u: len(targets) for u, targets in immediate_ready_targets.items()
    }
    done_counts: dict[tuple[Path, str], int] = {
        u: len(done_nodes.get(u, set())) for u in active_list
    }
    is_momentum_next: dict[tuple[Path, str], int] = {
        u: (
            0
            if latest_done_task is not None
            and (
                latest_done_task in done_nodes.get(u, set())
                or latest_done_task in direct_done_deps.get(u, [])
            )
            else 1
        )
        for u in active_list
    }

    best_chain_rank: dict[tuple[Path, str], int] = {}

    def _node_rank(
        u: tuple[Path, str],
        ready_step: int = 0,
    ) -> tuple[int, int, int, int, int, int, int, int, int, int, int, tuple[str, str, str], tuple[Path, str]]:
        st = str(nodes[u]["status"])
        prio = ACTIVE_STATUS_ORDER.get(st, 99)
        is_fin = 0 if u in finale_set else 1
        return (
            prio,
            is_fin,
            _resolve_node_role_ease(nodes, u),
            is_momentum_next.get(u, 1),
            best_chain_rank.get(u, 0),
            -chain_counts.get(u, 0),
            -done_counts.get(u, 0),
            -ready_unblocks.get(u, 0),
            -active_unblocks.get(u, 0),
            -ready_step,
            order_idx.get(u, 0),
            _canonical_task_ref_key(nodes, u),
            u,
        )

    in_deg = {u: sum(1 for p in prereqs.get(u, []) if p in active_set) for u in active_list}
    avail = [_node_rank(u, 0) for u in active_list if in_deg[u] == 0]
    heapq.heapify(avail)
    ranked_active: list[tuple[Path, str]] = []
    step_num = 0
    while avail:
        *_, u = heapq.heappop(avail)
        ranked_active.append(u)
        step_num += 1
        for v in dependents.get(u, []):
            if v in active_set:
                in_deg[v] -= 1
                if in_deg[v] == 0:
                    heapq.heappush(avail, _node_rank(v, step_num))
    if len(ranked_active) < len(active_list):
        seen_ranked = set(ranked_active)
        rest = [u for u in active_list if u not in seen_ranked]
        rest.sort(key=_node_rank)
        ranked_active.extend(rest)

    return {
        "active_list": active_list,
        "active_set": active_set,
        "ranked_active": ranked_active,
        "active_unblocks": active_unblocks,
        "excluded_hold": excluded_hold,
        "finale_set": finale_set,
        "chain_counts": chain_counts,
        "done_counts": done_counts,
        "is_momentum_next": is_momentum_next,
        "ready_unblocks": ready_unblocks,
        "immediate_ready_targets": immediate_ready_targets,
        "node_rank": _node_rank,
        "best_chain_rank": best_chain_rank,
    }


def build_chain_milestone_tree(
    root: tuple[Path, str],
    display_nodes: list[tuple[Path, str]],
    nodes: dict[tuple[Path, str], dict[str, object]],
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]],
    done_nodes: dict[tuple[Path, str], set[tuple[Path, str]]] | None = None,
    direct_done_deps: dict[tuple[Path, str], list[tuple[Path, str]]] | None = None,
    done_graph_prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] | None = None,
    include_done: bool = False,
) -> dict[str, object]:
    done_map = done_nodes or {}
    direct_done_map = direct_done_deps or {}
    done_graph_map = done_graph_prereqs or {}
    display_set = set(display_nodes)
    pos_map = {u: idx for idx, u in enumerate(display_nodes)}

    raw_prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = {u: [] for u in display_nodes}
    for u in display_nodes:
        seen_p: set[tuple[Path, str]] = set()
        st = str(nodes.get(u, {}).get("status", ""))
        cand_prereqs: list[tuple[Path, str]] = []
        if st == "DONE":
            if include_done:
                cand_prereqs.extend(done_graph_map.get(u, []))
        else:
            if include_done:
                cand_prereqs.extend(direct_done_map.get(u, []))
            cand_prereqs.extend(prereqs.get(u, []))
        for p in cand_prereqs:
            if p != u and p in display_set and p not in seen_p:
                seen_p.add(p)
                raw_prereqs[u].append(p)
        raw_prereqs[u].sort(key=lambda p: pos_map.get(p, len(display_nodes)))

    anc_cache: dict[tuple[Path, str], set[tuple[Path, str]]] = {}

    def _ancestors(u: tuple[Path, str]) -> set[tuple[Path, str]]:
        if u not in anc_cache:
            found: set[tuple[Path, str]] = set()
            stack = list(raw_prereqs.get(u, []))
            while stack:
                cur = stack.pop()
                if cur == u or cur in found:
                    continue
                found.add(cur)
                for nxt in raw_prereqs.get(cur, []):
                    if nxt != u and nxt not in found:
                        stack.append(nxt)
            anc_cache[u] = found
        return anc_cache[u]

    reduced_prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = {}
    for u in display_nodes:
        direct = raw_prereqs.get(u, [])
        reduced_prereqs[u] = [
            p
            for p in direct
            if not any(p in _ancestors(other) for other in direct if other != p)
        ]

    full_open_cache: dict[tuple[Path, str], set[tuple[Path, str]]] = {}
    full_done_cache: dict[tuple[Path, str], set[tuple[Path, str]]] = {}

    def _milestone_stats(m: tuple[Path, str]) -> tuple[int, int, int, int]:
        if m not in full_open_cache:
            st_m = str(nodes.get(m, {}).get("status", ""))
            if st_m == "DONE":
                open_cone: set[tuple[Path, str]] = set()
                done_cone = set(done_map.get(m, {m}))
            else:
                open_cone = {m}
                stk = [m]
                while stk:
                    cur = stk.pop()
                    for p in prereqs.get(cur, []):
                        if p in nodes and str(nodes[p].get("status", "")) != "DONE" and p not in open_cone:
                            open_cone.add(p)
                            stk.append(p)
                done_cone = set()
                for u_open in open_cone:
                    done_cone |= set(done_map.get(u_open, set()))
            full_open_cache[m] = open_cone
            full_done_cache[m] = done_cone
        open_c = len(full_open_cache[m])
        done_c = len(full_done_cache[m])
        total_c = done_c + open_c
        pct_c = round(100 * done_c / total_c) if total_c > 0 else 0
        return total_c, pct_c, done_c, open_c

    emitted: set[tuple[Path, str]] = set()

    def _collect_subtree_nodes(u: tuple[Path, str]) -> set[tuple[Path, str]]:
        return (_ancestors(u) | {u}) & display_set

    def _is_done(u: tuple[Path, str]) -> bool:
        return str(nodes.get(u, {}).get("status", "")) == "DONE"

    def _done_claims(us: set[tuple[Path, str]]) -> set[tuple[Path, str]]:
        claimed: set[tuple[Path, str]] = set()
        for u in us:
            if _is_done(u):
                claimed |= set(done_map.get(u, {u}))
            else:
                claimed |= set(done_map.get(u, set()))
        return claimed

    def _build_node(target: tuple[Path, str], is_root: bool) -> dict[str, object]:
        claimed_before = _done_claims(emitted)
        children_items: list[dict[str, object]] = []
        direct_children = [p for p in reduced_prereqs.get(target, []) if p not in emitted]
        def _child_subtree_sort_key(c: tuple[Path, str]) -> tuple[int, int]:
            c_nodes = [u for u in (_ancestors(c) | {c}) if u in display_set and u not in emitted]
            min_pos = min((pos_map.get(u, len(display_nodes)) for u in c_nodes), default=pos_map.get(c, len(display_nodes)))
            return (min_pos, pos_map.get(c, len(display_nodes)))

        direct_children.sort(key=_child_subtree_sort_key)
        for child in direct_children:
            if child in emitted:
                continue
            unemitted_prereqs = [p for p in reduced_prereqs.get(child, []) if p not in emitted]
            if unemitted_prereqs:
                children_items.append(_build_node(child, is_root=False))
            else:
                emitted.add(child)
                children_items.append(
                    {
                        "kind": "task",
                        "node": child,
                        "is_closing": False,
                    }
                )
        if target not in emitted and target in display_set:
            emitted.add(target)
            children_items.append(
                {
                    "kind": "task",
                    "node": target,
                    "is_closing": True,
                }
            )
        nd = nodes.get(target, {})
        if is_root:
            total_c, pct_c, done_c, open_c = _milestone_stats(target)
            subtree = _collect_subtree_nodes(target)
        else:
            subtree = set()
            for item in children_items:
                if item.get("kind") == "subchain":
                    subtree |= item["subtree_nodes"]  # type: ignore[arg-type]
                else:
                    subtree.add(item["node"])  # type: ignore[arg-type]
            open_c = sum(1 for u in subtree if not _is_done(u))
            done_c = len(_done_claims(subtree) - claimed_before)
            total_c = done_c + open_c
            pct_c = round(100 * done_c / total_c) if total_c > 0 else 0
        return {
            "kind": "chain" if is_root else "subchain",
            "milestone": target,
            "milestone_ref": str(nd.get("ref", target[1])),
            "milestone_title": str(nd.get("title", "")),
            "total_tasks": total_c,
            "progress_pct": pct_c,
            "done_count": done_c,
            "open_count": open_c,
            "subtree_nodes": subtree,
            "children": children_items,
        }

    if root in display_set:
        tree = _build_node(root, is_root=True)
        remaining = [u for u in display_nodes if u not in emitted]
        if remaining:
            extra_children: list[dict[str, object]] = []
            for rem_u in remaining:
                if rem_u in emitted:
                    continue
                unemitted_p = [p for p in reduced_prereqs.get(rem_u, []) if p not in emitted]
                if unemitted_p:
                    extra_children.append(_build_node(rem_u, is_root=False))
                else:
                    emitted.add(rem_u)
                    extra_children.append(
                        {
                            "kind": "task",
                            "node": rem_u,
                            "is_closing": False,
                        }
                    )
            cur_children: list[dict[str, object]] = tree["children"]  # type: ignore[assignment]
            if cur_children and cur_children[-1].get("kind") == "task" and cur_children[-1].get("node") == root:
                tree["children"] = [*cur_children[:-1], *extra_children, cur_children[-1]]
            else:
                tree["children"] = [*cur_children, *extra_children]
        return tree

    # Fallback when root itself was filtered out (e.g. --role filter or --limit truncation)
    fallback_children: list[dict[str, object]] = []
    out_deg_in_disp: dict[tuple[Path, str], int] = {u: 0 for u in display_nodes}
    for u in display_nodes:
        for p in reduced_prereqs.get(u, []):
            if p in out_deg_in_disp:
                out_deg_in_disp[p] += 1
    sinks = [u for u in display_nodes if out_deg_in_disp.get(u, 0) == 0]
    for s in sinks:
        if s in emitted:
            continue
        unemitted_p = [p for p in reduced_prereqs.get(s, []) if p not in emitted]
        if unemitted_p and len(sinks) > 1:
            fallback_children.append(_build_node(s, is_root=False))
        elif unemitted_p and len(sinks) == 1:
            sub = _build_node(s, is_root=True)
            fallback_children.extend(sub["children"])  # type: ignore[arg-type]
        else:
            emitted.add(s)
            fallback_children.append(
                {
                    "kind": "task",
                    "node": s,
                    "is_closing": (s == display_nodes[-1]),
                }
            )
    for rem_u in display_nodes:
        if rem_u not in emitted:
            emitted.add(rem_u)
            fallback_children.append(
                {
                    "kind": "task",
                    "node": rem_u,
                    "is_closing": (rem_u == root),
                }
            )
    total_c, pct_c, done_c, open_c = _milestone_stats(root)
    nd = nodes.get(root, {})
    return {
        "kind": "chain",
        "milestone": root,
        "milestone_ref": str(nd.get("ref", root[1])),
        "milestone_title": str(nd.get("title", "")),
        "total_tasks": total_c,
        "progress_pct": pct_c,
        "done_count": done_c,
        "open_count": open_c,
        "subtree_nodes": set(display_nodes),
        "children": fallback_children,
    }


def flatten_chain_tree_ordered_nodes(tree: dict[str, object]) -> list[tuple[Path, str]]:
    ordered: list[tuple[Path, str]] = []
    for child in tree.get("children", []):  # type: ignore[union-attr]
        if not isinstance(child, dict):
            continue
        if child.get("kind") == "subchain":
            ordered.extend(flatten_chain_tree_ordered_nodes(child))
        elif child.get("kind") == "task":
            u = child.get("node")
            if isinstance(u, tuple):
                ordered.append(u)
    return ordered


def plan_execution_chains(
    dag: dict[str, object],
    include_hold: bool = False,
    ready_only: bool = False,
    limit: int | None = None,
    include_done: bool = False,
) -> dict[str, object]:
    nodes: dict[tuple[Path, str], dict[str, object]] = dag["nodes"]  # type: ignore[assignment]
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["prereqs"]  # type: ignore[assignment]
    dependents: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["dependents"]  # type: ignore[assignment]
    done_prereqs: dict[tuple[Path, str], list[str]] = dag.get("done_prereqs", {})  # type: ignore[assignment]
    direct_done_deps: dict[tuple[Path, str], list[tuple[Path, str]]] = dag.get("direct_done_deps", {})  # type: ignore[assignment]
    done_graph_prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag.get("done_graph_prereqs", {})  # type: ignore[assignment]
    done_nodes: dict[tuple[Path, str], set[tuple[Path, str]]] = dag.get("done_nodes", {})  # type: ignore[assignment]
    done_topo_order: list[tuple[Path, str]] = dag.get("done_topo_order", [])  # type: ignore[assignment]
    order_idx: dict[tuple[Path, str], int] = dag.get("order_idx", {})  # type: ignore[assignment]
    show_done = include_done or bool(dag.get("include_done", False))
    prep = _prepare_active_plan(dag, include_hold=include_hold)
    active_list: list[tuple[Path, str]] = prep["active_list"]  # type: ignore[assignment]
    active_set: set[tuple[Path, str]] = prep["active_set"]  # type: ignore[assignment]
    ranked_active: list[tuple[Path, str]] = prep["ranked_active"]  # type: ignore[assignment]
    active_unblocks: dict[tuple[Path, str], int] = prep["active_unblocks"]  # type: ignore[assignment]
    excluded_hold: set[tuple[Path, str]] = prep["excluded_hold"]  # type: ignore[assignment]
    finale_set: set[tuple[Path, str]] = prep["finale_set"]  # type: ignore[assignment]
    chain_counts: dict[tuple[Path, str], int] = prep["chain_counts"]  # type: ignore[assignment]
    done_counts: dict[tuple[Path, str], int] = prep["done_counts"]  # type: ignore[assignment]
    is_momentum_next: dict[tuple[Path, str], int] = prep["is_momentum_next"]  # type: ignore[assignment]
    ready_unblocks: dict[tuple[Path, str], int] = prep["ready_unblocks"]  # type: ignore[assignment]
    immediate_ready_targets: dict[tuple[Path, str], list[tuple[Path, str]]] = prep["immediate_ready_targets"]  # type: ignore[assignment]
    _node_rank = prep["node_rank"]  # type: ignore[assignment]
    best_chain_rank: dict[tuple[Path, str], int] = prep["best_chain_rank"]  # type: ignore[assignment]

    latest_done_task: tuple[Path, str] | None = dag.get("latest_done_task")  # type: ignore[assignment]
    if latest_done_task is None and "latest_done_task" not in dag:
        proj_dirs: list[Path] = []
        seen_pdirs: set[Path] = set()
        for p_dir, _ in active_list:
            p_res = p_dir.resolve()
            if p_res not in seen_pdirs:
                seen_pdirs.add(p_res)
                proj_dirs.append(p_res)
        top_cands: list[tuple[int, int, tuple[Path, str]]] = []
        for s_idx, p_res in enumerate(proj_dirs):
            arch_path = p_res / "TODO_ARCHIVE.md"
            if not arch_path.is_file():
                continue
            try:
                mtime_ns = arch_path.stat().st_mtime_ns
            except OSError:
                mtime_ns = 0
            for t in parse_tasks_in_text(read_if_exists(arch_path), "TODO_ARCHIVE.md"):
                if str(t["status"]) == "DONE":
                    top_cands.append((mtime_ns, -s_idx, (p_res, str(t["id"]).upper())))
                    break
        if top_cands:
            latest_done_task = max(top_cands)[2]

    act_prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = {
        u: [p for p in prereqs.get(u, []) if p in active_set]
        for u in active_list
    }
    act_dependents: dict[tuple[Path, str], list[tuple[Path, str]]] = {
        u: [v for v in dependents.get(u, []) if v in active_set]
        for u in active_list
    }

    rank_pos = {u: idx for idx, u in enumerate(ranked_active)}
    root_cones: list[tuple[tuple[Path, str], list[tuple[Path, str]]]] = []
    standalone: list[tuple[Path, str]] = []

    for u in ranked_active:
        out_deg = len(act_dependents.get(u, []))
        in_deg = len(act_prereqs.get(u, []))
        has_done = bool(done_nodes.get(u) or done_prereqs.get(u))
        if out_deg > 0:
            continue
        if in_deg > 0 or has_done:
            cone_set: set[tuple[Path, str]] = {u}
            stack = [u]
            while stack:
                cur = stack.pop()
                for p in act_prereqs.get(cur, []):
                    if p not in cone_set:
                        cone_set.add(p)
                        stack.append(p)
            comp_open = sorted(
                cone_set,
                key=lambda k: (rank_pos[k], _canonical_task_ref_key(nodes, k)),
            )
            root_cones.append((u, comp_open))
        else:
            standalone.append(u)

    def _standalone_sort_key(
        u: tuple[Path, str],
    ) -> tuple[int, int, int, int, tuple[str, str, str]]:
        return (
            0 if _is_bug_task_node(nodes, u) else 1,
            _resolve_node_role_ease(nodes, u),
            ACTIVE_STATUS_ORDER.get(str(nodes[u]["status"]), 99),
            order_idx.get(u, 0),
            _canonical_task_ref_key(nodes, u),
        )

    done_topo_pos = {d: idx for idx, d in enumerate(done_topo_order)}

    def _build_chain_entry(
        root: tuple[Path, str],
        comp_open: list[tuple[Path, str]],
    ) -> dict[str, object]:
        comp_done: set[tuple[Path, str]] = set()
        for u in comp_open:
            comp_done |= done_nodes.get(u, set())
        open_count = len(comp_open)
        done_count = len(comp_done)
        total_tasks = done_count + open_count
        progress_pct = round(100 * done_count / total_tasks) if total_tasks > 0 else 0

        if show_done and comp_done:
            ordered_done = sorted(
                comp_done,
                key=lambda d: (done_topo_pos.get(d, len(done_topo_pos)), _canonical_task_ref_key(nodes, d)),
            )
            base_display_nodes = [*ordered_done, *comp_open]
        else:
            base_display_nodes = list(comp_open)
        chain_tree = build_chain_milestone_tree(
            root=root,
            display_nodes=base_display_nodes,
            nodes=nodes,
            prereqs=prereqs,
            done_nodes=done_nodes,
            direct_done_deps=direct_done_deps,
            done_graph_prereqs=done_graph_prereqs,
            include_done=show_done,
        )
        display_nodes = flatten_chain_tree_ordered_nodes(chain_tree) or base_display_nodes

        ready_in_comp = [
            u
            for u in comp_open
            if _is_ready_in_dag(nodes, prereqs, u, include_hold=include_hold)
        ]
        ready_set = set(ready_in_comp)
        ready_bugs = sum(1 for u in ready_in_comp if _is_bug_task_node(nodes, u))
        open_bugs = sum(1 for u in comp_open if _is_bug_task_node(nodes, u))
        done_bugs = sum(1 for d in comp_done if _is_bug_node_key(d))
        total_bugs = open_bugs + done_bugs

        dist: dict[tuple[Path, str], int] = {}
        for u in comp_open:
            if u in ready_set:
                dist[u] = 0
            else:
                parent_dists = [dist[p] for p in prereqs.get(u, []) if p in dist]
                dist[u] = (min(parent_dists) + 1) if parent_dists else 0
        open_bug_dists = [dist[u] for u in comp_open if _is_bug_task_node(nodes, u)]
        if open_bug_dists:
            min_bug_dist: int | None = min(open_bug_dists)
        elif done_bugs > 0:
            min_bug_dist = 0
        else:
            min_bug_dist = None
        bug_dist_rank = min_bug_dist if min_bug_dist is not None else 10**9

        open_eases = [_resolve_node_role_ease(nodes, u) for u in comp_open]
        ready_eases = [_resolve_node_role_ease(nodes, u) for u in ready_in_comp] or open_eases
        rem_eases = [_resolve_node_role_ease(nodes, u) for u in comp_open if u not in ready_set] or open_eases
        ready_role_ease = min(ready_eases) if ready_eases else len(ROLE_EASE_ORDER)
        min_rem_ease = min(rem_eases) if rem_eases else len(ROLE_EASE_ORDER)
        max_rem_ease = max(rem_eases) if rem_eases else len(ROLE_EASE_ORDER)
        max_open_ease = max(open_eases) if open_eases else len(ROLE_EASE_ORDER)
        role_ease_key = (ready_role_ease, min_rem_ease, max_rem_ease, max_open_ease)

        remaining_effort = sum(_resolve_node_role_weight(nodes, u) for u in comp_open)
        weighted_denom = done_count + remaining_effort
        weighted_velocity = (done_count / weighted_denom) if weighted_denom > 0 else 0.0

        raw_best_status = min(
            (ACTIVE_STATUS_ORDER.get(str(nodes[u]["status"]), 99) for u in comp_open),
            default=99,
        )
        has_wip = any(str(nodes[u]["status"]) == "WIP" for u in comp_open)
        is_active_quest = has_wip or (
            latest_done_task is not None and latest_done_task in comp_done
        )
        if is_active_quest:
            best_status = ACTIVE_STATUS_ORDER["WIP"]
        elif done_count > 0:
            best_status = min(raw_best_status, ACTIVE_STATUS_ORDER["NEXT"])
        else:
            best_status = raw_best_status

        canon_ref = _canonical_task_ref_key(nodes, root)
        root_nd = nodes[root]
        root_ref = str(root_nd["ref"])
        root_title = str(root_nd["title"])

        is_work_finale = root in finale_set and len(comp_open) == 1
        finale_tier = 0 if is_work_finale else 1
        finale_order_key: tuple[int, int, int, int, tuple[str, str, str]] = (
            (
                0 if _is_bug_task_node(nodes, root) else 1,
                ACTIVE_STATUS_ORDER.get(str(root_nd["status"]), 99),
                -done_count,
                order_idx.get(root, 0),
                canon_ref,
            )
            if is_work_finale
            else (0, 0, 0, 0, ("", "", ""))
        )
        rank_key = (
            finale_tier,
            finale_order_key,
            -(ready_bugs + done_bugs),
            -total_bugs,
            bug_dist_rank,
            role_ease_key,
            best_status,
            -weighted_velocity,
            -total_tasks,
            -done_count,
            remaining_effort,
            canon_ref,
        )
        return {
            "root": root,
            "root_ref": root_ref,
            "root_title": root_title,
            "also_in": {},
            "tree": chain_tree,
            "is_active_quest": is_active_quest,
            "nodes": display_nodes,
            "open_nodes": comp_open,
            "done_nodes": comp_done,
            "open_count": open_count,
            "done_count": done_count,
            "total_tasks": total_tasks,
            "progress_pct": progress_pct,
            "remaining_effort": remaining_effort,
            "weighted_velocity": weighted_velocity,
            "ready_bugs": ready_bugs,
            "open_bugs": open_bugs,
            "done_bugs": done_bugs,
            "total_bugs": total_bugs,
            "min_bug_dist": min_bug_dist,
            "role_ease": role_ease_key,
            "best_status": best_status,
            "rank_key": rank_key,
        }

    chain_entries = [_build_chain_entry(root, comp_open) for root, comp_open in root_cones]
    chain_entries.sort(key=lambda entry: entry["rank_key"])  # type: ignore[arg-type, return-value]

    if ready_only:
        for rank_idx, chain_entry in enumerate(chain_entries):
            members: list[tuple[Path, str]] = chain_entry["open_nodes"]  # type: ignore[assignment]
            for member in members:
                best_chain_rank.setdefault(member, rank_idx)
        for member in active_list:
            best_chain_rank.setdefault(member, len(chain_entries))
        ready_nodes = [
            u
            for u in ranked_active
            if _is_ready_in_dag(nodes, prereqs, u, include_hold=include_hold)
        ]
        ready_nodes.sort(key=_node_rank)
        if limit is not None:
            ready_nodes = ready_nodes[:limit]
        return {
            "active_nodes": ranked_active,
            "active_unblocks": active_unblocks,
            "excluded_hold": excluded_hold,
            "finale_set": finale_set,
            "chain_counts": chain_counts,
            "done_counts": done_counts,
            "is_momentum_next": is_momentum_next,
            "ready_unblocks": ready_unblocks,
            "immediate_ready_targets": immediate_ready_targets,
            "chains": [],
            "chain_stats": [],
            "standalone": [],
            "ready_tasks": ready_nodes,
        }

    node_chain_refs: dict[tuple[Path, str], list[str]] = {}
    for entry in chain_entries:
        r_ref = str(entry["root_ref"])
        cone_members = set(entry["open_nodes"]) | set(entry["done_nodes"])  # type: ignore[arg-type]
        for u in cone_members:
            refs_for_u = node_chain_refs.setdefault(u, [])
            if r_ref not in refs_for_u:
                refs_for_u.append(r_ref)

    for entry in chain_entries:
        r_ref = str(entry["root_ref"])
        cone_members = set(entry["open_nodes"]) | set(entry["done_nodes"])  # type: ignore[arg-type]
        also_in_map: dict[tuple[Path, str], list[str]] = {}
        for u in cone_members:
            others = [ref for ref in node_chain_refs.get(u, []) if ref != r_ref]
            if others:
                also_in_map[u] = others
        entry["also_in"] = also_in_map

    chains: list[list[tuple[Path, str]]] = [entry["nodes"] for entry in chain_entries]  # type: ignore[misc]
    standalone.sort(key=_standalone_sort_key)
    if show_done:
        in_any_chain: set[tuple[Path, str]] = set()
        for entry in chain_entries:
            in_any_chain |= set(entry["open_nodes"]) | set(entry["done_nodes"])  # type: ignore[arg-type]
        already_placed = set(standalone) | in_any_chain | excluded_hold
        for arch_key in dag.get("archived_tasks", []):  # type: ignore[union-attr]
            if arch_key not in already_placed:
                already_placed.add(arch_key)
                standalone.append(arch_key)

    if limit is not None:
        rem = limit
        limited_chains: list[list[tuple[Path, str]]] = []
        limited_stats: list[dict[str, object]] = []
        for comp, entry in zip(chains, chain_entries):
            if rem <= 0:
                break
            take = comp[:rem]
            limited_chains.append(take)
            limited_stats.append({**entry, "nodes": take})
            rem -= len(take)
        limited_standalone = standalone[:rem] if rem > 0 else []
        chains = limited_chains
        chain_entries = limited_stats
        standalone = limited_standalone

    return {
        "active_nodes": ranked_active,
        "active_unblocks": active_unblocks,
        "excluded_hold": excluded_hold,
        "finale_set": finale_set,
        "chain_counts": chain_counts,
        "done_counts": done_counts,
        "is_momentum_next": is_momentum_next,
        "ready_unblocks": ready_unblocks,
        "immediate_ready_targets": immediate_ready_targets,
        "chains": chains,
        "chain_stats": chain_entries,
        "standalone": standalone,
        "ready_tasks": [],
    }

def plan_execution_chains_by_role(
    dag: dict[str, object],
    include_hold: bool = False,
    ready_only: bool = False,
    limit: int | None = None,
    role: str | None = None,
) -> dict[str, object]:
    nodes: dict[tuple[Path, str], dict[str, object]] = dag["nodes"]  # type: ignore[assignment]
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["prereqs"]  # type: ignore[assignment]
    prep = _prepare_active_plan(dag, include_hold=include_hold)
    ranked_active: list[tuple[Path, str]] = prep["ranked_active"]  # type: ignore[assignment]
    active_unblocks: dict[tuple[Path, str], int] = prep["active_unblocks"]  # type: ignore[assignment]
    excluded_hold: set[tuple[Path, str]] = prep["excluded_hold"]  # type: ignore[assignment]
    finale_set: set[tuple[Path, str]] = prep["finale_set"]  # type: ignore[assignment]

    trans_cache: dict[tuple[Path, str], set[tuple[Path, str]]] = {}

    def _trans_prereqs(u: tuple[Path, str]) -> set[tuple[Path, str]]:
        if u not in trans_cache:
            seen: set[tuple[Path, str]] = set()
            stack = list(prereqs.get(u, []))
            while stack:
                cur = stack.pop()
                if cur == u or cur in seen:
                    continue
                seen.add(cur)
                for nxt in prereqs.get(cur, []):
                    if nxt != u and nxt not in seen:
                        stack.append(nxt)
            trans_cache[u] = seen
        return trans_cache[u]

    def _node_role(u: tuple[Path, str]) -> str | None:
        nd = nodes[u]
        if not nd.get("exists"):
            return None
        resolved = resolve_task_role(
            str(nd["id"]),
            str(nd["section"]),
            status=str(nd.get("status", "")),
        )
        return resolved.strip().lower() if resolved else None

    q_work: list[tuple[Path, str]] = []
    q_plan: list[tuple[Path, str]] = []
    q_design: list[tuple[Path, str]] = []
    q_deferred_work: list[tuple[Path, str]] = []
    q_other: list[tuple[Path, str]] = []

    wanted_role = role.strip().lower() if role is not None else None

    for u in ranked_active:
        if ready_only and not _is_ready_in_dag(nodes, prereqs, u, include_hold=include_hold):
            continue
        u_role = _node_role(u)
        if wanted_role is not None and u_role != wanted_role:
            continue
        dep_roles = {_node_role(p) for p in _trans_prereqs(u)}
        if u_role == "work":
            if not dep_roles or dep_roles <= {"work"}:
                q_work.append(u)
            elif not ready_only:
                q_deferred_work.append(u)
        elif u_role == "plan":
            if not dep_roles or dep_roles <= {"work", "plan"}:
                q_plan.append(u)
            else:
                q_other.append(u)
        elif u_role == "design":
            q_design.append(u)
        else:
            q_other.append(u)

    queues: list[tuple[str, str, list[tuple[Path, str]]]] = [
        ("work", "Queue 1 (work)", q_work),
        ("plan", "Queue 2 (plan)", q_plan),
        ("design", "Queue 3 (design)", q_design),
    ]
    if not ready_only:
        queues.append(("deferred_work", "Queue 4 (deferred work)", q_deferred_work))
    if q_other:
        queues.append(("other", "Other tasks", q_other))

    if limit is not None:
        rem = limit
        limited_queues: list[tuple[str, str, list[tuple[Path, str]]]] = []
        for q_key, q_label, q_items in queues:
            if rem <= 0:
                limited_queues.append((q_key, q_label, []))
                continue
            take = q_items[:rem]
            limited_queues.append((q_key, q_label, take))
            rem -= len(take)
        queues = limited_queues

    return {
        "active_nodes": ranked_active,
        "active_unblocks": active_unblocks,
        "excluded_hold": excluded_hold,
        "finale_set": finale_set,
        "chain_counts": prep["chain_counts"],
        "done_counts": prep["done_counts"],
        "is_momentum_next": prep["is_momentum_next"],
        "ready_unblocks": prep["ready_unblocks"],
        "immediate_ready_targets": prep["immediate_ready_targets"],
        "queues": queues,
    }


def find_newly_unblocked_tasks(
    completed_dir: Path,
    completed_id: str,
) -> list[str]:
    comp_res = completed_dir.resolve()
    comp_tid = completed_id.strip().upper()
    ws_root = resolve_workspace_root(comp_res)
    ws_res = ws_root.resolve()

    candidate_dirs: list[Path] = []
    seen_dirs: set[Path] = set()

    def _add_project(p: Path) -> None:
        p_res = p.resolve()
        if p_res not in seen_dirs and is_todo_project(p_res):
            seen_dirs.add(p_res)
            candidate_dirs.append(p_res)

    _add_project(comp_res)
    _add_project(ws_res)
    for _, proj_dir in discover_projects(ws_res):
        _add_project(proj_dir)

    probe_roots: list[Path] = [comp_res]
    for anc in comp_res.parents:
        probe_roots.append(anc)
        if anc == ws_res:
            break
    if ws_res not in probe_roots:
        probe_roots.append(ws_res)

    for root in probe_roots:
        tp = root / ".todo_projects"
        if tp.is_dir():
            _add_project(tp)
            for _, proj_dir in discover_projects(tp):
                _add_project(proj_dir)
        elif tp.is_file():
            for raw_line in read_if_exists(tp).splitlines():
                entry = raw_line.strip()
                if not entry or entry.startswith("#"):
                    continue
                p_cand = Path(entry).expanduser()
                if not p_cand.is_absolute():
                    p_cand = root / p_cand
                _add_project(p_cand)

    def _format_unblocked_ref(proj_dir: Path, tid: str) -> str:
        if proj_dir == comp_res:
            return tid
        return f"{project_label(proj_dir, ws_res)}:{tid}"

    unblocked: list[str] = []
    seen_refs: set[str] = set()
    for proj_dir in candidate_dirs:
        todo_path = proj_dir / "TODO.md"
        if not todo_path.is_file():
            continue
        proj_ws = resolve_workspace_root(proj_dir).resolve()
        for t in parse_tasks_in_text(read_if_exists(todo_path), "TODO.md"):
            tid = str(t["id"]).upper()
            if proj_dir == comp_res and tid == comp_tid:
                continue
            sec = str(t["section"])
            _, syntax_errs = parse_dependency_clauses(sec)
            if syntax_errs:
                continue
            deps = parse_task_dependencies(sec)
            if not deps:
                continue
            references_completed = False
            for ref in deps:
                pm = PROJECT_TASK_RE.match(ref)
                if pm:
                    p_name = pm.group(1).strip().replace("\\", "/").strip("/")
                    dep_tid = pm.group(2).upper()
                    cand_targets = {(proj_ws / p_name).resolve(), (ws_res / p_name).resolve()}
                    if proj_ws.name == ".todo_projects":
                        cand_targets.add((proj_ws.parent / p_name).resolve())
                    if comp_res not in cand_targets:
                        ext_target = lookup_external_alias(proj_dir, ws_res, p_name)
                        if ext_target is not None:
                            cand_targets.add(ext_target)
                    if comp_res in cand_targets and dep_tid == comp_tid:
                        references_completed = True
                        break
                else:
                    if proj_dir == comp_res and ref.upper() == comp_tid:
                        references_completed = True
                        break
            if not references_completed:
                continue
            resolved = resolve_dependency_statuses(proj_dir, deps)
            if resolved and all(st == "DONE" for _, st, _ in resolved):
                label = _format_unblocked_ref(proj_dir, tid)
                if label not in seen_refs:
                    seen_refs.add(label)
                    unblocked.append(label)
    return unblocked


def cmd_check(base_dir: Path) -> int:
    if not (base_dir / "TODO.md").is_file():
        sys.stderr.write(f"{prog_name()}: no TODO.md found in {base_dir} (run '{prog_name()} init' to create one)\n")
        return 1
    errors, count = validate_all(base_dir)
    if errors:
        for e in errors:
            sys.stderr.write(f"ERROR: {e}\n")
        return 1
    sys.stdout.write(f"{prog_name()}: OK ({count} task(s) verified across TODO*.md)\n")
    return 0


def _default_todo_header(base_dir: Path) -> str:
    return ""


def _default_archive_header(base_dir: Path) -> str:
    return ""


def _commit_enabled(commit: bool, no_commit: bool) -> bool:
    env_commit = os.environ.get("TODO_MD_COMMIT", "").strip().lower() in ("1", "true", "yes")
    env_no_commit = os.environ.get("TODO_MD_NO_COMMIT", "").strip().lower() in ("1", "true", "yes")
    return (commit or env_commit) and not no_commit and not env_no_commit


def _git_run(base_dir: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(base_dir), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )


def _sync_upstream(base_dir: Path, commit: bool = False, no_commit: bool = False) -> None:
    if os.environ.get("TODO_MD_NO_GIT_PULL", "").strip().lower() in ("1", "true", "yes"):
        return
    try:
        r_wt = _git_run(base_dir, "rev-parse", "--is-inside-work-tree")
    except OSError:
        return
    if r_wt.returncode != 0 or r_wt.stdout.strip() != "true":
        return
    if _git_run(base_dir, "rev-parse", "--abbrev-ref", "@{u}").returncode != 0:
        return
    if not _commit_enabled(commit, no_commit):
        r_st = _git_run(base_dir, "status", "--porcelain", "--untracked-files=no")
        if r_st.returncode != 0:
            return
        if any(Path(line[3:].strip()).name not in TASK_FILES for line in r_st.stdout.splitlines()):
            return
    r_pull = _git_run(base_dir, "pull", "--ff-only", "--quiet")
    if r_pull.returncode != 0:
        detail = (r_pull.stderr or r_pull.stdout).strip()
        msg = (
            f"{prog_name()}: git pull --ff-only failed in {base_dir}; "
            "resolve the upstream state first (TODO_MD_NO_GIT_PULL=1 skips the sync)"
        )
        if detail:
            msg += f"\n{detail}"
        raise SystemExit(msg)


def _git_commit_todo(base_dir: Path, commit_msg: str) -> None:
    try:
        r_wt = subprocess.run(
            ["git", "-C", str(base_dir), "rev-parse", "--is-inside-work-tree"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )
    except OSError:
        return
    if r_wt.returncode != 0 or r_wt.stdout.strip() != "true":
        return
    existing = [f for f in TASK_FILES if (base_dir / f).is_file()]
    if not existing:
        return
    r_add = subprocess.run(
        ["git", "-C", str(base_dir), "add", "--", *existing],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if r_add.returncode != 0:
        return
    r_st = subprocess.run(
        ["git", "-C", str(base_dir), "status", "--porcelain", "--", *existing],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    if r_st.returncode != 0 or not r_st.stdout.strip():
        return
    st_lines = r_st.stdout.splitlines()
    changed = [f for f in existing if any(line.endswith(f) for line in st_lines)] or existing
    r_cm = subprocess.run(
        ["git", "-C", str(base_dir), "commit", "--only", "-m", commit_msg, "--", *existing],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if r_cm.returncode != 0:
        return
    r_sha = subprocess.run(
        ["git", "-C", str(base_dir), "rev-parse", "--short", "HEAD"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    sha = f" ({r_sha.stdout.strip()})" if r_sha.returncode == 0 and r_sha.stdout.strip() else ""
    sys.stdout.write(f"{prog_name()}: committed {', '.join(changed)}{sha}: {commit_msg}\n")


def _sort_todo_file(todo_path: Path, promote_id: str | None = None) -> None:
    if not todo_path.is_file():
        return
    raw = todo_path.read_text(encoding="utf-8")
    if not raw.strip():
        return
    tasks = parse_tasks_in_text(raw, "TODO.md")
    if not tasks:
        return
    ordered = _order_active_tasks(
        tasks,
        base_dir=todo_path.parent,
        promote_id=promote_id,
        ready_statuses=frozenset({"WIP", "NEXT"}),
    )
    sections = [str(t["section"]).rstrip() for t in ordered]
    new_text = "\n\n".join(sections) + "\n"
    if new_text != raw:
        todo_path.write_text(new_text, encoding="utf-8")


def _finalize_mutation(
    base_dir: Path,
    commit_msg: str,
    commit: bool = False,
    no_commit: bool = False,
    promote_id: str | None = None,
) -> int:
    _sort_todo_file(base_dir / "TODO.md", promote_id=promote_id)
    errors, _ = validate_all(base_dir)
    if errors:
        for e in errors:
            sys.stderr.write(f"ERROR: {e}\n")
        return 1
    if _commit_enabled(commit, no_commit):
        _git_commit_todo(base_dir, commit_msg)
    return 0


def cmd_init(
    base_dir: Path,
    argv: list[str] | None = None,
    force: bool = False,
    commit: bool = False,
    no_commit: bool = False,
) -> int:
    prog = prog_name()
    pos: list[str] = []
    for a in argv or []:
        if a == "--force":
            force = True
        elif a in ("--commit", "-c"):
            commit = True
        elif a == "--no-commit":
            no_commit = True
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option for init: {a}")
        else:
            pos.append(a)
    _sync_upstream(base_dir, commit, no_commit)
    idea_text = " ".join(pos).strip() if pos else (_read_stdin_if_piped() or "").strip()
    todo_content = ""
    if idea_text:
        todo_content = f"# 🎯 [NEXT] F1: Project concept and initial design\n\n{idea_text}\n"
    templates = {
        "TODO.md": todo_content,
        "TODO_ARCHIVE.md": "",
    }
    created: list[str] = []
    for fname, content in templates.items():
        p = base_dir / fname
        if p.exists() and not force:
            continue
        p.write_text(content, encoding="utf-8")
        created.append(fname)
    if not created:
        sys.stdout.write(f"{prog}: TODO*.md files already exist in {base_dir} (use --force to overwrite)\n")
        return 0
    sys.stdout.write(f"{prog}: initialized {', '.join(created)} in {base_dir}\n")
    return _finalize_mutation(base_dir, f"Initialize {' and '.join(created)}", commit=commit, no_commit=no_commit)


def _extract_and_remove_task(text: str, target_id: str) -> tuple[dict[str, object] | None, str]:
    lines = text.splitlines()
    in_fence = False
    start_idx: int | None = None
    end_idx: int | None = None
    found_info: dict[str, object] | None = None
    for idx, line in enumerate(lines):
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
        if not in_fence and line.startswith("# "):
            if start_idx is not None:
                end_idx = idx
                break
            m = HEADING_RE.match(line)
            if m and m.group(3).upper() == target_id:
                emoji, status, tid, title = m.groups()
                start_idx = idx
                found_info = {"id": tid, "status": status, "emoji": emoji, "title": title}
    if start_idx is None or found_info is None:
        return None, text
    if end_idx is None:
        end_idx = len(lines)
    section_lines = lines[start_idx:end_idx]
    while section_lines and not section_lines[-1].strip():
        section_lines.pop()
    found_info["lines"] = section_lines
    remaining = lines[:start_idx] + lines[end_idx:]
    new_text = re.sub(r"\n{3,}", "\n\n", "\n".join(remaining).rstrip()) + "\n"
    return found_info, new_text


def _format_heading(status: str, tid: str, title: str, note: str | None = None) -> str:
    emoji = VALID_STATUSES[status]
    base_title, existing_note = _strip_heading_note(title)
    final_note = note.strip() if note is not None else existing_note
    if final_note:
        return f"# {emoji} [{status}] {tid}: {base_title} — *{final_note}*"
    return f"# {emoji} [{status}] {tid}: {base_title}"


def _insert_task_section(file_path: Path, section_lines: list[str], default_header: str = "", prepend: bool = False) -> None:
    if not file_path.is_file() or not file_path.read_text(encoding="utf-8").strip():
        file_path.write_text("\n".join(section_lines) + "\n", encoding="utf-8")
        return
    existing = file_path.read_text(encoding="utf-8")
    if not prepend:
        file_path.write_text(existing.rstrip() + "\n\n" + "\n".join(section_lines) + "\n", encoding="utf-8")
        return
    if file_path.name == "TODO_ARCHIVE.md":
        updated = section_lines + [""] + existing.splitlines()
        new_text = re.sub(r"\n{3,}", "\n\n", "\n".join(updated).rstrip()) + "\n"
        file_path.write_text(new_text, encoding="utf-8")
        return
    lines = existing.splitlines()
    in_fence = False
    insert_idx: int | None = None
    for idx, line in enumerate(lines):
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
        if not in_fence and line.startswith("# "):
            m = HEADING_RE.match(line)
            if m and m.group(2) == "WIP":
                continue
            insert_idx = idx
            break
    if insert_idx is None:
        file_path.write_text(existing.rstrip() + "\n\n" + "\n".join(section_lines) + "\n", encoding="utf-8")
        return
    updated = lines[:insert_idx] + section_lines + [""] + lines[insert_idx:]
    new_text = re.sub(r"\n{3,}", "\n\n", "\n".join(updated).rstrip()) + "\n"
    file_path.write_text(new_text, encoding="utf-8")


def _parse_note_arg(rest: list[str]) -> tuple[list[str], str | None]:
    pos: list[str] = []
    note: str | None = None
    i = 0
    while i < len(rest):
        if rest[i] in ("-m", "--note", "--reason"):
            if i + 1 >= len(rest):
                raise SystemExit(f"{prog_name()}: {rest[i]} requires an argument")
            note = rest[i + 1]
            i += 2
        else:
            pos.append(rest[i])
            i += 1
    return pos, note


def cmd_archive_view(base_dir: Path) -> int:
    arch_path = base_dir / "TODO_ARCHIVE.md"
    if not arch_path.is_file():
        sys.stderr.write(f"{prog_name()}: no TODO_ARCHIVE.md found in {base_dir}\n")
        return 1
    sys.stdout.write(read_if_exists(arch_path).rstrip() + "\n")
    return 0


def cmd_transition(
    base_dir: Path,
    task_id: str,
    new_status: str | None = None,
    dest_file: str | None = None,
    note: str | None = None,
    promote_top: bool = False,
    reopen: bool = False,
    require_archived: bool = False,
    commit: bool = False,
    no_commit: bool = False,
) -> int:
    target = task_id.strip().upper()
    if new_status and new_status not in VALID_STATUSES:
        raise SystemExit(f"{prog_name()}: invalid status {new_status!r}; expected one of {', '.join(VALID_STATUSES)}")
    _sync_upstream(base_dir, commit, no_commit)
    source_file: str | None = None
    found: dict[str, object] | None = None
    updated_source_text = ""
    for fname in TASK_FILES:
        p = base_dir / fname
        if not p.is_file():
            continue
        info, rem = _extract_and_remove_task(read_if_exists(p), target)
        if info is not None:
            source_file = fname
            found = info
            updated_source_text = rem
            break
    if found is None or source_file is None:
        sys.stderr.write(f"{prog_name()}: task {target!r} not found in TODO*.md under {base_dir}\n")
        return 1

    cur_status = str(found["status"])
    is_archived = source_file == "TODO_ARCHIVE.md" or cur_status in ("DONE", "CANCELED")
    final_status = new_status or cur_status
    base_title, existing_note = _strip_heading_note(str(found["title"]))

    if require_archived and not is_archived:
        sys.stderr.write(
            f"{prog_name()}: task {found['id']} is already active ([{cur_status}] in {source_file})\n"
        )
        return 1

    if is_archived:
        note_detail = f" (closing note: {existing_note})" if existing_note else ""
        if final_status in ("DONE", "CANCELED"):
            sys.stderr.write(
                f"{prog_name()}: task {found['id']} is already archived as [{cur_status}]{note_detail}; "
                f"use '{prog_name()} reopen {found['id']}' or pass --reopen with status/next to reopen it\n"
            )
            return 1
        if not reopen:
            sys.stderr.write(
                f"{prog_name()}: task {found['id']} is archived as [{cur_status}]{note_detail}; "
                f"pass --reopen or run '{prog_name()} reopen {found['id']}' to move it back to TODO.md\n"
            )
            return 1

    if dest_file is None:
        if final_status in ("DONE", "CANCELED"):
            dest_file = "TODO_ARCHIVE.md"
        else:
            dest_file = "TODO.md"

    today_iso = date.today().isoformat()
    effective_note = note
    if is_archived and reopen:
        if effective_note is None:
            effective_note = ""
    elif final_status == "DONE":
        if effective_note and today_iso not in effective_note:
            effective_note = f"{today_iso}, {effective_note}"
        elif effective_note is None:
            if not existing_note:
                effective_note = today_iso

    tid = str(found["id"])
    sec_lines = list(found["lines"])  # type: ignore[arg-type]
    sec_lines[0] = _format_heading(final_status, tid, str(found["title"]), note=effective_note)
    stripped_plan_role = False
    if final_status == "NEXT":
        sec_lines, stripped_plan_role = _strip_plan_role_from_section_lines(sec_lines)

    if require_archived or (is_archived and reopen):
        commit_msg = f"Reopen task {tid} as {final_status}: {base_title}"
    elif final_status == "DONE":
        commit_msg = f"Complete task {tid}: {base_title}"
    elif final_status == "CANCELED":
        commit_msg = f"Cancel task {tid}: {base_title}"
    elif promote_top and final_status == "NEXT":
        commit_msg = f"Promote task {tid} to NEXT: {base_title}"
    else:
        commit_msg = f"Mark task {tid} as {final_status}: {base_title}"

    if dest_file == source_file and not promote_top:
        src_path = base_dir / source_file
        orig_lines = read_if_exists(src_path).splitlines()
        in_fence = False
        start_idx: int | None = None
        end_idx: int | None = None
        for idx, line in enumerate(orig_lines):
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
            if not in_fence and line.startswith("# "):
                if start_idx is not None:
                    end_idx = idx
                    break
                m = HEADING_RE.match(line)
                if m and m.group(3).upper() == target:
                    start_idx = idx
                    if not stripped_plan_role:
                        orig_lines[idx] = sec_lines[0]
                        break
        if stripped_plan_role and start_idx is not None:
            if end_idx is None:
                end_idx = len(orig_lines)
            orig_lines = orig_lines[:start_idx] + [*sec_lines, ""] + orig_lines[end_idx:]
            new_src_text = re.sub(r"\n{3,}", "\n\n", "\n".join(orig_lines).rstrip()) + "\n"
            src_path.write_text(new_src_text, encoding="utf-8")
        else:
            src_path.write_text("\n".join(orig_lines) + "\n", encoding="utf-8")
        sys.stdout.write(f"{prog_name()}: updated {target} -> [{final_status}] in {source_file}\n")
        return _finalize_mutation(base_dir, commit_msg, commit=commit, no_commit=no_commit)

    (base_dir / source_file).write_text(updated_source_text, encoding="utf-8")
    default_hdrs = {
        "TODO.md": _default_todo_header(base_dir),
        "TODO_ARCHIVE.md": _default_archive_header(base_dir),
    }
    _insert_task_section(
        base_dir / dest_file,
        sec_lines,
        default_hdrs[dest_file],
        prepend=(dest_file == "TODO_ARCHIVE.md" or (promote_top and dest_file == "TODO.md")),
    )
    if dest_file == source_file:
        sys.stdout.write(f"{prog_name()}: promoted {target} ([{final_status}]) to top of {dest_file}\n")
    else:
        sys.stdout.write(f"{prog_name()}: moved {target} ([{final_status}]) from {source_file} -> {dest_file}\n")
    rc = _finalize_mutation(
        base_dir,
        commit_msg,
        commit=commit,
        no_commit=no_commit,
        promote_id=(target if promote_top and dest_file == "TODO.md" else None),
    )
    if rc == 0 and final_status == "DONE":
        unblocked = find_newly_unblocked_tasks(base_dir, tid)
        if unblocked:
            sys.stdout.write(f"Unblocked: {', '.join(unblocked)}\n")
    return rc


def cmd_reopen(
    base_dir: Path,
    argv: list[str],
    commit: bool = False,
    no_commit: bool = False,
    explicit_dir: str | None = None,
) -> int:
    prog = prog_name()
    target_status = "NEW"
    note: str | None = None
    pos: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--commit", "-c"):
            commit = True
            i += 1
        elif a == "--no-commit":
            no_commit = True
            i += 1
        elif a in ("--status", "-s"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            target_status = argv[i + 1].upper()
            i += 2
        elif a.startswith("--status="):
            target_status = a.split("=", 1)[1].upper()
            i += 1
        elif a in ("-m", "--note", "--reason"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            note = argv[i + 1]
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option for reopen: {a}")
        else:
            pos.append(a)
            i += 1

    if len(pos) != 1:
        raise SystemExit(f"{prog}: usage: {prog} reopen <ID> [--status STATUS] [-m NOTE]")
    if target_status not in ACTIVE_STATUS_ORDER:
        raise SystemExit(
            f"{prog}: reopen --status must be an active status ({', '.join(ACTIVE_STATUS_ORDER)}), got {target_status!r}"
        )
    tdir, tid = resolve_project_task_ref(base_dir, pos[0], explicit_dir=explicit_dir)
    return cmd_transition(
        tdir,
        tid,
        new_status=target_status,
        dest_file="TODO.md",
        note=note,
        promote_top=(target_status in ("WIP", "NEXT")),
        reopen=True,
        require_archived=True,
        commit=commit,
        no_commit=no_commit,
    )


def _resolve_body_arg(body: str | None) -> str | None:
    if body == "-":
        if sys.stdin.isatty():
            raise SystemExit(f"{prog_name()}: -b - / --body - requires non-TTY stdin")
        return sys.stdin.read()
    if body is None:
        return _read_stdin_if_piped()
    return body


def _normalize_depends_clauses(raw_items: list[str]) -> list[str]:
    clauses: list[str] = []
    for item in raw_items:
        if not item.strip():
            continue
        stages, err = parse_depends_clause(item)
        if err:
            raise SystemExit(
                f"{prog_name()}: invalid --depends value {item!r}: {err}; expected <ID> or <project>:<ID> separated by ',' and '->'"
            )
        clauses.append(" -> ".join(", ".join(stage) for stage in stages))
    return clauses


def _strip_plan_role_from_section_lines(sec_lines: list[str]) -> tuple[list[str], bool]:
    if not sec_lines:
        return sec_lines, False
    heading = sec_lines[0]
    body_lines: list[str] = []
    in_fence = False
    removed = False
    for line in sec_lines[1:]:
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
        if not in_fence:
            m = ROLE_LINE_RE.match(line)
            if m and m.group(1).strip().lower() == "plan":
                removed = True
                continue
        body_lines.append(line)
    if not removed:
        return sec_lines, False
    while body_lines and not body_lines[0].strip():
        body_lines.pop(0)
    while body_lines and not body_lines[-1].strip():
        body_lines.pop()
    if not body_lines:
        return [heading], True
    return [heading, "", *body_lines], True


def _normalize_role_arg(raw_role: str) -> str:
    if "\n" in raw_role or "\r" in raw_role:
        raise SystemExit(f"{prog_name()}: --role value must be a single line")
    stripped = raw_role.strip()
    if not stripped:
        raise SystemExit(f"{prog_name()}: --role requires a non-empty role name")
    role = stripped.lower()
    if role in RETIRED_ROLES:
        replacement = RETIRED_ROLES[role]
        raise SystemExit(
            f"{prog_name()}: retired --role value {stripped!r}; use {replacement!r} instead"
        )
    if not ROLE_NAME_RE.match(role):
        raise SystemExit(
            f"{prog_name()}: invalid --role value {stripped!r}; "
            "expected lowercase role identifier matching ^[a-z][a-z0-9_-]*$"
        )
    return role


def _apply_depends_to_body_lines(lines: list[str], depends_clauses: list[str] | None) -> list[str]:
    if depends_clauses is None:
        return lines
    filtered: list[str] = []
    in_fence = False
    for line in lines:
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
        if not in_fence and (DEPENDS_LINE_RE.match(line) or EMPTY_DEPENDS_LINE_RE.match(line)):
            continue
        filtered.append(line)
    while filtered and not filtered[0].strip():
        filtered.pop(0)
    while filtered and not filtered[-1].strip():
        filtered.pop()
    if not depends_clauses:
        return filtered
    dep_lines = [f"- Depends on: {clause}" for clause in depends_clauses]
    return [*dep_lines, *filtered] if filtered else dep_lines


def cmd_add(
    base_dir: Path,
    argv: list[str],
    commit: bool = False,
    no_commit: bool = False,
    explicit_dir: str | None = None,
) -> int:
    prog = prog_name()
    status = "NEW"
    prepend = False
    prefix: str | None = None
    note: str | None = None
    body: str | None = None
    depends_raw: list[str] = []
    pos: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--commit", "-c"):
            commit = True
            i += 1
        elif a == "--no-commit":
            no_commit = True
            i += 1
        elif a in ("--next", "-n", "--top"):
            status = "NEXT"
            prepend = True
            i += 1
        elif a in ("-p", "--prefix"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            prefix = argv[i + 1].strip().upper()
            if not re.fullmatch(r"[A-Z]", prefix):
                raise SystemExit(f"{prog}: invalid ID prefix {argv[i + 1]!r}; expected a single letter A-Z")
            i += 2
        elif a in ("--status", "-s"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            status = argv[i + 1].upper()
            if status in ("WIP", "NEXT"):
                prepend = True
            i += 2
        elif a in ("-m", "--note", "--reason"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            note = argv[i + 1]
            i += 2
        elif a in ("-b", "--body"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            body = argv[i + 1]
            i += 2
        elif a in ("--depends", "-d"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            depends_raw.append(argv[i + 1])
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option for add: {a}")
        else:
            pos.append(a)
            i += 1

    if status not in ("WIP", "NEXT", "NEW", "HOLD", "QUESTION"):
        raise SystemExit(f"{prog}: add status must be WIP, NEXT, NEW, HOLD, or QUESTION (got {status!r})")

    if len(pos) >= 2 and not re.fullmatch(r"[A-Za-z](?:\d+)?", pos[0].strip()):
        cand_proj = pos[0].strip().replace("\\", "/").strip("/")
        ws_root = resolve_workspace_root(base_dir, explicit_dir=explicit_dir)
        cand_dir = (ws_root / cand_proj).resolve()
        if cand_proj and ".." not in cand_proj.split("/") and is_todo_project(cand_dir):
            base_dir = cand_dir
            pos = pos[1:]

    _sync_upstream(base_dir, commit, no_commit)
    if len(pos) == 1:
        tid = next_free_id(base_dir, prefix or DEFAULT_TASK_PREFIX)
        title = pos[0].strip()
    elif len(pos) == 2 and prefix is None:
        first, second = pos[0].strip(), pos[1].strip()
        if re.fullmatch(r"[A-Za-z]", first):
            tid = next_free_id(base_dir, first.upper())
            title = second
        elif re.fullmatch(r"[A-Za-z]\d+", first):
            tid = next_free_id(base_dir, first[0].upper())
            title = second
            if first.upper() != tid:
                sys.stderr.write(
                    f"{prog}: note: ignoring explicit ID {first.upper()}; auto-assigned {tid}\n"
                )
        else:
            raise SystemExit(f"{prog}: invalid ID prefix {first!r}; expected a single letter A-Z (e.g. F, B, P)")
    else:
        raise SystemExit(
            f"{prog}: usage: {prog} add [<PREFIX>] <TITLE> [-p PREFIX] [--next] [--status STATUS] [-m NOTE] [-b BODY]"
        )

    if not title:
        raise SystemExit(f"{prog}: task title cannot be empty")

    body = _resolve_body_arg(body)
    depends_clauses = _normalize_depends_clauses(depends_raw) if depends_raw else None
    body_lines = body.strip().splitlines() if body and body.strip() else []
    body_lines = _apply_depends_to_body_lines(body_lines, depends_clauses)

    heading = _format_heading(status, tid, title, note=note)
    sec_lines = [heading]
    if body_lines:
        sec_lines.extend(["", *body_lines])

    _insert_task_section(base_dir / "TODO.md", sec_lines, _default_todo_header(base_dir), prepend=prepend)
    sys.stdout.write(f"{prog}: added {tid} ([{status}]) to TODO.md\n")
    base_title, _ = _strip_heading_note(title)
    return _finalize_mutation(
        base_dir,
        f"Add task {tid}: {base_title}",
        commit=commit,
        no_commit=no_commit,
        promote_id=(tid if prepend else None),
    )


def cmd_edit(
    base_dir: Path,
    argv: list[str],
    commit: bool = False,
    no_commit: bool = False,
    explicit_dir: str | None = None,
) -> int:
    prog = prog_name()
    new_title: str | None = None
    note: str | None = None
    clear_note = False
    body: str | None = None
    depends_raw: list[str] | None = None
    pos: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--commit", "-c"):
            commit = True
            i += 1
        elif a == "--no-commit":
            no_commit = True
            i += 1
        elif a in ("-t", "--title"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            new_title = argv[i + 1]
            i += 2
        elif a in ("-m", "--note", "--reason"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            note = argv[i + 1]
            if note == "":
                clear_note = True
            i += 2
        elif a in ("-b", "--body"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            body = argv[i + 1]
            i += 2
        elif a in ("--depends", "-d"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            if depends_raw is None:
                depends_raw = []
            depends_raw.append(argv[i + 1])
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option for edit: {a}")
        else:
            pos.append(a)
            i += 1

    if len(pos) != 1:
        raise SystemExit(f"{prog}: usage: {prog} edit <ID> [-t TITLE] [-m NOTE] [-b BODY] [--depends SPEC]")
    base_dir, resolved_id = resolve_project_task_ref(base_dir, pos[0], explicit_dir=explicit_dir)
    _sync_upstream(base_dir, commit, no_commit)
    target = resolved_id.upper()
    body = _resolve_body_arg(body)
    depends_clauses = _normalize_depends_clauses(depends_raw) if depends_raw is not None else None

    if new_title is None and note is None and body is None and depends_clauses is None:
        raise SystemExit(f"{prog}: edit requires at least one of -t TITLE, -m NOTE, -b BODY, --depends, or stdin")

    for fname in TASK_FILES:
        p = base_dir / fname
        if not p.is_file():
            continue
        lines = read_if_exists(p).splitlines()
        in_fence = False
        start_idx: int | None = None
        end_idx: int | None = None
        matched_groups: tuple[str, str, str, str] | None = None
        for idx, line in enumerate(lines):
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
            if not in_fence and line.startswith("# "):
                if start_idx is not None:
                    end_idx = idx
                    break
                m = HEADING_RE.match(line)
                if m and m.group(3).upper() == target:
                    start_idx = idx
                    matched_groups = (m.group(1), m.group(2), m.group(3), m.group(4))
        if start_idx is None or matched_groups is None:
            continue
        if end_idx is None:
            end_idx = len(lines)
        _, status, tid, old_full_title = matched_groups
        base_title, old_note = _strip_heading_note(old_full_title)
        final_title = new_title.strip() if new_title is not None else base_title
        final_note = None if clear_note else (note if note is not None else old_note)
        heading = _format_heading(status, tid, final_title, note=final_note)

        if body is not None:
            body_lines = body.strip().splitlines() if body.strip() else []
            body_lines = _apply_depends_to_body_lines(body_lines, depends_clauses)
            new_sec = [heading]
            if body_lines:
                new_sec.extend(["", *body_lines])
            new_sec.append("")
        else:
            old_sec = lines[start_idx:end_idx]
            if depends_clauses is not None:
                body_lines = _apply_depends_to_body_lines(old_sec[1:], depends_clauses)
                new_sec = [heading, *(["", *body_lines] if body_lines else []), ""]
            else:
                old_sec[0] = heading
                new_sec = old_sec

        updated_lines = lines[:start_idx] + new_sec + lines[end_idx:]
        new_text = re.sub(r"\n{3,}", "\n\n", "\n".join(updated_lines).rstrip()) + "\n"
        p.write_text(new_text, encoding="utf-8")
        sys.stdout.write(f"{prog}: updated task {tid} in {fname}\n")
        return _finalize_mutation(base_dir, f"Update task {tid}: {final_title}", commit=commit, no_commit=no_commit)

    sys.stderr.write(f"{prog}: task {target!r} not found in TODO*.md under {base_dir}\n")
    return 1


def cmd_append(base_dir: Path, argv: list[str], commit: bool = False, no_commit: bool = False) -> int:
    prog = prog_name()
    body: str | None = None
    pos: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--commit", "-c"):
            commit = True
            i += 1
        elif a == "--no-commit":
            no_commit = True
            i += 1
        elif a in ("-b", "--body", "-m", "--note"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            body = argv[i + 1]
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option for append: {a}")
        else:
            pos.append(a)
            i += 1

    if len(pos) != 1:
        raise SystemExit(f"{prog}: usage: {prog} append <ID> [-b TEXT]")
    target = pos[0].strip().upper()
    body = _resolve_body_arg(body)
    if not body or not body.strip():
        raise SystemExit(f"{prog}: append requires non-empty text via -b TEXT or stdin")

    _sync_upstream(base_dir, commit, no_commit)
    for fname in TASK_FILES:
        p = base_dir / fname
        if not p.is_file():
            continue
        lines = read_if_exists(p).splitlines()
        in_fence = False
        start_idx: int | None = None
        end_idx: int | None = None
        matched_title = ""
        for idx, line in enumerate(lines):
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
            if not in_fence and line.startswith("# "):
                if start_idx is not None:
                    end_idx = idx
                    break
                m = HEADING_RE.match(line)
                if m and m.group(3).upper() == target:
                    start_idx = idx
                    matched_title = m.group(4)
        if start_idx is None:
            continue
        if end_idx is None:
            end_idx = len(lines)
        sec_lines = lines[start_idx:end_idx]
        while sec_lines and not sec_lines[-1].strip():
            sec_lines.pop()
        sec_lines.extend(["", body.strip(), ""])
        updated_lines = lines[:start_idx] + sec_lines + lines[end_idx:]
        new_text = re.sub(r"\n{3,}", "\n\n", "\n".join(updated_lines).rstrip()) + "\n"
        p.write_text(new_text, encoding="utf-8")
        sys.stdout.write(f"{prog}: appended to {target} in {fname}\n")
        base_title, _ = _strip_heading_note(matched_title)
        return _finalize_mutation(base_dir, f"Append to task {target}: {base_title}", commit=commit, no_commit=no_commit)

    sys.stderr.write(f"{prog}: task {target!r} not found in TODO*.md under {base_dir}\n")
    return 1


def resolve_top_task_id(
    base_dir: Path,
    role: str | None = None,
    explicit_dir: str | None = None,
) -> str | None:
    todo_path = base_dir / "TODO.md"
    if not todo_path.is_file():
        return None
    active_tasks = parse_tasks_in_text(read_if_exists(todo_path), "TODO.md")
    wanted_role = role.strip().lower() if role is not None else None
    for wanted in ("WIP", "NEXT"):
        for t in active_tasks:
            if str(t["status"]) != wanted:
                continue
            if wanted_role is not None and not _task_matches_role(t, wanted_role):
                continue
            if _is_task_blocked(base_dir, t, explicit_dir=explicit_dir):
                continue
            return str(t["id"]).upper()
    return None


def cmd_next_id(
    base_dir: Path,
    target_dir: Path | None = None,
    task_id: str | None = None,
    explicit_dir: str | None = None,
    role: str | None = None,
) -> int:
    if task_id is None:
        tid = resolve_top_task_id(base_dir, role=role, explicit_dir=explicit_dir)
        if not tid:
            role_note = f" (role={role.strip()})" if role is not None else ""
            sys.stderr.write(
                f"{prog_name()}: no active WIP or NEXT task{role_note} found in TODO.md under {base_dir}\n"
            )
            return 1
        sys.stdout.write(f"{tid}\n")
        return 0

    tdir = target_dir or base_dir
    dag = build_dependency_dag(
        base_dir,
        tdir,
        task_id,
        explicit_dir=explicit_dir,
        stop_at_done=True,
    )
    nodes: dict[tuple[Path, str], dict[str, object]] = dag["nodes"]  # type: ignore[assignment]
    topo_order: list[tuple[Path, str]] = dag["topo_order"]  # type: ignore[assignment]
    root_key: tuple[Path, str] = dag["root"]  # type: ignore[assignment]
    root_node = nodes[root_key]
    if not root_node["exists"]:
        sys.stderr.write(f"{prog_name()}: task {root_node['ref']!r} not found in TODO*.md under {tdir}\n")
        return 1
    root_status = str(root_node["status"])
    if root_status in ("DONE", "CANCELED"):
        sys.stderr.write(f"{prog_name()}: task {root_node['ref']} is already closed ([{root_status}])\n")
        return 1
    syntax_errors: list[str] = dag["syntax_errors"]  # type: ignore[assignment]
    if syntax_errors:
        for e in syntax_errors:
            sys.stderr.write(f"ERROR: {e}\n")
        return 1
    cycle: list[str] = dag["cycle"]  # type: ignore[assignment]
    if cycle:
        sys.stderr.write(f"{prog_name()}: dependency cycle detected: {' -> '.join(cycle)}\n")
        return 1
    bad_blockers = [
        f"{nodes[u]['ref']} ({nodes[u]['status']})"
        for u in topo_order
        if str(nodes[u]["status"]) in ("MISSING", "CANCELED")
    ]
    if bad_blockers:
        sys.stderr.write(
            f"{prog_name()}: task {root_node['ref']} is blocked by {', '.join(bad_blockers)}\n"
        )
        return 1
    next_act = _first_actionable_in_dag(dag, role=role)
    if not next_act:
        role_note = f" (role={role.strip()})" if role is not None else ""
        sys.stderr.write(
            f"{prog_name()}: no unblocked actionable task{role_note} found for {root_node['ref']}\n"
        )
        return 1
    sys.stdout.write(f"{next_act}\n")
    return 0


def split_line_slice(token: str) -> tuple[str, tuple[int, int] | None]:
    m = LINE_SLICE_RE.match(token)
    if not m:
        return token, None
    start = int(m.group("a") or m.group("c"))
    end_raw = m.group("b") or m.group("d")
    return m.group("path"), (start, int(end_raw) if end_raw else start)


def split_file_spec(spec: str) -> tuple[str, tuple[int, int] | None]:
    m = FILE_SPEC_RE.match(spec)
    if not m:
        return spec, None
    return m.group("path"), (int(m.group("start")), int(m.group("end")))


def _resolve_repo_file(repo_root: Path, token: str) -> str | None:
    p_tok = Path(token)
    target = p_tok.resolve() if p_tok.is_absolute() else (repo_root / token).resolve()
    try:
        rel_posix = target.relative_to(repo_root).as_posix()
    except ValueError:
        return None
    if rel_posix == "." or not target.is_file():
        return None
    return rel_posix


def _expand_task_glob(repo_root: Path, pattern: str) -> list[str]:
    if pattern.startswith("/") or ("/" not in pattern and "." not in pattern):
        return []
    if ".." in pattern.split("/"):
        return []
    try:
        matches = sorted(repo_root.glob(pattern))
    except (NotImplementedError, ValueError, OSError):
        return []
    out: list[str] = []
    for m in matches:
        try:
            rel = m.resolve().relative_to(repo_root)
        except (ValueError, OSError):
            continue
        if not m.is_file() or {".git", "__pycache__"} & set(rel.parts):
            continue
        out.append(rel.as_posix())
    return out


def extract_task_files(base_dir: Path, section_text: str) -> list[str]:
    repo_root = base_dir.resolve()
    found: list[str] = []
    seen: set[str] = set()

    def add(spec: str) -> None:
        if spec not in seen:
            seen.add(spec)
            found.append(spec)

    in_fence = False
    for line in section_text.splitlines():
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        for raw in BACKTICK_TOKEN_RE.findall(line):
            cand = raw.strip()
            if not cand or any(ch.isspace() for ch in cand) or "://" in cand:
                continue
            if cand.startswith("-") or any(ch in cand for ch in "<>{}"):
                continue
            path_part, span = split_line_slice(cand)
            if span is not None and (span[0] < 1 or span[1] < span[0]):
                continue
            if any(ch in path_part for ch in "*?["):
                if span is None:
                    for rel_glob in _expand_task_glob(repo_root, path_part):
                        add(rel_glob)
                continue
            rel = _resolve_repo_file(repo_root, path_part)
            if rel is None:
                continue
            if span is not None:
                n_total = len((repo_root / rel).read_bytes().splitlines())
                if span[0] > n_total:
                    continue
                rel = f"{rel}:{span[0]}-{min(span[1], n_total)}"
            add(rel)
    return found


def cmd_files(
    base_dir: Path,
    task_id: str | None = None,
    max_lines: int | None = None,
    max_total_lines: int | None = None,
    max_bytes: int | None = None,
    max_total_bytes: int | None = None,
) -> int:
    target = task_id.strip().upper() if task_id else resolve_top_task_id(base_dir)
    if not target:
        sys.stderr.write(f"{prog_name()}: no active WIP or NEXT task found in TODO.md under {base_dir}\n")
        return 1
    has_budget = any(
        cap is not None for cap in (max_lines, max_total_lines, max_bytes, max_total_bytes)
    )
    repo_root = base_dir.resolve()
    total_lines = 0
    total_bytes = 0
    for t in collect_all_tasks(base_dir):
        if str(t["id"]).upper() == target:
            for spec in extract_task_files(base_dir, str(t["section"])):
                if has_budget:
                    rel_path, span = split_file_spec(spec)
                    chunks = (repo_root / rel_path).read_bytes().splitlines(keepends=True)
                    if span is not None:
                        chunks = chunks[span[0] - 1 : span[1]]
                    n_bytes = sum(len(c) for c in chunks)
                    n_lines = len(chunks)
                    if max_bytes is not None and n_bytes > max_bytes:
                        continue
                    if max_total_bytes is not None and total_bytes + n_bytes > max_total_bytes:
                        continue
                    if max_lines is not None and n_lines > max_lines:
                        continue
                    if max_total_lines is not None and total_lines + n_lines > max_total_lines:
                        continue
                    total_bytes += n_bytes
                    total_lines += n_lines
                sys.stdout.write(f"{spec}\n")
            return 0
    sys.stderr.write(f"{prog_name()}: task {target!r} not found in TODO*.md under {base_dir}\n")
    return 1


def cmd_chain(
    base_dir: Path,
    limit: int | None = None,
    include_hold: bool = False,
    include_done: bool = False,
    ready: bool = False,
    role: str | None = None,
    by_role: bool = False,
    workspace: bool = False,
    explicit_dir: str | None = None,
    targets: list[tuple[Path, str]] | None = None,
    tree: bool = False,
    numbered: str | None = None,
    focus: list[tuple[Path, str]] | None = None,
    status: frozenset[str] | None = None,
) -> int:
    b_res = base_dir.resolve()
    row_scoped = status is not None or bool(focus)
    ws_root = resolve_workspace_root(b_res, explicit_dir=explicit_dir)
    is_orch = (not workspace) and is_orchestrator_project(b_res, ws_root, explicit_dir=explicit_dir)
    if workspace:
        if not resolve_workspace_chain_projects(b_res, ws_root):
            sys.stdout.write(f"No todo_md projects found under {ws_root}\n")
            return 0
    elif is_orch:
        if not read_configured_todo_projects(b_res, ws_root, include_env=True) and not (b_res / "TODO.md").is_file():
            sys.stdout.write(f"No todo_md projects found under {ws_root}\n")
            return 0
    elif not (b_res / "TODO.md").is_file():
        sys.stderr.write(f"{prog_name()}: no TODO.md found in {base_dir} (run '{prog_name()} init' to create one)\n")
        return 1

    dag = build_execution_chain_dag(
        base_dir,
        workspace=workspace,
        explicit_dir=explicit_dir,
        include_done=include_done,
    )
    syntax_errors: list[str] = dag["syntax_errors"]  # type: ignore[assignment]
    if syntax_errors:
        for e in syntax_errors:
            sys.stderr.write(f"ERROR: {e}\n")
        return 1
    cycle: list[str] = dag["cycle"]  # type: ignore[assignment]
    if cycle:
        sys.stderr.write(f"ERROR: dependency cycle detected: {' -> '.join(cycle)}\n")
        return 1

    nodes: dict[tuple[Path, str], dict[str, object]] = dag["nodes"]  # type: ignore[assignment]
    prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["prereqs"]  # type: ignore[assignment]
    done_nodes: dict[tuple[Path, str], set[tuple[Path, str]]] = dag.get("done_nodes", {})  # type: ignore[assignment]
    direct_done_deps: dict[tuple[Path, str], list[tuple[Path, str]]] = dag.get("direct_done_deps", {})  # type: ignore[assignment]
    done_graph_prereqs: dict[tuple[Path, str], list[tuple[Path, str]]] = dag.get("done_graph_prereqs", {})  # type: ignore[assignment]
    dependents: dict[tuple[Path, str], list[tuple[Path, str]]] = dag["dependents"]  # type: ignore[assignment]
    topo_order: list[tuple[Path, str]] = dag["topo_order"]  # type: ignore[assignment]
    target_project: Path | None = dag.get("target_project")  # type: ignore[assignment]

    archived_tasks: list[tuple[Path, str]] = dag.get("archived_tasks", [])  # type: ignore[assignment]

    def _is_target_node(u: tuple[Path, str]) -> bool:
        return target_project is None or u[0] == target_project

    has_open_in_scope = bool(topo_order) and (
        target_project is None or any(u[0] == target_project for u in topo_order)
    )
    has_arch_in_scope = include_done and bool(archived_tasks) and (
        target_project is None or any(u[0] == target_project for u in archived_tasks)
    )
    if not has_open_in_scope and not has_arch_in_scope:
        scope_msg = "across workspace projects" if (workspace or is_orch) else "in TODO.md"
        sys.stdout.write(f"No open tasks {scope_msg}\n")
        return 0

    if by_role:
        plan = plan_execution_chains_by_role(
            dag,
            include_hold=include_hold,
            ready_only=ready,
            limit=(None if (target_project is not None or row_scoped) else limit),
            role=role,
        )
    else:
        plan = plan_execution_chains(
            dag,
            include_hold=include_hold,
            ready_only=ready,
            limit=(None if (role is not None or row_scoped or target_project is not None) else limit),
            include_done=include_done,
        )
    active_nodes: list[tuple[Path, str]] = plan["active_nodes"]  # type: ignore[assignment]
    active_unblocks: dict[tuple[Path, str], int] = plan["active_unblocks"]  # type: ignore[assignment]
    excluded_hold: set[tuple[Path, str]] = plan["excluded_hold"]  # type: ignore[assignment]
    chain_counts: dict[tuple[Path, str], int] = plan.get("chain_counts", {})  # type: ignore[assignment]
    done_counts: dict[tuple[Path, str], int] = plan.get("done_counts", {})  # type: ignore[assignment]
    is_momentum_next: dict[tuple[Path, str], int] = plan.get("is_momentum_next", {})  # type: ignore[assignment]
    immediate_ready_targets: dict[tuple[Path, str], list[tuple[Path, str]]] = plan.get("immediate_ready_targets", {})  # type: ignore[assignment]

    active_set = set(active_nodes)
    relevant_active_set: set[tuple[Path, str]] = set(active_set)
    if target_project is not None:
        undir: dict[tuple[Path, str], set[tuple[Path, str]]] = {u: set() for u in active_nodes}
        for u in active_nodes:
            for p in prereqs.get(u, []):
                if p in active_set:
                    undir[u].add(p)
                    undir[p].add(u)
        rel_vis: set[tuple[Path, str]] = set()
        for u in active_nodes:
            if u[0] == target_project and u not in rel_vis:
                stk = [u]
                rel_vis.add(u)
                while stk:
                    cur = stk.pop()
                    for nb in undir[cur]:
                        if nb not in rel_vis:
                            rel_vis.add(nb)
                            stk.append(nb)
        relevant_active_set = rel_vis

    had_blocker_error = False
    for u in active_nodes:
        if u not in relevant_active_set:
            continue
        st = str(nodes[u]["status"])
        if st in ("MISSING", "CANCELED"):
            had_blocker_error = True
            blocked_refs = [str(nodes[v]["ref"]) for v in dependents.get(u, []) if v in relevant_active_set]
            if blocked_refs:
                sys.stderr.write(
                    f"ERROR: unresolved blocker {nodes[u]['ref']} ({st}) blocks {', '.join(blocked_refs)}\n"
                )
            else:
                sys.stderr.write(f"ERROR: unresolved blocker {nodes[u]['ref']} ({st})\n")

    term_width = _get_terminal_columns()
    use_color = _use_ansi_color()
    target_set, unscoped_target_ids = _normalize_target_refs(base_dir, targets, explicit_dir=explicit_dir)
    wanted_role = role.strip().lower() if role is not None else None

    def _is_highlighted_node(u: tuple[Path, str]) -> bool:
        return (u[0].resolve(), u[1].upper()) in target_set or u[1].upper() in unscoped_target_ids

    def _matches_role(u: tuple[Path, str]) -> bool:
        if wanted_role is None:
            return True
        nd = nodes[u]
        return bool(nd.get("exists")) and _task_matches_role(nd, wanted_role)

    focus_set, focus_unscoped = _normalize_target_refs(base_dir, focus, explicit_dir=explicit_dir)
    focus_active = bool(focus_set or focus_unscoped)

    def _is_focus_node(u: tuple[Path, str]) -> bool:
        return (u[0].resolve(), u[1].upper()) in focus_set or u[1].upper() in focus_unscoped

    def _status_ok(u: tuple[Path, str]) -> bool:
        return status is None or str(nodes[u]["status"]) in status

    def _row_ok(u: tuple[Path, str]) -> bool:
        return _status_ok(u) and (not focus_active or _is_focus_node(u))

    num_w_box = [1]

    def _lead_cell(prefix: str, idx: int, ref: str) -> str:
        if numbered is None:
            return f"{prefix}{ref}"
        width = num_w_box[0]
        if numbered == "right":
            return f"{prefix}{idx:>{width}} {ref}"
        return f"{prefix}{idx:<{width}} {ref}"

    def _format_row(
        idx: int,
        u: tuple[Path, str],
        show_downstream: bool = False,
        also_in_refs: list[str] | None = None,
        tree_prefix: str = "",
        cont_prefix: str | None = None,
        lead_col_width: int = 24,
    ) -> str:
        nd = nodes[u]
        st = str(nd["status"])
        ref = str(nd["ref"])
        title = str(nd["title"])
        blockers = [str(nodes[p]["ref"]) for p in prereqs.get(u, []) if str(nodes[p]["status"]) != "DONE"]
        role_badge = _task_role_badge(nd) if nd.get("exists") else ""
        impact = active_unblocks.get(u, 0)
        done_c = done_counts.get(u, len(done_nodes.get(u, set())))
        if st == "MISSING":
            badge = "[MISSING]"
            status_tag = f"[blocked | unblocks: {impact}]" if impact > 0 else "[blocked]"
        elif st == "CANCELED":
            badge = f"{nd['emoji']} [CANCELED]"
            if u in active_set:
                status_tag = f"[blocked | unblocks: {impact}]" if impact > 0 else "[blocked]"
            else:
                status_tag = ""
        elif st == "DONE":
            badge = f"{nd['emoji']} [DONE]"
            status_tag = ""
        else:
            emoji = "⏳" if (st in ("WIP", "NEXT") and blockers) else str(nd["emoji"])
            badge = f"{emoji} [{st}]"
            if blockers:
                if impact > 0:
                    status_tag = f"[blocked by: {', '.join(blockers)} | unblocks: {impact}]"
                else:
                    status_tag = f"[blocked by: {', '.join(blockers)}]"
            else:
                perks: list[str] = []
                if not show_downstream:
                    perks.append("ready")
                if done_c > 0 and impact == 0:
                    perks.append("FINAL")
                elif done_c > 0 and impact > 0:
                    perks.append("STAGE")
                if is_momentum_next.get(u, 1) == 0:
                    perks.append("COMBO")
                kv_stats: list[str] = []
                if show_downstream:
                    n_chains = chain_counts.get(u, 0)
                    if n_chains > 1:
                        kv_stats.append(f"chain: {n_chains}")
                    if impact > 0:
                        imm_count = len(immediate_ready_targets.get(u, []))
                        if imm_count > 0:
                            kv_stats.append(f"ready: +{imm_count}")
                        kv_stats.append(f"unblocks: {impact}")
                else:
                    if impact > 0:
                        kv_stats.append(f"unblocks: {impact}")
                tag_parts = list(perks)
                if kv_stats:
                    tag_parts.append(", ".join(kv_stats))
                status_tag = f"[{' | '.join(tag_parts)}]" if tag_parts else ""
        if also_in_refs:
            also_tag = f"[also in: {', '.join(also_in_refs)}]"
            status_tag = f"{status_tag} {also_tag}" if status_tag else also_tag
        lead_cell = _lead_cell(tree_prefix, idx, ref)
        prefix = (
            f"  {_pad_display(lead_cell, lead_col_width)}  "
            f"{_pad_display(badge, 14)}  "
            f"{_pad_display(role_badge, 10)}  "
        )
        desc = f"{title}  {status_tag}" if status_tag else title
        rendered = _wrap_table_row(prefix, desc, term_width, cont_prefix=cont_prefix) + "\n"
        return _style_task_row(
            rendered,
            is_external=not _is_target_node(u),
            is_done=(st == "DONE"),
            is_highlighted=_is_highlighted_node(u),
            use_color=use_color,
        )

    held_paths: list[list[tuple[Path, str]]] = []
    if excluded_hold:
        held_in_deg = {u: sum(1 for p in prereqs[u] if p in excluded_hold) for u in excluded_hold}
        held_deps = {u: [v for v in dependents.get(u, []) if v in excluded_hold] for u in excluded_hold}
        branch_roots = [u for u in topo_order if u in excluded_hold and held_in_deg[u] == 0]

        def _collect_held_paths(u: tuple[Path, str], path: list[tuple[Path, str]]) -> None:
            if len(held_paths) >= 64:
                return
            nxts = held_deps[u]
            if not nxts:
                held_paths.append(path)
                return
            for v in nxts:
                _collect_held_paths(v, [*path, v])

        for r in branch_roots:
            _collect_held_paths(r, [r])

        if target_project is not None:
            held_paths = [path for path in held_paths if any(_is_target_node(k) for k in path)]
        if wanted_role is not None:
            held_paths = [path for path in held_paths if any(_matches_role(k) for k in path)]
        if focus_active:
            held_paths = [path for path in held_paths if any(_is_focus_node(k) for k in path)]
        if status is not None:
            held_paths = [path for path in held_paths if any(_status_ok(k) for k in path)]

    scoped_excluded_hold = {
        u
        for u in excluded_hold
        if _is_target_node(u) or any(u in path for path in held_paths)
    }

    if by_role:
        queues: list[tuple[str, str, list[tuple[Path, str]]]] = plan["queues"]  # type: ignore[assignment]
        if target_project is not None or row_scoped:
            queues = [
                (q_key, q_label, [u for u in q_items if _is_target_node(u) and _row_ok(u)])
                for q_key, q_label, q_items in queues
            ]
            if limit is not None:
                rem = limit
                limited_queues: list[tuple[str, str, list[tuple[Path, str]]]] = []
                for q_key, q_label, q_items in queues:
                    if rem <= 0:
                        limited_queues.append((q_key, q_label, []))
                        continue
                    take = q_items[:rem]
                    limited_queues.append((q_key, q_label, take))
                    rem -= len(take)
                queues = limited_queues
        non_empty_queues = [(q_label, q_items) for _, q_label, q_items in queues if q_items]
        num_w_box[0] = len(str(max(1, sum(len(q_items) for _, q_items in non_empty_queues))))
        matching_held = [u for u in scoped_excluded_hold if _matches_role(u) and _is_target_node(u) and _row_ok(u)]
        if non_empty_queues:
            row_idx = 1
            for sec_idx, (q_label, q_items) in enumerate(non_empty_queues):
                if sec_idx > 0:
                    sys.stdout.write("\n")
                sys.stdout.write(f"{q_label}:\n")
                for u in q_items:
                    sys.stdout.write(_format_row(row_idx, u))
                    row_idx += 1
        elif matching_held:
            role_note = f" matching role={role.strip()}" if role is not None else ""
            sys.stdout.write(
                f"Queues: (none{role_note} — {len(matching_held)} held task(s); pass --include-hold to include)\n"
            )
        elif role is not None:
            sys.stdout.write(f"Queues: (none matching role={role.strip()})\n")
        else:
            sys.stdout.write("Queues: (none)\n")
    elif ready:
        ready_tasks: list[tuple[Path, str]] = plan["ready_tasks"]  # type: ignore[assignment]
        if target_project is not None:
            ready_tasks = [u for u in ready_tasks if _is_target_node(u)]
        if wanted_role is not None:
            ready_tasks = [u for u in ready_tasks if _matches_role(u)]
        if row_scoped:
            ready_tasks = [u for u in ready_tasks if _row_ok(u)]
        if (target_project is not None or wanted_role is not None or row_scoped) and limit is not None:
            ready_tasks = ready_tasks[:limit]
        matching_held = [u for u in scoped_excluded_hold if _matches_role(u) and _is_target_node(u) and _row_ok(u)]
        num_w_box[0] = len(str(max(1, len(ready_tasks))))
        if ready_tasks:
            sys.stdout.write("Ready tasks:\n")
            for idx, u in enumerate(ready_tasks, start=1):
                sys.stdout.write(_format_row(idx, u, show_downstream=True))
        elif matching_held:
            role_note = f" matching role={role.strip()}" if role is not None else ""
            sys.stdout.write(
                f"Ready tasks: (none{role_note} — {len(matching_held)} held task(s); pass --include-hold to include)\n"
            )
        elif role is not None:
            sys.stdout.write(f"Ready tasks: (none matching role={role.strip()})\n")
        else:
            sys.stdout.write("Ready tasks: (none)\n")
    else:
        chains: list[list[tuple[Path, str]]] = plan["chains"]  # type: ignore[assignment]
        raw_chain_stats: list[dict[str, object]] = plan.get("chain_stats", [])  # type: ignore[assignment]
        if len(raw_chain_stats) == len(chains):
            chains_with_stats: list[tuple[list[tuple[Path, str]], dict[str, object]]] = list(
                zip(chains, raw_chain_stats)
            )
        else:
            chains_with_stats = [
                (
                    comp,
                    {
                        "open_count": len(comp),
                        "done_count": 0,
                        "total_tasks": len(comp),
                        "progress_pct": 0,
                    },
                )
                for comp in chains
            ]
        standalone: list[tuple[Path, str]] = plan["standalone"]  # type: ignore[assignment]

        def _chain_has_target_node(
            comp_nodes: list[tuple[Path, str]],
            st_info: dict[str, object],
        ) -> bool:
            open_list = st_info.get("open_nodes")
            if isinstance(open_list, list) and open_list:
                return any(_is_target_node(u) for u in open_list)
            non_done = [u for u in comp_nodes if str(nodes[u]["status"]) != "DONE"]
            check_list = non_done if non_done else comp_nodes
            return any(_is_target_node(u) for u in check_list)

        if target_project is not None:
            chains_with_stats = [
                (comp, st_info)
                for comp, st_info in chains_with_stats
                if _chain_has_target_node(comp, st_info)
            ]
            standalone = [u for u in standalone if _is_target_node(u)]
        if wanted_role is not None:
            filtered_chains_with_stats: list[tuple[list[tuple[Path, str]], dict[str, object]]] = []
            for comp, st_info in chains_with_stats:
                f_comp = [u for u in comp if _matches_role(u)]
                if f_comp and (target_project is None or any(_is_target_node(u) for u in f_comp)):
                    filtered_chains_with_stats.append((f_comp, st_info))
            chains_with_stats = filtered_chains_with_stats
            standalone = [u for u in standalone if _matches_role(u)]
        if row_scoped:
            scoped_chains: list[tuple[list[tuple[Path, str]], dict[str, object]]] = []
            for comp, st_info in chains_with_stats:
                c_nodes = (
                    set(comp)
                    | set(st_info.get("nodes", []))  # type: ignore[arg-type]
                    | set(st_info.get("open_nodes", []))  # type: ignore[arg-type]
                    | set(st_info.get("done_nodes", set()))  # type: ignore[arg-type]
                )
                if focus_active and not any(_is_focus_node(u) for u in c_nodes):
                    continue
                f_comp = [u for u in comp if _status_ok(u)]
                if f_comp:
                    scoped_chains.append((f_comp, st_info))
            chains_with_stats = scoped_chains
            standalone = [u for u in standalone if _row_ok(u)]
        if (target_project is not None or wanted_role is not None or row_scoped) and limit is not None:
            rem = limit
            limited_chains_with_stats: list[tuple[list[tuple[Path, str]], dict[str, object]]] = []
            for comp, st_info in chains_with_stats:
                if rem <= 0:
                    break
                take = comp[:rem]
                limited_chains_with_stats.append((take, st_info))
                rem -= len(take)
            standalone = standalone[:rem] if rem > 0 else []
            chains_with_stats = limited_chains_with_stats
        matching_held = [u for u in scoped_excluded_hold if _matches_role(u) and _is_target_node(u) and _row_ok(u)]
        if chains_with_stats or standalone:
            row_idx = 1
            wrote_section = False

            def _build_chain_tree(
                comp_nodes: list[tuple[Path, str]],
                st_info: dict[str, object],
            ) -> dict[str, object]:
                r_key = st_info.get("root")
                t_root: tuple[Path, str] = (
                    r_key
                    if isinstance(r_key, tuple) and r_key in nodes
                    else (comp_nodes[-1] if comp_nodes else (b_res, ""))
                )
                return build_chain_milestone_tree(
                    root=t_root,
                    display_nodes=comp_nodes,
                    nodes=nodes,
                    prereqs=prereqs,
                    done_nodes=done_nodes,
                    direct_done_deps=direct_done_deps,
                    done_graph_prereqs=done_graph_prereqs,
                    include_done=include_done,
                )

            def _flat_tree_nodes(t_node: dict[str, object]) -> list[tuple[Path, str]]:
                flat: list[tuple[Path, str]] = []
                for ch_item in t_node.get("children", []):  # type: ignore[attr-defined]
                    if ch_item.get("kind") == "subchain":
                        flat.extend(_flat_tree_nodes(ch_item))
                    else:
                        flat.append(ch_item["node"])
                return flat

            chain_trees = [_build_chain_tree(c_nodes, c_info) for c_nodes, c_info in chains_with_stats]
            total_rows = len(standalone) + sum(len(_flat_tree_nodes(ct)) for ct in chain_trees)
            num_w_box[0] = len(str(max(1, total_rows)))
            for chain_idx, (comp, st_info) in enumerate(chains_with_stats, start=1):
                if wrote_section:
                    sys.stdout.write("\n")
                pct = int(st_info.get("progress_pct", 0))
                done_c = int(st_info.get("done_count", 0))
                open_c = int(st_info.get("open_count", len(comp)))
                root_key = st_info.get("root")
                if isinstance(root_key, tuple) and root_key in nodes:
                    root_ref = str(st_info.get("root_ref") or nodes[root_key]["ref"])
                    root_title = str(st_info.get("root_title") or nodes[root_key]["title"])
                else:
                    fallback_root = comp[-1] if comp else None
                    root_ref = str(
                        st_info.get("root_ref")
                        or (
                            nodes[fallback_root]["ref"]
                            if fallback_root is not None and fallback_root in nodes
                            else ""
                        )
                    )
                    root_title = str(
                        st_info.get("root_title")
                        or (
                            nodes[fallback_root]["title"]
                            if fallback_root is not None and fallback_root in nodes
                            else ""
                        )
                    )
                also_in_map: dict[tuple[Path, str], list[str]] = st_info.get("also_in", {})  # type: ignore[assignment]
                chain_nodes = (
                    set(comp)
                    | set(st_info.get("nodes", []))  # type: ignore[arg-type]
                    | set(st_info.get("open_nodes", []))  # type: ignore[arg-type]
                    | set(st_info.get("done_nodes", set()))  # type: ignore[arg-type]
                )
                chain_highlighted = any(_is_highlighted_node(u) for u in chain_nodes)
                chain_stat_tag = (
                    f"[{pct}% | done: {done_c}, open: {open_c}]"
                    if done_c > 0
                    else f"[open: {open_c}]"
                )
                header_line = f"Chain {chain_idx} -> {root_ref}: {root_title} {chain_stat_tag}:\n"
                sys.stdout.write(
                    _style_task_row(
                        header_line,
                        is_highlighted=chain_highlighted,
                        use_color=use_color,
                    )
                )
                chain_tree = chain_trees[chain_idx - 1]

                def _max_lead_width(
                    t_node: dict[str, object],
                    active_bars: list[bool],
                    sim_idx: int,
                ) -> tuple[int, int]:
                    max_w = 24
                    ch_list: list[dict[str, object]] = t_node.get("children", [])  # type: ignore[assignment]
                    for c_i, ch_item in enumerate(ch_list):
                        is_last_c = c_i == len(ch_list) - 1
                        if ch_item.get("kind") == "subchain":
                            sub_w, sim_idx = _max_lead_width(
                                ch_item,
                                [*active_bars, not is_last_c],
                                sim_idx,
                            )
                            if sub_w > max_w:
                                max_w = sub_w
                        else:
                            u_node: tuple[Path, str] = ch_item["node"]  # type: ignore[assignment]
                            bars = "".join("│   " if b else "    " for b in active_bars)
                            is_closing = bool(ch_item.get("is_closing")) and is_last_c
                            conn = "└─► " if is_closing else ("└── " if is_last_c else "├── ")
                            cell = _lead_cell(f"{bars}{conn}", sim_idx, str(nodes[u_node]["ref"]))
                            cw = _display_width(cell)
                            if cw > max_w:
                                max_w = cw
                            sim_idx += 1
                    return max_w, sim_idx

                chain_lead_w, _ = _max_lead_width(chain_tree, [], row_idx)

                def _render_chain_tree_children(
                    t_node: dict[str, object],
                    active_bars: list[bool],
                    cur_idx: int,
                ) -> int:
                    ch_list: list[dict[str, object]] = t_node.get("children", [])  # type: ignore[assignment]
                    for c_i, ch_item in enumerate(ch_list):
                        is_last_c = c_i == len(ch_list) - 1
                        bars = "".join("│   " if b else "    " for b in active_bars)
                        if ch_item.get("kind") == "subchain":
                            m_node: tuple[Path, str] = ch_item["milestone"]  # type: ignore[assignment]
                            m_ref = str(ch_item.get("milestone_ref") or nodes[m_node]["ref"])
                            m_title = str(ch_item.get("milestone_title") or nodes[m_node]["title"])
                            m_pct = int(ch_item.get("progress_pct", 0))
                            m_done = int(ch_item.get("done_count", 0))
                            m_open = int(ch_item.get("open_count", 0))
                            sub_nodes: set[tuple[Path, str]] = ch_item.get("subtree_nodes", {m_node})  # type: ignore[assignment]
                            sub_hl = any(_is_highlighted_node(su) for su in sub_nodes)
                            sub_conn = "└── " if is_last_c else "├── "
                            sub_prefix = f"  {bars}{sub_conn}"
                            sub_cont_bars = "".join(
                                "│   " if b else "    " for b in [*active_bars, not is_last_c]
                            )
                            sub_cont_prefix = f"  {sub_cont_bars}" if sub_cont_bars.strip() else "    "
                            sub_stat_tag = (
                                f"[{m_pct}% | done: {m_done}, open: {m_open}]"
                                if m_done > 0
                                else f"[open: {m_open}]"
                            )
                            sub_desc = f"Sub-chain -> {m_ref}: {m_title} {sub_stat_tag}:"
                            sub_hdr = (
                                _wrap_table_row(
                                    sub_prefix,
                                    sub_desc,
                                    term_width,
                                    cont_prefix=sub_cont_prefix,
                                )
                                + "\n"
                            )
                            sys.stdout.write(
                                _style_task_row(
                                    sub_hdr,
                                    is_external=not _is_target_node(m_node),
                                    is_done=(str(nodes[m_node]["status"]) == "DONE"),
                                    is_highlighted=sub_hl,
                                    use_color=use_color,
                                )
                            )
                            cur_idx = _render_chain_tree_children(
                                ch_item,
                                [*active_bars, not is_last_c],
                                cur_idx,
                            )
                        else:
                            u_node: tuple[Path, str] = ch_item["node"]  # type: ignore[assignment]
                            is_closing = bool(ch_item.get("is_closing")) and is_last_c
                            conn = "└─► " if is_closing else ("└── " if is_last_c else "├── ")
                            t_pref = f"{bars}{conn}"
                            row_bars = [*active_bars, not is_last_c]
                            cont_bars_str = "".join("│   " if b else "    " for b in row_bars)
                            c_pref = f"  {cont_bars_str}" if any(row_bars) else None
                            sys.stdout.write(
                                _format_row(
                                    cur_idx,
                                    u_node,
                                    also_in_refs=also_in_map.get(u_node),
                                    tree_prefix=t_pref,
                                    cont_prefix=c_pref,
                                    lead_col_width=chain_lead_w,
                                )
                            )
                            cur_idx += 1
                    return cur_idx

                if tree:
                    row_idx = _render_chain_tree_children(chain_tree, [], row_idx)
                else:
                    flat_nodes = _flat_tree_nodes(chain_tree)
                    flat_w = max(
                        [
                            24,
                            *(
                                _display_width(_lead_cell("", row_idx + k, str(nodes[fu]["ref"])))
                                for k, fu in enumerate(flat_nodes)
                            ),
                        ]
                    )
                    for fu in flat_nodes:
                        sys.stdout.write(
                            _format_row(
                                row_idx,
                                fu,
                                also_in_refs=also_in_map.get(fu),
                                lead_col_width=flat_w,
                            )
                        )
                        row_idx += 1
                wrote_section = True
            if standalone:
                if wrote_section:
                    sys.stdout.write("\n")
                sys.stdout.write("Standalone tasks:\n")
                for u in standalone:
                    sys.stdout.write(_format_row(row_idx, u))
                    row_idx += 1
        elif matching_held:
            role_note = f" matching role={role.strip()}" if role is not None else ""
            sys.stdout.write(
                f"Chain: (none{role_note} — {len(matching_held)} held task(s); pass --include-hold to include)\n"
            )
        elif role is not None:
            sys.stdout.write(f"Chain: (none matching role={role.strip()})\n")
        else:
            sys.stdout.write("Chain: (none)\n")

    if held_paths:
        sys.stdout.write("\nHeld branches:\n")
        for path in held_paths:
            parts: list[str] = []
            for k in path:
                token = _style_task_row(
                    f"{nodes[k]['ref']} ({nodes[k]['status']})",
                    is_external=not _is_target_node(k),
                    is_done=(str(nodes[k]["status"]) == "DONE"),
                    is_highlighted=_is_highlighted_node(k),
                    use_color=use_color,
                )
                parts.append(token)
            rendered = " -> ".join(parts)
            sys.stdout.write(f"  {rendered}\n")

    if focus is not None and len(focus) == 1:
        f_dir, raw_f_tid = focus[0]
        f_tid = raw_f_tid[2:].strip().upper() if raw_f_tid.startswith(".:") else raw_f_tid.split(":")[-1].strip().upper()
        cand_key = (f_dir.resolve(), f_tid)
        if cand_key not in nodes or not nodes[cand_key].get("exists"):
            matched_nodes = [u for u in nodes if _is_focus_node(u) and nodes[u].get("exists")]
            if len(matched_nodes) == 1:
                f_dir, f_tid = matched_nodes[0]
        f_dag = build_dependency_dag(base_dir, f_dir, f_tid, explicit_dir=explicit_dir, stop_at_done=True)
        f_nodes: dict[tuple[Path, str], dict[str, object]] = f_dag["nodes"]  # type: ignore[assignment]
        f_root: tuple[Path, str] = f_dag["root"]  # type: ignore[assignment]
        if f_nodes[f_root]["exists"] and not f_dag["syntax_errors"] and not f_dag["cycle"]:
            f_next = _first_actionable_in_dag(f_dag)
            sys.stdout.write(f"\nNext actionable: {f_next or 'none'}\n")

    return 1 if had_blocker_error else 0


def parse_version_from_source(source: str) -> str | None:
    m = re.search(r'^VERSION\s*=\s*["\x27]([^"\x27]+)["\x27]', source, flags=re.MULTILINE)
    return m.group(1) if m else None


def version_tuple(v: str) -> tuple[int, ...]:
    return tuple(int(p) for p in re.split(r"[^0-9]+", v) if p)


def fetch_remote_script(url: str | None = None) -> str:
    import urllib.request

    target_url = url or os.environ.get("TODO_MD_UPDATE_URL") or DEFAULT_UPDATE_URL
    req = urllib.request.Request(target_url, headers={"User-Agent": f"todo_md/{VERSION}"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = resp.read().decode("utf-8")
    if REPO_MARKER not in data:
        raise ValueError(f"remote file at {target_url} is not a valid vitalio/todo_md script")
    return data


def cmd_check_update(url: str | None = None) -> int:
    prog = prog_name()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: failed to check for updates: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if version_tuple(remote_ver) > version_tuple(VERSION):
        sys.stdout.write(f"{prog}: update available: {VERSION} -> {remote_ver} (run '{prog} update')\n")
    else:
        sys.stdout.write(f"{prog} {VERSION} is up to date (remote: {remote_ver}).\n")
    return 0


def cmd_update(force: bool = False, url: str | None = None, target_path: Path | None = None) -> int:
    prog = prog_name()
    dest = target_path or Path(__file__).resolve()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: update failed: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if not force and version_tuple(remote_ver) <= version_tuple(VERSION):
        sys.stdout.write(f"{prog} {VERSION} is already up to date.\n")
        return 0
    try:
        tmp_fd, tmp_name = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
        try:
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
                f.write(remote_src)
            os.chmod(tmp_name, 0o755)
            os.replace(tmp_name, dest)
        except Exception:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
            raise
    except Exception as exc:
        sys.stderr.write(f"{prog}: could not write updated binary to {dest}: {exc}\n")
        return 1
    sys.stdout.write(f"{prog}: updated {VERSION} -> {remote_ver} ({dest})\n")
    return 0


