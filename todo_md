    sys.stdout.write(read_if_exists(arch_path).rstrip() + "\n")
    return 0


def cmd_transition(
    base_dir: Path,
    task_id: str,
    new_status: str | None = None,
    dest_file: str | None = None,
    note: str | None = None,
    promote_top: bool = False,
    commit: bool = False,
    no_commit: bool = False,
) -> int:
    target = task_id.strip().upper()
    if new_status and new_status not in VALID_STATUSES:
        raise SystemExit(f"{prog_name()}: invalid status {new_status!r}; expected one of {', '.join(VALID_STATUSES)}")
    source_file: str | None = None
    found: dict[str, object] | None = None
    updated_source_text = ""
    for fname in TASK_FILES:
        p = base_dir / fname
        if not p.is_file():
            continue
        info, rem = _extract_and_remove_task(read_if_exists(p), target)
        if info is not None:
            source_file = fname
            found = info
            updated_source_text = rem
            break
    if found is None or source_file is None:
        sys.stderr.write(f"{prog_name()}: task {target!r} not found in TODO*.md under {base_dir}\n")
        return 1

    final_status = new_status or str(found["status"])
    if dest_file is None:
        if final_status in ("DONE", "CANCELED"):
            dest_file = "TODO_ARCHIVE.md"
        else:
            dest_file = "TODO.md"

    today_iso = date.today().isoformat()
    effective_note = note
    if final_status == "DONE":
        if effective_note and today_iso not in effective_note:
            effective_note = f"{today_iso}, {effective_note}"
        elif effective_note is None:
            _, existing_n = _strip_heading_note(str(found["title"]))
            if not existing_n:
                effective_note = today_iso

    tid = str(found["id"])
    base_title, _ = _strip_heading_note(str(found["title"]))
    sec_lines = list(found["lines"])  # type: ignore[arg-type]
    sec_lines[0] = _format_heading(final_status, tid, str(found["title"]), note=effective_note)

    if final_status == "DONE":
        commit_msg = f"Complete task {tid}: {base_title}"
    elif final_status == "CANCELED":
        commit_msg = f"Cancel task {tid}: {base_title}"
    elif promote_top and final_status == "NEXT":
        commit_msg = f"Promote task {tid} to NEXT: {base_title}"
    else:
        commit_msg = f"Mark task {tid} as {final_status}: {base_title}"

    if dest_file == source_file and not promote_top:
        src_path = base_dir / source_file
        orig_lines = read_if_exists(src_path).splitlines()
        in_fence = False
        for idx, line in enumerate(orig_lines):
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
            if not in_fence and line.startswith("# "):
                m = HEADING_RE.match(line)
                if m and m.group(3).upper() == target:
                    orig_lines[idx] = sec_lines[0]
                    break
        src_path.write_text("\n".join(orig_lines) + "\n", encoding="utf-8")
        sys.stdout.write(f"{prog_name()}: updated {target} -> [{final_status}] in {source_file}\n")
        return _finalize_mutation(base_dir, commit_msg, commit=commit, no_commit=no_commit)

    (base_dir / source_file).write_text(updated_source_text, encoding="utf-8")
    default_hdrs = {
        "TODO.md": _default_todo_header(base_dir),
        "TODO_ARCHIVE.md": _default_archive_header(base_dir),
    }
    _insert_task_section(
        base_dir / dest_file,
        sec_lines,
        default_hdrs[dest_file],
        prepend=(dest_file == "TODO_ARCHIVE.md" or (promote_top and dest_file == "TODO.md")),
    )
    if dest_file == source_file:
        sys.stdout.write(f"{prog_name()}: promoted {target} ([{final_status}]) to top of {dest_file}\n")
    else:
        sys.stdout.write(f"{prog_name()}: moved {target} ([{final_status}]) from {source_file} -> {dest_file}\n")
    return _finalize_mutation(
        base_dir,
        commit_msg,
        commit=commit,
        no_commit=no_commit,
        promote_id=(target if promote_top and dest_file == "TODO.md" else None),
    )


def _resolve_body_arg(body: str | None) -> str | None:
    if body == "-":
        if sys.stdin.isatty():
            raise SystemExit(f"{prog_name()}: -b - / --body - requires non-TTY stdin")
        return sys.stdin.read()
    if body is None:
        return _read_stdin_if_piped()
    return body


def _normalize_depends_refs(raw_items: list[str]) -> list[str]:
    refs: list[str] = []
    seen: set[str] = set()
    for item in raw_items:
        for part in item.split(","):
            tok = part.strip()
            if not tok:
                continue
            pm = PROJECT_TASK_RE.match(tok)
            if pm:
                proj_part = pm.group(1).strip().replace("\\", "/").strip("/")
                norm = f"{proj_part}:{pm.group(2).upper()}"
            elif re.fullmatch(r"[A-Za-z]\d+", tok):
                norm = tok.upper()
            else:
                raise SystemExit(f"{prog_name()}: invalid dependency reference {tok!r}; expected <ID> or <project>:<ID>")
            if norm not in seen:
                seen.add(norm)
                refs.append(norm)
    return refs


def _apply_depends_to_body_lines(lines: list[str], depends_refs: list[str] | None) -> list[str]:
    if depends_refs is None:
        return lines
    filtered: list[str] = []
    in_fence = False
    for line in lines:
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
        if not in_fence and DEPENDS_LINE_RE.match(line):
            continue
        filtered.append(line)
    while filtered and not filtered[0].strip():
        filtered.pop(0)
    while filtered and not filtered[-1].strip():
        filtered.pop()
    if not depends_refs:
        return filtered
    dep_line = f"- Depends on: {', '.join(depends_refs)}"
    return [dep_line, *filtered] if filtered else [dep_line]


def cmd_add(
    base_dir: Path,
    argv: list[str],
    commit: bool = False,
    no_commit: bool = False,
    explicit_dir: str | None = None,
) -> int:
    prog = prog_name()
    status = "NEW"
    prepend = False
    prefix: str | None = None
    note: str | None = None
    body: str | None = None
    depends_raw: list[str] = []
    pos: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--commit", "-c"):
            commit = True
            i += 1
        elif a == "--no-commit":
            no_commit = True
            i += 1
        elif a in ("--next", "-n", "--top"):
            status = "NEXT"
            prepend = True
            i += 1
        elif a in ("-p", "--prefix"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            prefix = argv[i + 1].strip().upper()
            if not re.fullmatch(r"[A-Z]", prefix):
                raise SystemExit(f"{prog}: invalid ID prefix {argv[i + 1]!r}; expected a single letter A-Z")
            i += 2
        elif a in ("--status", "-s"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            status = argv[i + 1].upper()
            if status in ("WIP", "NEXT"):
                prepend = True
            i += 2
        elif a in ("-m", "--note", "--reason"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            note = argv[i + 1]
            i += 2
        elif a in ("-b", "--body"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            body = argv[i + 1]
            i += 2
        elif a in ("--depends", "-d"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            depends_raw.append(argv[i + 1])
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option for add: {a}")
        else:
            pos.append(a)
            i += 1

    if status not in ("WIP", "NEXT", "NEW", "HOLD", "QUESTION"):
        raise SystemExit(f"{prog}: add status must be WIP, NEXT, NEW, HOLD, or QUESTION (got {status!r})")

    if len(pos) >= 2 and not re.fullmatch(r"[A-Za-z](?:\d+)?", pos[0].strip()):
        cand_proj = pos[0].strip().replace("\\", "/").strip("/")
        ws_root = resolve_workspace_root(base_dir, explicit_dir=explicit_dir)
        cand_dir = (ws_root / cand_proj).resolve()
        if cand_proj and ".." not in cand_proj.split("/") and is_todo_project(cand_dir):
            base_dir = cand_dir
            pos = pos[1:]

    if len(pos) == 1:
        tid = next_free_id(base_dir, prefix or "F")
        title = pos[0].strip()
    elif len(pos) == 2 and prefix is None:
        first, second = pos[0].strip(), pos[1].strip()
        if re.fullmatch(r"[A-Za-z]", first):
            tid = next_free_id(base_dir, first.upper())
            title = second
        elif re.fullmatch(r"[A-Za-z]\d+", first):
            tid = next_free_id(base_dir, first[0].upper())
            title = second
            if first.upper() != tid:
                sys.stderr.write(
                    f"{prog}: note: ignoring explicit ID {first.upper()}; auto-assigned {tid}\n"
                )
        else:
            raise SystemExit(f"{prog}: invalid ID prefix {first!r}; expected a single letter A-Z (e.g. F, B, P)")
    else:
        raise SystemExit(
            f"{prog}: usage: {prog} add [<PREFIX>] <TITLE> [-p PREFIX] [--next] [--status STATUS] [-m NOTE] [-b BODY]"
        )

    if not title:
        raise SystemExit(f"{prog}: task title cannot be empty")

    body = _resolve_body_arg(body)
    depends_refs = _normalize_depends_refs(depends_raw) if depends_raw else None
    body_lines = body.strip().splitlines() if body and body.strip() else []
    body_lines = _apply_depends_to_body_lines(body_lines, depends_refs)

    heading = _format_heading(status, tid, title, note=note)
    sec_lines = [heading]
    if body_lines:
        sec_lines.extend(["", *body_lines])

    _insert_task_section(base_dir / "TODO.md", sec_lines, _default_todo_header(base_dir), prepend=prepend)
    sys.stdout.write(f"{prog}: added {tid} ([{status}]) to TODO.md\n")
    base_title, _ = _strip_heading_note(title)
    return _finalize_mutation(
        base_dir,
        f"Add task {tid}: {base_title}",
        commit=commit,
        no_commit=no_commit,
        promote_id=(tid if prepend else None),
    )


def cmd_edit(
    base_dir: Path,
    argv: list[str],
    commit: bool = False,
    no_commit: bool = False,
    explicit_dir: str | None = None,
) -> int:
    prog = prog_name()
    new_title: str | None = None
    note: str | None = None
    clear_note = False
    body: str | None = None
    depends_raw: list[str] | None = None
    pos: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--commit", "-c"):
            commit = True
            i += 1
        elif a == "--no-commit":
            no_commit = True
            i += 1
        elif a in ("-t", "--title"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            new_title = argv[i + 1]
            i += 2
        elif a in ("-m", "--note", "--reason"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            note = argv[i + 1]
            if note == "":
                clear_note = True
            i += 2
        elif a in ("-b", "--body"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            body = argv[i + 1]
            i += 2
        elif a in ("--depends", "-d"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            if depends_raw is None:
                depends_raw = []
            depends_raw.append(argv[i + 1])
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option for edit: {a}")
        else:
            pos.append(a)
            i += 1

    if len(pos) != 1:
        raise SystemExit(f"{prog}: usage: {prog} edit <ID> [-t TITLE] [-m NOTE] [-b BODY] [--depends REF[,REF...]]")
    base_dir, resolved_id = resolve_project_task_ref(base_dir, pos[0], explicit_dir=explicit_dir)
    target = resolved_id.upper()
    body = _resolve_body_arg(body)
    depends_refs = _normalize_depends_refs(depends_raw) if depends_raw is not None else None

    if new_title is None and note is None and body is None and depends_refs is None:
        raise SystemExit(f"{prog}: edit requires at least one of -t TITLE, -m NOTE, -b BODY, --depends, or stdin")

    for fname in TASK_FILES:
        p = base_dir / fname
        if not p.is_file():
            continue
        lines = read_if_exists(p).splitlines()
        in_fence = False
        start_idx: int | None = None
        end_idx: int | None = None
        matched_groups: tuple[str, str, str, str] | None = None
        for idx, line in enumerate(lines):
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
            if not in_fence and line.startswith("# "):
                if start_idx is not None:
                    end_idx = idx
                    break
                m = HEADING_RE.match(line)
                if m and m.group(3).upper() == target:
                    start_idx = idx
                    matched_groups = (m.group(1), m.group(2), m.group(3), m.group(4))
        if start_idx is None or matched_groups is None:
            continue
        if end_idx is None:
            end_idx = len(lines)
        _, status, tid, old_full_title = matched_groups
        base_title, old_note = _strip_heading_note(old_full_title)
        final_title = new_title.strip() if new_title is not None else base_title
        final_note = None if clear_note else (note if note is not None else old_note)
        heading = _format_heading(status, tid, final_title, note=final_note)

        if body is not None:
            body_lines = _apply_depends_to_body_lines(body.strip().splitlines() if body.strip() else [], depends_refs)
            new_sec = [heading]
            if body_lines:
                new_sec.extend(["", *body_lines])
            new_sec.append("")
        else:
            old_sec = lines[start_idx:end_idx]
            if depends_refs is not None:
                body_lines = _apply_depends_to_body_lines(old_sec[1:], depends_refs)
                new_sec = [heading, *(["", *body_lines] if body_lines else []), ""]
            else:
                old_sec[0] = heading
                new_sec = old_sec

        updated_lines = lines[:start_idx] + new_sec + lines[end_idx:]
        new_text = re.sub(r"\n{3,}", "\n\n", "\n".join(updated_lines).rstrip()) + "\n"
        p.write_text(new_text, encoding="utf-8")
        sys.stdout.write(f"{prog}: updated task {tid} in {fname}\n")
        return _finalize_mutation(base_dir, f"Update task {tid}: {final_title}", commit=commit, no_commit=no_commit)

    sys.stderr.write(f"{prog}: task {target!r} not found in TODO*.md under {base_dir}\n")
    return 1


def cmd_append(base_dir: Path, argv: list[str], commit: bool = False, no_commit: bool = False) -> int:
    prog = prog_name()
    body: str | None = None
    pos: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--commit", "-c"):
            commit = True
            i += 1
        elif a == "--no-commit":
            no_commit = True
            i += 1
        elif a in ("-b", "--body", "-m", "--note"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            body = argv[i + 1]
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option for append: {a}")
        else:
            pos.append(a)
            i += 1

    if len(pos) != 1:
        raise SystemExit(f"{prog}: usage: {prog} append <ID> [-b TEXT]")
    target = pos[0].strip().upper()
    body = _resolve_body_arg(body)
    if not body or not body.strip():
        raise SystemExit(f"{prog}: append requires non-empty text via -b TEXT or stdin")

    for fname in TASK_FILES:
        p = base_dir / fname
        if not p.is_file():
            continue
        lines = read_if_exists(p).splitlines()
        in_fence = False
        start_idx: int | None = None
        end_idx: int | None = None
        matched_title = ""
        for idx, line in enumerate(lines):
            if line.lstrip().startswith(FENCE):
                in_fence = not in_fence
            if not in_fence and line.startswith("# "):
                if start_idx is not None:
                    end_idx = idx
                    break
                m = HEADING_RE.match(line)
                if m and m.group(3).upper() == target:
                    start_idx = idx
                    matched_title = m.group(4)
        if start_idx is None:
            continue
        if end_idx is None:
            end_idx = len(lines)
        sec_lines = lines[start_idx:end_idx]
        while sec_lines and not sec_lines[-1].strip():
            sec_lines.pop()
        sec_lines.extend(["", body.strip(), ""])
        updated_lines = lines[:start_idx] + sec_lines + lines[end_idx:]
        new_text = re.sub(r"\n{3,}", "\n\n", "\n".join(updated_lines).rstrip()) + "\n"
        p.write_text(new_text, encoding="utf-8")
        sys.stdout.write(f"{prog}: appended to {target} in {fname}\n")
        base_title, _ = _strip_heading_note(matched_title)
        return _finalize_mutation(base_dir, f"Append to task {target}: {base_title}", commit=commit, no_commit=no_commit)

    sys.stderr.write(f"{prog}: task {target!r} not found in TODO*.md under {base_dir}\n")
    return 1


def resolve_top_task_id(base_dir: Path) -> str | None:
    todo_path = base_dir / "TODO.md"
    if not todo_path.is_file():
        return None
    active_tasks = parse_tasks_in_text(read_if_exists(todo_path), "TODO.md")
    for wanted in ("WIP", "NEXT"):
        for t in active_tasks:
            if str(t["status"]) == wanted:
                return str(t["id"]).upper()
    return None


def cmd_next_id(base_dir: Path) -> int:
    tid = resolve_top_task_id(base_dir)
    if not tid:
        sys.stderr.write(f"{prog_name()}: no active WIP or NEXT task found in TODO.md under {base_dir}\n")
        return 1
    sys.stdout.write(f"{tid}\n")
    return 0


def extract_task_files(base_dir: Path, section_text: str) -> list[str]:
    repo_root = base_dir.resolve()
    found: list[str] = []
    seen: set[str] = set()
    in_fence = False
    for line in section_text.splitlines():
        if line.lstrip().startswith(FENCE):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        for raw in BACKTICK_TOKEN_RE.findall(line):
            cand = raw.strip()
            if not cand or any(ch.isspace() for ch in cand) or "://" in cand:
                continue
            if cand.startswith("-") or any(ch in cand for ch in "<>*?{}"):
                continue
            cand = re.sub(r"(?::\d+(?::\d+)?|#L\d+(?:-L\d+)?)$", "", cand)
            if not cand:
                continue
            p_cand = Path(cand)
            target = p_cand.resolve() if p_cand.is_absolute() else (repo_root / cand).resolve()
            try:
                rel_posix = target.relative_to(repo_root).as_posix()
            except ValueError:
                continue
            if rel_posix == "." or not target.is_file():
                continue
            if rel_posix not in seen:
                seen.add(rel_posix)
                found.append(rel_posix)
    return found


def cmd_files(base_dir: Path, task_id: str | None = None) -> int:
    target = task_id.strip().upper() if task_id else resolve_top_task_id(base_dir)
    if not target:
        sys.stderr.write(f"{prog_name()}: no active WIP or NEXT task found in TODO.md under {base_dir}\n")
        return 1
    for t in collect_all_tasks(base_dir):
        if str(t["id"]).upper() == target:
            for rel_path in extract_task_files(base_dir, str(t["section"])):
                sys.stdout.write(f"{rel_path}\n")
            return 0
    sys.stderr.write(f"{prog_name()}: task {target!r} not found in TODO*.md under {base_dir}\n")
    return 1


def parse_version_from_source(source: str) -> str | None:
    m = re.search(r'^VERSION\s*=\s*["\x27]([^"\x27]+)["\x27]', source, flags=re.MULTILINE)
    return m.group(1) if m else None


def version_tuple(v: str) -> tuple[int, ...]:
    return tuple(int(p) for p in re.split(r"[^0-9]+", v) if p)


def fetch_remote_script(url: str | None = None) -> str:
    target_url = url or os.environ.get("TODO_MD_UPDATE_URL") or DEFAULT_UPDATE_URL
    req = urllib.request.Request(target_url, headers={"User-Agent": f"todo_md/{VERSION}"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = resp.read().decode("utf-8")
    if REPO_MARKER not in data:
        raise ValueError(f"remote file at {target_url} is not a valid vitalio/todo_md script")
    return data


def cmd_check_update(url: str | None = None) -> int:
    prog = prog_name()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: failed to check for updates: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if version_tuple(remote_ver) > version_tuple(VERSION):
        sys.stdout.write(f"{prog}: update available: {VERSION} -> {remote_ver} (run '{prog} update')\n")
    else:
        sys.stdout.write(f"{prog} {VERSION} is up to date (remote: {remote_ver}).\n")
    return 0


def cmd_update(force: bool = False, url: str | None = None, target_path: Path | None = None) -> int:
    prog = prog_name()
    dest = target_path or Path(__file__).resolve()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: update failed: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if not force and version_tuple(remote_ver) <= version_tuple(VERSION):
        sys.stdout.write(f"{prog} {VERSION} is already up to date.\n")
        return 0
    try:
        tmp_fd, tmp_name = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
        try:
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
                f.write(remote_src)
            os.chmod(tmp_name, 0o755)
            os.replace(tmp_name, dest)
        except Exception:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
            raise
    except Exception as exc:
        sys.stderr.write(f"{prog}: could not write updated binary to {dest}: {exc}\n")
        return 1
    sys.stdout.write(f"{prog}: updated {VERSION} -> {remote_ver} ({dest})\n")
    return 0


KNOWN_SUBCOMMANDS = (
    "projects",
    "archive",
    "add",
    "edit",
    "append",
    "done",
    "cancel",
    "canceled",
    "status",
    "next",
    "top",
    "next-id",
    "last-id",
    "last",
    "files",
    "ids",
    "check",
    "init",
    "list",
    "show",
    "update",
    "check-update",
    "help",
    "version",
)


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    prog = prog_name()
    if "-h" in args or "--help" in args or (args and args[0] == "help"):
        sys.stdout.write(usage_text())
        return 0
    if "-V" in args or "--version" in args or (args and args[0] == "version"):
        sys.stdout.write(f"{prog} {VERSION}\n")
        return 0
    if args and args[0] in ("check-update", "--check-update"):
        return cmd_check_update()
    if args and args[0] in ("update", "--update", "--self-update"):
        force = "--force" in args[1:]
        return cmd_update(force=force)

    full = False
    if "--full" in args:
        full = True
        args = [a for a in args if a != "--full"]
    commit = False
    if "--commit" in args or "-c" in args:
        commit = True
        args = [a for a in args if a not in ("--commit", "-c")]
    no_commit = False
    if "--no-commit" in args:
        no_commit = True
        args = [a for a in args if a != "--no-commit"]
    workspace = False
    if "--workspace" in args or "-w" in args:
        workspace = True
        args = [a for a in args if a not in ("--workspace", "-w")]

    explicit_dir: str | None = None
    if args and args[0] not in KNOWN_SUBCOMMANDS and not args[0].startswith("-"):
        if Path(args[0]).is_dir():
            explicit_dir = args.pop(0)
        elif not re.fullmatch(r"[A-Za-z]\d+", args[0]) and not PROJECT_TASK_RE.match(args[0]):
            ws_probe = resolve_workspace_root(resolve_target_dir(None))
            cand = (ws_probe / args[0].replace("\\", "/").strip("/")).resolve()
            if is_todo_project(cand):
                explicit_dir = str(cand)
                args.pop(0)
    base_dir = resolve_target_dir(explicit_dir)
    if args and args[0] in ("projects", "--projects"):
        return cmd_projects(base_dir, explicit_dir=explicit_dir)
    if not args:
        if workspace:
            return cmd_workspace_summary(resolve_workspace_root(base_dir, explicit_dir=explicit_dir), full=full)
        if not is_todo_project(base_dir) and not (base_dir / "TODO.md").is_file():
            ws_root = resolve_workspace_root(base_dir, explicit_dir=explicit_dir)
            if discover_projects(ws_root):
                return cmd_workspace_summary(ws_root, full=full)
        return cmd_summary(base_dir, full=full)
    if args[0] in ("archive", "--archive", "-a"):
        pos, note = _parse_note_arg(args[1:])
        canceled = "--canceled" in pos or "--cancel" in pos
        pos = [p for p in pos if p not in ("--canceled", "--cancel", "--done")]
        if not pos:
            return cmd_archive_view(base_dir)
        tdir, tid = resolve_project_task_ref(base_dir, pos[0], explicit_dir=explicit_dir)
        return cmd_transition(tdir, tid, new_status=("CANCELED" if canceled else "DONE"), dest_file="TODO_ARCHIVE.md", note=note, commit=commit, no_commit=no_commit)
    if args[0] in ("add", "--add"):
        return cmd_add(base_dir, args[1:], commit=commit, no_commit=no_commit, explicit_dir=explicit_dir)
    if args[0] in ("edit", "--edit"):
        return cmd_edit(base_dir, args[1:], commit=commit, no_commit=no_commit, explicit_dir=explicit_dir)
    if args[0] in ("append", "--append"):
        if len(args) >= 2 and not args[1].startswith("-"):
            tdir, tid = resolve_project_task_ref(base_dir, args[1], explicit_dir=explicit_dir)
            return cmd_append(tdir, [tid, *args[2:]], commit=commit, no_commit=no_commit)
        return cmd_append(base_dir, args[1:], commit=commit, no_commit=no_commit)
    if args[0] in ("done", "--done"):
        pos, note = _parse_note_arg(args[1:])
        if len(pos) != 1:
            raise SystemExit(f"{prog}: usage: {prog} done <ID> [-m NOTE]")
        tdir, tid = resolve_project_task_ref(base_dir, pos[0], explicit_dir=explicit_dir)
        return cmd_transition(tdir, tid, new_status="DONE", dest_file="TODO_ARCHIVE.md", note=note, commit=commit, no_commit=no_commit)
    if args[0] in ("cancel", "canceled", "--cancel"):
        pos, note = _parse_note_arg(args[1:])
        if len(pos) != 1:
            raise SystemExit(f"{prog}: usage: {prog} cancel <ID> [-m REASON]")
        tdir, tid = resolve_project_task_ref(base_dir, pos[0], explicit_dir=explicit_dir)
        return cmd_transition(tdir, tid, new_status="CANCELED", dest_file="TODO_ARCHIVE.md", note=note, commit=commit, no_commit=no_commit)
    if args[0] in ("status", "--status"):
        pos, note = _parse_note_arg(args[1:])
        if len(pos) != 2:
            raise SystemExit(f"{prog}: usage: {prog} status <ID> <STATUS> [-m NOTE]")
        tdir, tid = resolve_project_task_ref(base_dir, pos[0], explicit_dir=explicit_dir)
        st_up = pos[1].upper()
        return cmd_transition(tdir, tid, new_status=st_up, dest_file=None, note=note, promote_top=(st_up in ("WIP", "NEXT")), commit=commit, no_commit=no_commit)
    if args[0] in ("next-id", "--next-id"):
        if len(args) != 1:
            raise SystemExit(f"{prog}: usage: {prog} next-id")
        return cmd_next_id(base_dir)
    if args[0] in ("last-id", "--last-id"):
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} last-id [<STATUS|archive>]")
        return cmd_last_id(base_dir, args[1] if len(args) == 2 else None)
    if args[0] in ("last", "--last"):
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} last [<STATUS|archive>]")
        return cmd_last(base_dir, args[1] if len(args) == 2 else None)
    if args[0] in ("files", "--files"):
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} files [<ID>]")
        if len(args) == 2:
            tdir, tid = resolve_project_task_ref(base_dir, args[1], explicit_dir=explicit_dir)
            return cmd_files(tdir, tid)
        return cmd_files(base_dir, None)
    if args[0] in ("next", "top", "--next", "--top"):
        pos, note = _parse_note_arg(args[1:])
        if args[0] == "--top" and not pos and note is None:
            return cmd_next_id(base_dir)
        if len(pos) != 1:
            raise SystemExit(f"{prog}: usage: {prog} next <ID> [-m NOTE]")
        tdir, tid = resolve_project_task_ref(base_dir, pos[0], explicit_dir=explicit_dir)
        return cmd_transition(tdir, tid, new_status="NEXT", dest_file="TODO.md", note=note, promote_top=True, commit=commit, no_commit=no_commit)
    if args[0] in ("ids", "--ids"):
        return cmd_ids(base_dir)
    if args[0] in ("check", "--check"):
        if workspace or (not is_todo_project(base_dir) and not (base_dir / "TODO.md").is_file()):
            ws_root = resolve_workspace_root(base_dir, explicit_dir=explicit_dir)
            if workspace or discover_projects(ws_root):
                return cmd_workspace_check(ws_root)
        return cmd_check(base_dir)
    if args[0] in ("init", "--init"):
        return cmd_init(base_dir, argv=args[1:], commit=commit, no_commit=no_commit)
    if args[0] in ("list", "--list", "-l"):
        filt: str | None = None
        limit: int | None = None
        i = 1
        while i < len(args):
            a = args[i]
            if a in ("--limit", "-n"):
                if i + 1 >= len(args):
                    raise SystemExit(f"{prog}: {a} requires an integer argument")
                raw_lim = args[i + 1]
                if not raw_lim.isdigit() or int(raw_lim) < 1:
                    raise SystemExit(f"{prog}: invalid limit {raw_lim!r}; expected a positive integer")
                limit = int(raw_lim)
                i += 2
            elif a.startswith("--limit="):
                raw_lim = a.split("=", 1)[1]
                if not raw_lim.isdigit() or int(raw_lim) < 1:
                    raise SystemExit(f"{prog}: invalid limit {raw_lim!r}; expected a positive integer")
                limit = int(raw_lim)
                i += 1
            elif a.startswith("-"):
                raise SystemExit(f"{prog}: unknown option for list: {a}")
            elif filt is None:
                filt = a
                i += 1
            else:
                raise SystemExit(f"{prog}: usage: {prog} list [filter] [--limit N] [--full]")
        if workspace or (not is_todo_project(base_dir) and not (base_dir / "TODO.md").is_file()):
            ws_root = resolve_workspace_root(base_dir, explicit_dir=explicit_dir)
            if workspace or discover_projects(ws_root):
                return cmd_workspace_list(ws_root, filt, limit=limit, full=full)
        return cmd_list(base_dir, filt, limit=limit, full=full)
    if args[0] in ("show", "--show"):
        if len(args) < 2 or len(args) > 3:
            raise SystemExit(f"{prog}: usage: {prog} show <ID|last> [<STATUS|archive>]")
        if args[1].lower() == "last":
            return cmd_last(base_dir, args[2] if len(args) == 3 else None)
        if len(args) != 2:
            raise SystemExit(f"{prog}: usage: {prog} show <ID>")
        tdir, tid = resolve_project_task_ref(base_dir, args[1], explicit_dir=explicit_dir)
        return cmd_show(tdir, tid)
    if len(args) == 1 and (re.fullmatch(r"[A-Za-z]\d+", args[0]) or PROJECT_TASK_RE.match(args[0])):
        tdir, tid = resolve_project_task_ref(base_dir, args[0], explicit_dir=explicit_dir)
        return cmd_show(tdir, tid)
    if len(args) == 1 and Path(args[0]).is_dir():
        return cmd_summary(resolve_target_dir(args[0]), full=full)
    raise SystemExit(f"{prog}: unknown arguments: {' '.join(args)} (see {prog} --help)")


if __name__ == "__main__":
    raise SystemExit(main())
