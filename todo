def prefix_legend_lines() -> list[str]:
    prefixes = ", ".join(
        f"{p}={name}" + (" (default)" if p == DEFAULT_TASK_PREFIX else "")
        for p, name in PREFIX_INFO.items()
    )
    return [
        f"Prefixes: {prefixes}, other A-Z=custom domain",
    ]
